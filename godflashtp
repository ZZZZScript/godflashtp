-- 3. UNLOCK BASE (ABRE BASE DE OUTROS JOGADORES)
-- =============================================
local unlockBaseUI = nil

local function findOtherPlayerBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    for _, plot in ipairs(plots:GetChildren()) do
        -- Verifica se NÃO é a sua base
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if not (yourBase and yourBase.Enabled) then
                return plot
            end
        end
    end
    return nil
end

local function findUnlockPromptInPlot(plot)
    if not plot then return nil end
    
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            -- Procura por prompts de unlock (geralmente são os que abrem a base)
            local actionText = obj.ActionText or ""
            if string.find(string.lower(actionText), "unlock") or string.find(string.lower(obj.Name or ""), "unlock") then
                return obj
            end
        end
    end
    return nil
end

local function unlockOtherBase()
    local otherBase = findOtherPlayerBase()
    if not otherBase then
        print("Nenhuma base de outro jogador encontrada")
        return false
    end
    
    local prompt = findUnlockPromptInPlot(otherBase)
    if not prompt then
        print("Prompt de unlock não encontrado")
        return false
    end
    
    -- Força o unlock
    local originalDist = prompt.MaxActivationDistance
    prompt.MaxActivationDistance = 9999
    
    pcall(function()
        fireproximityprompt(prompt, 9999)
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
    end)
    
    task.delay(0.3, function()
        prompt.MaxActivationDistance = originalDist
    end)
    
    return true
end

