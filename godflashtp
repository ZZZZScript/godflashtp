local function CreateLawButton()
    if LawButton then LawButton:Destroy() end
    
    local btn = Instance.new("TextButton")
    btn.Name = "LawButton"
    btn.Size = UDim2.new(0, 70, 0, 32)
    btn.Position = UDim2.new(1, -80, 0, 10)
    btn.BackgroundColor3 = Colors.BG
    btn.BackgroundTransparency = 0.2
    btn.Text = "LAW"
    btn.TextColor3 = Colors.Primary
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.BorderSizePixel = 0
    btn.Parent = LocalPlayer.PlayerGui
    MakeCorner(btn, 8)
    MakeStroke(btn, Colors.Primary, 2)
    
    btn.MouseButton1Click:Connect(function()
        MenuVisible = not MenuVisible
        if MainMenu then
            MainMenu.Visible = MenuVisible
        end
    end)
    
    LawButton = btn
end

