local function createToggleSwitch(parent, label, id, yPos, callback)
    local row = createInstance("Frame", {
        Size = UDim2.new(1, -20, 0, 50),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundColor3 = Colors.Secondary,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
    }, parent)
    addCorner(row, 8)
    
    -- Label
    local text = createInstance("TextLabel", {
        Size = UDim2.new(1, -70, 0, 22),
        Position = UDim2.new(0, 12, 0, 5),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    
    -- Description
    local descriptions = {
        instant_steal = "Auto teleport and steal",
        active_potion = "Auto activate potion when stealing",
        unlock_base = "Unlock other players' bases",
        actions_panel = "Rejoin, Kick, Reset & more",
    }
    
    local desc = createInstance("TextLabel", {
        Size = UDim2.new(1, -70, 0, 16),
        Position = UDim2.new(0, 12, 0, 28),
        BackgroundTransparency = 1,
        Text = descriptions[id] or "",
        Font = Enum.Font.Gotham,
        TextColor3 = Color3.fromRGB(150, 150, 150),
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    
    -- Switch background
    local switchBg = createInstance("Frame", {
        Size = UDim2.new(0, 44, 0, 24),
        Position = UDim2.new(1, -56, 0.5, -12),
        BackgroundColor3 = Colors.ToggleOff,
        BorderSizePixel = 0,
    }, row)
    addCorner(switchBg, 12)
    
    -- Switch knob
    local knob = createInstance("Frame", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0, 2, 0.5, -10),
        BackgroundColor3 = Colors.KnobOff,
        BorderSizePixel = 0,
    }, switchBg)
    addCorner(knob, 10)
    
    -- Set initial state
    if Toggles[id] then
        switchBg.BackgroundColor3 = Colors.ToggleOn
        knob.Position = UDim2.new(1, -22, 0.5, -10)
        knob.BackgroundColor3 = Colors.KnobOn
    end
    
    -- Click handler
    local clickBtn = createInstance("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
    }, switchBg)
    
    clickBtn.MouseButton1Click:Connect(function()
        Toggles[id] = not Toggles[id]
        
        -- Animate switch
        if Toggles[id] then
            tween(switchBg, {BackgroundColor3 = Colors.ToggleOn}, 0.15)
            tween(knob, {Position = UDim2.new(1, -22, 0.5, -10), BackgroundColor3 = Colors.KnobOn}, 0.15)
        else
            tween(switchBg, {BackgroundColor3 = Colors.ToggleOff}, 0.15)
            tween(knob, {Position = UDim2.new(0, 2, 0.5, -10), BackgroundColor3 = Colors.KnobOff}, 0.15)
        end
        
        if callback then
            callback(Toggles[id])
        end
    end)
    
    -- Hover effect
    row.MouseEnter:Connect(function()
        tween(row, {BackgroundTransparency = 0}, 0.12)
    end)
    row.MouseLeave:Connect(function()
        tween(row, {BackgroundTransparency = 0.4}, 0.12)
    end)
    
    return row
end

