local function Tween(obj, props, time)
    TS:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad), props):Play()
end

-- =============================================
-- INSTANT STEAL
-- =============================================
local function GetStealPrompt()
    local plots = workspace:FindFirstChild("Plots")
    if not plots or not Root then return nil end
    local closest = nil
    local dist = math.huge
    for _, plot in pairs(plots:GetChildren()) do
        for _, obj in pairs(plot:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.ActionText == "Steal" and obj.Enabled then
                local part = obj.Parent
                local pos = nil
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") and part.PrimaryPart then pos = part.PrimaryPart.Position end
                if pos then
                    local d = (Root.Position - pos).Magnitude
                    if d < dist then dist = d; closest = obj end
                end
            end
        end
    end
    return closest
end

local function FirePrompt(p)
    if not p then return end
    pcall(function()
        fireproximityprompt(p, 9999)
        p:InputHoldBegin()
        task.wait(0.05)
        p:InputHoldEnd()
    end)
end

local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return p
        end
    end
    return nil
end

local function TeleportTo(pos)
    if Root then Root.CFrame = CFrame.new(pos); Root.Velocity = Vector3.zero end
end

local function EquipCarpet()
    local char = Plr.Character
    local bp = Plr:FindFirstChild("Backpack")
    if not char or not bp then return end
    for _, t in pairs(char:GetChildren()) do if t:IsA("Tool") then t.Parent = bp end end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid:EquipTool(carpet)
    end
end

local function DoSteal()
    local plot = GetMyPlot()
    if not plot then return end
    EquipCarpet()
    task.wait(0.1)
    local order = plot:GetAttribute("Order")
    if order == 2 then
        TeleportTo(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        TeleportTo(Vector3.new(-352, -7, 76))
    elseif order == 1 then
        TeleportTo(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        TeleportTo(Vector3.new(-353, -7, 44))
    end
    FirePrompt(GetStealPrompt())
end

local function StartSteal()
    if StealLoop then return end
    StealLoop = RS.Heartbeat:Connect(function()
        if StealOn and Hum and Hum.Health > 0 then
            DoSteal()
            task.wait(1.5)
        end
    end)
end

local function StopSteal()
    if StealLoop then StealLoop:Disconnect(); StealLoop = nil end
end

-- =============================================
-- ACTIVE POTION
-- =============================================
local function UsePotion()
    local bp = Plr:FindFirstChild("Backpack")
    local char = Plr.Character
    if not bp or not char then return end
    local pot = bp:FindFirstChild("Giant Potion")
    if pot then
        pot.Parent = char
        pcall(function() pot:Activate() end)
    end
end

local function WatchPotion()
    if PotionWatch then PotionWatch:Disconnect() end
    local gui = Plr:WaitForChild("PlayerGui")
    local function Check(txt)
        if PotionOn and txt and string.find(string.lower(txt), "steal") then
            UsePotion()
        end
    end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") then
            Check(obj.Text)
            obj:GetPropertyChangedSignal("Text"):Connect(function() Check(obj.Text) end)
        end
    end
    PotionWatch = gui.DescendantAdded:Connect(function(d)
        if d:IsA("TextLabel") then
            Check(d.Text)
            d:GetPropertyChangedSignal("Text"):Connect(function() Check(d.Text) end)
        end
    end)
end

-- =============================================
-- UNLOCK BASE
-- =============================================
local UnlockFrame = nil

local function GetOtherPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign then
            local yb = sign:FindFirstChild("YourBase")
            if not (yb and yb.Enabled) then
                return p
            end
        end
    end
    return nil
end

local function DoUnlock()
    local plot = GetOtherPlot()
    if not plot then return end
    for _, obj in pairs(plot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = (obj.ActionText or ""):lower()
            if txt:find("unlock") then
                local od = obj.MaxActivationDistance
                obj.MaxActivationDistance = 9999
                pcall(function() fireproximityprompt(obj) end)
                task.delay(0.3, function() obj.MaxActivationDistance = od end)
                break
            end
        end
    end
end

