-- // [18] (Toggle Builder) //
local function makeToggle(parent, text, yPos, callback)
	local row = Instance.new("Frame", parent)
	row.Position = UDim2.fromOffset(14, yPos)
	row.Size = UDim2.fromOffset(182, 26)
	row.BackgroundTransparency = 1

	local label = Instance.new("TextLabel", row)
	label.Position = UDim2.fromOffset(0, 7)
	label.Size = UDim2.fromOffset(120, 12)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.Gotham
	label.TextSize = 10
	label.TextColor3 = COL_WHITE
	label.TextXAlignment = Enum.TextXAlignment.Left

	local track = Instance.new("Frame", row)
	track.Position = UDim2.fromOffset(128, 3)
	track.Size = UDim2.fromOffset(40, 20)
	track.BackgroundColor3 = COL_TOGGLE_BG
	track.BorderSizePixel = 0
	Instance.new("UICorner", track).CornerRadius = UDim.new(0, 10)

	local trackGrad = Instance.new("UIGradient", track)
	trackGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, COL_GOLD),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 30, 0)),
	})
	trackGrad.Enabled = false

	local trackStroke = Instance.new("UIStroke", track)
	trackStroke.Color = COL_GREY
	trackStroke.Transparency = 0
	trackStroke.Thickness = 1

	local dot = Instance.new("Frame", track)
	dot.Position = UDim2.fromOffset(2, 2)
	dot.Size = UDim2.fromOffset(16, 16)
	dot.BackgroundColor3 = COL_WHITE
	dot.BorderSizePixel = 0
	Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 8)

	local btn = Instance.new("TextButton", track)
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.ZIndex = 5

	local isOn = false

	btn.MouseButton1Click:Connect(function()
		isOn = not isOn
		trackGrad.Enabled = isOn
		TweenService:Create(dot, TweenInfo.new(0.2), {
			Position = isOn and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
		}):Play()
		TweenService:Create(trackStroke, TweenInfo.new(0.2), {
			Color = isOn and COL_GOLD or COL_GREY
		}):Play()
		callback(isOn)
	end)

	return function(on)
		isOn = on
		trackGrad.Enabled = isOn
		dot.Position = isOn and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
		trackStroke.Color = isOn and COL_GOLD or COL_GREY
		callback(isOn)
	end
end

