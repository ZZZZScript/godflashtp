local function GetAdminPanel()
    local ap = LP.PlayerGui:FindFirstChild("AdminPanel")
    if not ap then return nil, nil end
    local pnl = ap:FindFirstChild("AdminPanel")
    if not pnl then return nil, nil end
    local cont = pnl:FindFirstChild("Content")
    local prof = pnl:FindFirstChild("Profiles")
    if not cont or not prof then return nil, nil end
    return cont:FindFirstChild("ScrollingFrame"), prof:FindFirstChild("ScrollingFrame")
end

local function FireCmd(btn)
    local ok, conns = pcall(getconnections, btn.Activated)
    if ok and type(conns) == "table" then
        for _, c in ipairs(conns) do if type(c.Function) == "function" then task.spawn(c.Function) end end
    end
end

local function RunCmd(cmd, target)
    local cmdFrame, profFrame = GetAdminPanel()
    if not cmdFrame or not profFrame then return end
    local profBtn = profFrame:FindFirstChild(target.Name)
    local cmdBtn = cmdFrame:FindFirstChild(cmd)
    if not profBtn or not cmdBtn then return end
    FireCmd(profBtn)
    task.wait(0.05)
    FireCmd(cmdBtn)
    task.wait(0.05)
    FireCmd(profBtn)
    task.wait(0.05)
    FireCmd(cmdBtn)
end

local function RagdollOther()
    for _, p in pairs(Players:GetPlayers()) do if p ~= LP then RunCmd("ragdoll", p); break end end
end

local function Rejoin() TP:Teleport(game.PlaceId, LP) end
local function KickSelf() LP:Kick("Law Hub") end
local function ResetChar() if LP.Character then LP.Character:Destroy() end end

