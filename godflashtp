    local cont = Instance.new("Frame")
    cont.Size = UDim2.new(1, 0, 0, 280)
    cont.BackgroundTransparency = 1
    cont.Parent = scroll
    
    local y = 5
    local switchData = {
        {"INSTANT STEAL V2", "Auto teleport + steal"},
        {"ACTIVE POTION", "Potion Teleport Helper"},
        {"UNLOCK BASE", "Unlock other player's base"},
        {"ACTIONS PANEL", "Rejoin, Kick, Balloon, Ragdoll"},
    }
    
    local switchStates = {false, false, false, false}
    local switchIds = {"instant", "active", "unlock", "actions"}
    
    for idx, sd in ipairs(switchData) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -20, 0, 52)
        row.Position = UDim2.new(0, 10, 0, y)
        row.BackgroundColor3 = Dark
        row.BackgroundTransparency = 0.3
        row.Parent = cont
        Corner(row, 8)
        
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -70, 0, 22)
        lbl.Position = UDim2.new(0, 12, 0, 4)
        lbl.BackgroundTransparency = 1
        lbl.Text = sd[1]
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(255,255,255)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row
        
        local dsc = Instance.new("TextLabel")
        dsc.Size = UDim2.new(1, -70, 0, 18)
        dsc.Position = UDim2.new(0, 12, 0, 26)
        dsc.BackgroundTransparency = 1
        dsc.Text = sd[2]
        dsc.Font = Enum.Font.Gotham
        dsc.TextSize = 10
        dsc.TextColor3 = Color3.fromRGB(150,150,150)
        dsc.TextXAlignment = Enum.TextXAlignment.Left
        dsc.Parent = row
        
        local swBg = Instance.new("Frame")
        swBg.Size = UDim2.new(0, 44, 0, 24)
        swBg.Position = UDim2.new(1, -56, 0.5, -12)
        swBg.BackgroundColor3 = Color3.fromRGB(50,50,50)
        swBg.BorderSizePixel = 0
        swBg.Parent = row
        Corner(swBg, 12)
        
        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 20, 0, 20)
        knob.Position = UDim2.new(0, 2, 0.5, -10)
        knob.BackgroundColor3 = Color3.fromRGB(150,150,150)
        knob.BorderSizePixel = 0
        knob.Parent = swBg
        Corner(knob, 10)
        
        local click = Instance.new("TextButton")
        click.Size = UDim2.new(1, 0, 1, 0)
        click.BackgroundTransparency = 1
        click.Text = ""
        click.Parent = swBg
        
        local id = switchIds[idx]
        local state = false
        
        click.MouseButton1Click:Connect(function()
            state = not state
            if state then
                swBg.BackgroundColor3 = Yellow
                knob.Position = UDim2.new(1, -22, 0.5, -10)
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
            else
                swBg.BackgroundColor3 = Color3.fromRGB(50,50,50)
                knob.Position = UDim2.new(0, 2, 0.5, -10)
                knob.BackgroundColor3 = Color3.fromRGB(150,150,150)
            end
            
            if id == "instant" then
                InstantStealOn = state
                if state then
                    CreateStealPanel()
                    StartSteal()
                    if StealSpeedOn then StartSpeed() end
                else
                    if StealPanel then StealPanel:Destroy(); StealPanel = nil end
                    StopSteal()
                    StopSpeed()
                end
            elseif id == "unlock" then
                UnlockBaseOn = state
                if state then CreateUnlockUI() else if UnlockPanel then UnlockPanel:Destroy(); UnlockPanel = nil end end
            elseif id == "actions" then
                ActionsOn = state
                if state then CreateActionsUI() else if ActionsPanel then ActionsPanel:Destroy(); ActionsPanel = nil end end
            end
        end)
        
        row.MouseEnter:Connect(function()
            row.BackgroundTransparency = 0
        end)
        row.MouseLeave:Connect(function()
            row.BackgroundTransparency = 0.3
        end)
        
        y = y + 60
    end
    
    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, 0, 0, 22)
    footer.Position = UDim2.new(0, 0, 1, -24)
    footer.BackgroundTransparency = 1
