local activePotionEnabled = false

local function useGiantPotion()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not backpack or not char then return end
    
    local potion = backpack:FindFirstChild("Giant Potion")
    if potion then
        potion.Parent = char
        pcall(function() potion:Activate() end)
    end
end

-- Watch for steal messages to activate potion
local function setupPotionWatcher()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    local function checkForSteal(text)
        if not activePotionEnabled then return end
        if type(text) == "string" and string.find(string.lower(text), "steal") then
            useGiantPotion()
        end
    end
    
    -- Check existing GUI elements
    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            checkForSteal(obj.Text)
            obj:GetPropertyChangedSignal("Text"):Connect(function()
                checkForSteal(obj.Text)
            end)
        end
    end
    
    -- Watch for new GUI elements
    playerGui.DescendantAdded:Connect(function(desc)
        if activePotionEnabled and (desc:IsA("TextLabel") or desc:IsA("TextButton")) then
            checkForSteal(desc.Text)
            desc:GetPropertyChangedSignal("Text"):Connect(function()
                checkForSteal(desc.Text)
            end)
        end
    end)
end

