-- =============================================
-- UI UTILS
-- =============================================
local function MakeCorner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
end

local function MakeStroke(obj, color, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or Yellow
    s.Thickness = thick or 1.5
    s.Parent = obj
end

-- =============================================
-- CHARACTER SETUP
-- =============================================
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    PlayerRoot = char:FindFirstChild("HumanoidRootPart")
    PlayerHumanoid = char:FindFirstChildOfClass("Humanoid")
end)

local function WaitChar()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    PlayerRoot = char:FindFirstChild("HumanoidRootPart")
    PlayerHumanoid = char:FindFirstChildOfClass("Humanoid")
end
WaitChar()

-- =============================================
-- ADMIN PANEL
-- =============================================
local function GetAdminPanel()
    local ap = LocalPlayer.PlayerGui:FindFirstChild("AdminPanel")
    if not ap then return nil, nil end
    local pnl = ap:FindFirstChild("AdminPanel")
    if not pnl then return nil, nil end
    local cont = pnl:FindFirstChild("Content")
    local prof = pnl:FindFirstChild("Profiles")
    if not cont or not prof then return nil, nil end
    return cont:FindFirstChild("ScrollingFrame"), prof:FindFirstChild("ScrollingFrame")
end

local function ClickButton(btn)
    local ok, conns = pcall(getconnections, btn.Activated)
    if ok and type(conns) == "table" then
        for _, c in ipairs(conns) do
            if type(c.Function) == "function" then
                task.spawn(c.Function)
            end
        end
    end
end

local function RunCommand(cmd, target)
    local cmdFrame, profFrame = GetAdminPanel()
    if not cmdFrame or not profFrame then return false end
    local profBtn = profFrame:FindFirstChild(target.Name)
    local cmdBtn = cmdFrame:FindFirstChild(cmd)
    if not profBtn or not cmdBtn then return false end
    ClickButton(profBtn)
    task.wait(0.05)
    ClickButton(cmdBtn)
    task.wait(0.05)
    ClickButton(profBtn)
    task.wait(0.05)
    ClickButton(cmdBtn)
    return true
end

-- =============================================
-- TELEPORT E STEAL
-- =============================================
local function GetMyBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return p
        end
    end
    return nil
end

local function TeleportTo(pos)
    if PlayerRoot then
        PlayerRoot.CFrame = CFrame.new(pos)
        PlayerRoot.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and PlayerHumanoid then
        PlayerHumanoid:EquipTool(carpet)
    end
end

local function UsePotion()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return end
    local potion = bp:FindFirstChild("Giant Potion")
    if potion then
        potion.Parent = char
        pcall(function() potion:Activate() end)
    end
end

local function ResetChar()
    if LocalPlayer.Character then
        LocalPlayer.Character:Destroy()
    end
end

-- SPEED DURANTE O TP
local function ApplySpeedDuringTP()
    if SpeedEnabled and PlayerHumanoid then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dir = PlayerHumanoid.MoveDirection
        if hrp and dir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X * CurrentSpeed, hrp.AssemblyLinearVelocity.Y, dir.Z * CurrentSpeed)
        end
    end
end

-- FUNÇÃO PRINCIPAL DO TELEPORT
local function DoTeleportAndSteal()
    if IsTeleporting then return end
    IsTeleporting = true
    
    -- ATIVA POTION SE TIVER LIGADO (SOMENTE NA HORA DO TP)
    if PotionEnabled then
        UsePotion()
    end
    
    local myBase = GetMyBase()
    if not myBase then
        IsTeleporting = false
        return
    end
    
    EquipCarpet()
    task.wait(0.1)
    
    local order = myBase:GetAttribute("Order")
    if order == 2 then
        TeleportTo(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        TeleportTo(Vector3.new(-352, -7, 76))
    else
        TeleportTo(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        TeleportTo(Vector3.new(-353, -7, 44))
    end
    
    -- ATIVA SPEED DURANTE O ROUBO (SOMENTE SE TIVER LIGADO)
    if SpeedEnabled then
        for i = 1, 3 do
            ApplySpeedDuringTP()
            task.wait(0.1)
        end
    end
    
    task.wait(0.2)
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            RunCommand("steal", plr)
            break
        end
    end
    
    task.wait(0.5)
    IsTeleporting = false
end

-- LOOP DE STEAL
local function StartStealLoop()
    if StealLoop then StealLoop:Disconnect() end
    StealLoop = RunService.Heartbeat:Connect(function()
        if StealActive and PlayerHumanoid and PlayerHumanoid.Health > 0 then
            DoTeleportAndSteal()
            task.wait(1.5)
        end
    end)
end

local function StopStealLoop()
    if StealLoop then
        StealLoop:Disconnect()
        StealLoop = nil
    end
end

-- =============================================
-- UNLOCK BASE
-- =============================================
local function FindOtherBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign then
            local yb = sign:FindFirstChild("YourBase")
            if not (yb and yb.Enabled) then
                return p
            end
        end
    end
    return nil
end

local function UnlockOtherBase()
    local base = FindOtherBase()
    if not base then return end
    for _, obj in pairs(base:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = (obj.ActionText or ""):lower()
            if txt:find("unlock") then
                local oldDist = obj.MaxActivationDistance
                obj.MaxActivationDistance = 9999
                pcall(function()
                    fireproximityprompt(obj, 9999)
                    obj:InputHoldBegin()
                    task.wait(0.1)
                    obj:InputHoldEnd()
                end)
                task.delay(0.3, function() obj.MaxActivationDistance = oldDist end)
                break
            end
        end
    end
end

