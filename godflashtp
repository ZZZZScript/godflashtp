-- =============================================
-- UTILIDADES
-- =============================================
local function Tween(obj, prop, val, time)
    TS:Create(obj, TweenInfo.new(time or 0.2), {[prop] = val}):Play()
end

local function Corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
end

local function Stroke(obj, color, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or Yellow
    s.Thickness = thick or 1.5
    s.Parent = obj
end

-- =============================================
-- 1. INSTANT STEAL
-- =============================================
local function FindPrompt()
    local plots = workspace:FindFirstChild("Plots")
    if not plots or not Root then return nil end
    local closest = nil
    local minD = math.huge
    for _, p in pairs(plots:GetChildren()) do
        for _, o in pairs(p:GetDescendants()) do
            if o:IsA("ProximityPrompt") and o.ActionText == "Steal" and o.Enabled then
                local part = o.Parent
                local pos = nil
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") and part.PrimaryPart then pos = part.PrimaryPart.Position end
                if pos then
                    local d = (Root.Position - pos).Magnitude
                    if d < minD then minD = d; closest = o end
                end
            end
        end
    end
    return closest
end

local function Fire(p)
    if not p then return end
    pcall(function()
        fireproximityprompt(p, 9999)
        p:InputHoldBegin()
        task.wait(0.05)
        p:InputHoldEnd()
    end)
end

local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return p
        end
    end
    return nil
end

local function Tp(pos)
    if Root then Root.CFrame = CFrame.new(pos); Root.Velocity = Vector3.zero end
end

local function EquipCarpet()
    local char = LP.Character
    local bp = LP:FindFirstChild("Backpack")
    if not char or not bp then return end
    for _, t in pairs(char:GetChildren()) do if t:IsA("Tool") then t.Parent = bp end end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and Hum then Hum:EquipTool(carpet) end
end

local function DoSteal()
    local plot = GetMyPlot()
    if not plot then return end
    EquipCarpet()
    task.wait(0.1)
    local order = plot:GetAttribute("Order")
    if order == 2 then
        Tp(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        Tp(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        Tp(Vector3.new(-352, -7, 76))
    elseif order == 1 then
        Tp(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        Tp(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        Tp(Vector3.new(-353, -7, 44))
    end
    Fire(FindPrompt())
end

local function StartSteal()
    if StealThread then StealThread:Disconnect() end
    StealThread = RS.Heartbeat:Connect(function()
        if StealOn and Hum and Hum.Health > 0 then DoSteal(); task.wait(1.5) end
    end)
end

local function StopSteal()
    if StealThread then StealThread:Disconnect(); StealThread = nil end
end

-- =============================================
-- 2. ACTIVE POTION
-- =============================================
local function UsePotion()
    local bp = LP:FindFirstChild("Backpack")
    local char = LP.Character
    if not bp or not char then return end
    local pot = bp:FindFirstChild("Giant Potion")
    if pot then pot.Parent = char; pcall(function() pot:Activate() end) end
end

local function WatchPotion()
    if PotionWatch then PotionWatch:Disconnect() end
    local gui = LP:WaitForChild("PlayerGui")
    local function Check(txt)
        if PotionOn and txt and string.find(string.lower(txt), "steal") then UsePotion() end
    end
    for _, o in pairs(gui:GetDescendants()) do
        if o:IsA("TextLabel") then
            Check(o.Text)
            o:GetPropertyChangedSignal("Text"):Connect(function() Check(o.Text) end)
        end
    end
    PotionWatch = gui.DescendantAdded:Connect(function(d)
        if d:IsA("TextLabel") then Check(d.Text); d:GetPropertyChangedSignal("Text"):Connect(function() Check(d.Text) end) end
    end)
end

local function StopWatch()
    if PotionWatch then PotionWatch:Disconnect(); PotionWatch = nil end
end

-- =============================================
-- 3. UNLOCK BASE
-- =============================================
local function FindOtherPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign then
            local yb = sign:FindFirstChild("YourBase")
            if not (yb and yb.Enabled) then return p end
        end
    end
    return nil
end

local function Unlock()
    local plot = FindOtherPlot()
    if not plot then return end
    for _, o in pairs(plot:GetDescendants()) do
        if o:IsA("ProximityPrompt") and o.Enabled then
            local txt = (o.ActionText or ""):lower()
            if txt:find("unlock") then
                local old = o.MaxActivationDistance
                o.MaxActivationDistance = 9999
                pcall(function() fireproximityprompt(o) end)
                task.delay(0.3, function() o.MaxActivationDistance = old end)
                break
            end
        end
    end
end

