-- =============================================
-- TELEPORT FUNCTIONS (COM 1 SEGUNDO NA BASE)
-- =============================================
local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return plot
        end
    end
    return nil
end

local function TeleportTo(pos)
    if RootPart then
        RootPart.CFrame = CFrame.new(pos)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and Humanoid then
        Humanoid:EquipTool(carpet)
    end
end

-- FUNÇÃO PRINCIPAL DE TELEPORT (ENTRA, FICA 1s, SAI)
local function DoTeleportAndSteal()
    if teleporting then return end
    teleporting = true
    
    -- USA POÇÃO SE POTION STEAL ESTIVER LIGADO
    if PotionStealEnabled then
        UseGiantPotion()
    end
    
    local myPlot = GetMyPlot()
    if not myPlot then
        teleporting = false
        return
    end
    
    EquipCarpet()
    task.wait(0.1)
    
    local order = myPlot:GetAttribute("Order")
    local insidePos = nil
    
    -- Define a posição dentro da base baseada no andar
    if order == 2 then
        insidePos = Vector3.new(-352, -7, 76)
        TeleportTo(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        TeleportTo(insidePos)
    elseif order == 1 then
        insidePos = Vector3.new(-353, -7, 44)
        TeleportTo(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        TeleportTo(insidePos)
    else
        insidePos = Vector3.new(-353, -7, 44)
        TeleportTo(insidePos)
    end
    
    -- FICA 1 SEGUNDO DENTRO DA BASE
    task.wait(1.0)
    
    -- TENTA ROUBAR ENQUANTO ESTÁ DENTRO
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            RunCommandOnPlayer("steal", plr)
            break
        end
    end
    
    task.wait(0.2)
    
    -- SAI DA BASE (teleporta para fora)
    TeleportTo(EXIT_POSITION)
    
    task.wait(0.3)
    teleporting = false
end

-- =============================================
-- UNLOCK BASE
-- =============================================
local function FindOtherBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if not (yourBase and yourBase.Enabled) then
                return plot
            end
        end
    end
    return nil
end

local function UnlockFloor()
    local plot = FindOtherBase()
    if not plot then return end
    for _, obj in pairs(plot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = (obj.ActionText or ""):lower()
            if txt:find("unlock") then
                local oldDist = obj.MaxActivationDistance
                obj.MaxActivationDistance = 9999
                pcall(function() 
                    fireproximityprompt(obj, 9999)
                    obj:InputHoldBegin()
                    task.wait(0.1)
                    obj:InputHoldEnd()
                end)
                task.delay(0.3, function() obj.MaxActivationDistance = oldDist end)
                break
            end
        end
    end
end

