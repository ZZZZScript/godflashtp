local function UseGiantPotion()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return end
    local potion = bp:FindFirstChild("Giant Potion")
    if potion then
        potion.Parent = char
        pcall(function() potion:Activate() end)
    end
end

-- =============================================
-- ACTIVE POTION (USA POÇÃO QUANDO PEGA BRAINROT)
-- =============================================
local function CheckForSteal(text)
    if not Toggles.active_potion then return end
    if type(text) ~= "string" then return end
    
    local lowerText = string.lower(text)
    for _, keyword in ipairs(StealKeywords) do
        if string.find(lowerText, keyword) then
            UseGiantPotion()
            break
        end
    end
end

local function StartActivePotionWatcher()
    if ActivePotionConnection then ActivePotionConnection:Disconnect() end
    
    local gui = LocalPlayer:WaitForChild("PlayerGui")
    
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            CheckForSteal(obj.Text)
            obj:GetPropertyChangedSignal("Text"):Connect(function()
                CheckForSteal(obj.Text)
            end)
        end
    end
    
    ActivePotionConnection = gui.DescendantAdded:Connect(function(d)
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            CheckForSteal(d.Text)
            d:GetPropertyChangedSignal("Text"):Connect(function()
                CheckForSteal(d.Text)
            end)
        end
    end)
end

local function StopActivePotionWatcher()
    if ActivePotionConnection then
        ActivePotionConnection:Disconnect()
        ActivePotionConnection = nil
    end
end

