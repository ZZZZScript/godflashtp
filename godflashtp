-- [[(/ Speed Boost Logic /)]]
RunService.RenderStepped:Connect(function()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then
        if speedEnabled then
            hum.WalkSpeed = speedAmount
        else
            if hum.WalkSpeed == speedAmount then
                hum.WalkSpeed = 16
            end
        end
    end
end)

