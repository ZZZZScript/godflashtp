-- PROCURAR ITEM
local function findTool(namePart)
    for _, item in ipairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name:lower():find(namePart:lower()) then return item end
    end
    if player.Character then
        for _, item in ipairs(player.Character:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find(namePart:lower()) then return item end
        end
    end
    return nil
end

-- ATIVAR GIANT POTION
local function ActivateGiantPotion()
    local char = player.Character
    if not char then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    -- Procura a Giant Potion no inventário
    local potion = findTool("giant") or findTool("potion") or findTool("Giant Potion")
    
    if potion then
        hum:EquipTool(potion)
        task.wait(0.1)
        pcall(function()
            potion:Activate()
        end)
        print("✅ Giant Potion ativada!")
        return true
    else
        print("❌ Giant Potion não encontrada!")
        return false
    end
end

-- TELEPORTE COM FLYING CARPET
local function TeleportTo(pos)
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    -- EQUIPA FLYING CARPET
    local carpet = findTool("carpet") or findTool("flying")
    if carpet then
        hum:EquipTool(carpet)
        task.wait(0.05)
    end
    
    -- SE GIANT POTION ESTIVER ATIVADA, USA ANTES DO TELEPORTE
    if giantPotionEnabled then
        ActivateGiantPotion()
        task.wait(0.1)
    end
    
    -- TELEPORTA
    hrp.CFrame = CFrame.new(pos)
    task.wait(0.05)
    hrp.Position = pos
    hrp.CFrame = CFrame.new(pos)
end

-- AUTO GRAB
local function GrabNearest()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    for _, plot in ipairs(workspace.Plots:GetChildren()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, podium in ipairs(podiums:GetChildren()) do
                local base = podium:FindFirstChild("Base")
                if base then
                    local spawn = base:FindFirstChild("Spawn")
                    if spawn then
                        local prompt = spawn:FindFirstChildOfClass("ProximityPrompt")
                        if prompt then
                            fireproximityprompt(prompt)
                            return
                        end
                    end
                end
            end
        end
    end
end

-- EXECUTAR
local function Execute()
    print("===== INICIANDO =====")
    print("Giant Potion: " .. (giantPotionEnabled and "ATIVADA" or "DESATIVADA"))
    
    for _, pos in ipairs(positions) do
        TeleportTo(pos)
        task.wait(0.1)
    end
    
    for i = 1, 10 do
        GrabNearest()
        task.wait(0.1)
    end
    
    print("===== FINALIZADO =====")
end

