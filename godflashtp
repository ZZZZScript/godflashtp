-- =============================================
local MainMenu = nil
local LawButton = nil
local MenuVisible = true

local function CreateMainMenu()
    if MainMenu then MainMenu:Destroy() end
    
    local sg = Instance.new("ScreenGui")
    sg.Name = "LawHub"
    sg.ResetOnSpawn = false
    sg.Parent = LocalPlayer.PlayerGui
    
    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, 280, 0, 380)
    main.Position = UDim2.new(0.5, -140, 0.35, 0)
    main.BackgroundColor3 = Black
    main.BackgroundTransparency = 0.05
    main.BorderSizePixel = 0
    main.Active = true
    main.Parent = sg
    MakeCorner(main, 12)
    MakeStroke(main, Yellow, 2)
    
    -- BARRA DE TÍTULO (DRAG AQUI)
    local titleBar = Instance.new("Frame", main)
    titleBar.Size = UDim2.new(1, 0, 0, 45)
    titleBar.BackgroundColor3 = Dark
    titleBar.BackgroundTransparency = 0.3
    MakeCorner(titleBar, 12)
    
    local title = Instance.new("TextLabel", titleBar)
    title.Size = UDim2.new(1, 0, 1, 0)
    title.BackgroundTransparency = 1
    title.Text = "LAW HUB"
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 22
    title.TextColor3 = Yellow
    
    local line = Instance.new("Frame", main)
    line.Size = UDim2.new(0.9, 0, 0, 2)
    line.Position = UDim2.new(0.05, 0, 0, 48)
    line.BackgroundColor3 = Yellow
    
    local scroll = Instance.new("ScrollingFrame", main)
    scroll.Size = UDim2.new(1, 0, 1, -75)
    scroll.Position = UDim2.new(0, 0, 0, 55)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Yellow
    scroll.CanvasSize = UDim2.new(0, 0, 0, 280)
    
    local container = Instance.new("Frame", scroll)
    container.Size = UDim2.new(1, 0, 0, 280)
    container.BackgroundTransparency = 1
    
    local y = 5
    local items = {
        {"INSTANT STEAL V2", "Auto teleport + steal", "steal"},
        {"ACTIVE POTION", "Reset character", "potion"},
        {"UNLOCK BASE", "Unlock other player's base", "unlock"},
        {"ACTIONS PANEL", "Rejoin, Kick, Balloon, Ragdoll", "actions"},
    }
    
    local states = {false, false, false, false}
    
    for idx, item in ipairs(items) do
        local row = Instance.new("Frame", container)
        row.Size = UDim2.new(1, -20, 0, 52)
        row.Position = UDim2.new(0, 10, 0, y)
        row.BackgroundColor3 = Dark
        row.BackgroundTransparency = 0.3
        MakeCorner(row, 8)
        
        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -70, 0, 22)
        lbl.Position = UDim2.new(0, 12, 0, 4)
        lbl.BackgroundTransparency = 1
        lbl.Text = item[1]
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(255,255,255)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local dsc = Instance.new("TextLabel", row)
        dsc.Size = UDim2.new(1, -70, 0, 18)
        dsc.Position = UDim2.new(0, 12, 0, 26)
        dsc.BackgroundTransparency = 1
        dsc.Text = item[2]
        dsc.Font = Enum.Font.Gotham
        dsc.TextSize = 10
        dsc.TextColor3 = Color3.fromRGB(150,150,150)
        dsc.TextXAlignment = Enum.TextXAlignment.Left
        
        local swBg = Instance.new("Frame", row)
        swBg.Size = UDim2.new(0, 44, 0, 24)
        swBg.Position = UDim2.new(1, -56, 0.5, -12)
        swBg.BackgroundColor3 = Color3.fromRGB(50,50,50)
        MakeCorner(swBg, 12)
        
        local knob = Instance.new("Frame", swBg)
        knob.Size = UDim2.new(0, 20, 0, 20)
        knob.Position = UDim2.new(0, 2, 0.5, -10)
        knob.BackgroundColor3 = Color3.fromRGB(150,150,150)
        MakeCorner(knob, 10)
        
        local click = Instance.new("TextButton", swBg)
        click.Size = UDim2.new(1, 0, 1, 0)
        click.BackgroundTransparency = 1
        click.Text = ""
        
        local id = item[3]
        
        click.MouseButton1Click:Connect(function()
            states[idx] = not states[idx]
            if states[idx] then
                swBg.BackgroundColor3 = Yellow
                knob.Position = UDim2.new(1, -22, 0.5, -10)
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
            else
                swBg.BackgroundColor3 = Color3.fromRGB(50,50,50)
                knob.Position = UDim2.new(0, 2, 0.5, -10)
                knob.BackgroundColor3 = Color3.fromRGB(150,150,150)
            end
            
            if id == "steal" then
                StealActive = states[idx]
                if StealActive then
                    CreateStealPanel()
                    StartStealLoop()
                else
                    if StealPanel then StealPanel:Destroy(); StealPanel = nil end
                    StopStealLoop()
                end
            elseif id == "unlock" then
                if states[idx] then
                    CreateUnlockPanel()
                else
                    if UnlockPanel then UnlockPanel:Destroy(); UnlockPanel = nil end
                end
            elseif id == "actions" then
                if states[idx] then
                    CreateActionsPanel()
                else
                    if ActionsPanel then ActionsPanel:Destroy(); ActionsPanel = nil end
                end
            end
        end)
        
        row.MouseEnter:Connect(function()
            row.BackgroundTransparency = 0
        end)
        row.MouseLeave:Connect(function()
            row.BackgroundTransparency = 0.3
        end)
        
        y = y + 60
    end
    
    local footer = Instance.new("TextLabel", main)
    footer.Size = UDim2.new(1, 0, 0, 22)
    footer.Position = UDim2.new(0, 0, 1, -24)
    footer.BackgroundTransparency = 1
    footer.Text = "LAW HUB"
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 9
    footer.TextColor3 = Color3.fromRGB(100,100,100)
    
    -- DRAG SYSTEM
    local dragging = false
    local dragStart = nil
    local mainStart = nil
    
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            mainStart = main.Position
        end
    end)
    
    titleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                mainStart.X.Scale,
                mainStart.X.Offset + delta.X,
                mainStart.Y.Scale,
                mainStart.Y.Offset + delta.Y
            )
        end
    end)
    
    MainMenu = sg
end

-- =============================================
-- BOTÃO LAW
-- =============================================
local function CreateLawButton()
    if LawButton then LawButton:Destroy() end
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 70, 0, 32)
    btn.Position = UDim2.new(1, -80, 0, 10)
    btn.BackgroundColor3 = Black
    btn.BackgroundTransparency = 0.2
    btn.Text = "LAW"
    btn.TextColor3 = Yellow
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.BorderSizePixel = 0
    btn.Parent = LocalPlayer.PlayerGui
    MakeCorner(btn, 8)
    MakeStroke(btn, Yellow, 2)
    
    btn.MouseButton1Click:Connect(function()
        MenuVisible = not MenuVisible
        if MainMenu then
            MainMenu.Visible = MenuVisible
        end
    end)
    
    LawButton = btn
end

-- =============================================
-- INICIAR
-- =============================================
CreateLawButton()
CreateMainMenu()

print("=== LAW HUB CARREGADO ===")
print("Clique no botão LAW para abrir")
print("Arraste o menu pela barra LAW HUB")
print("Potion Steal = ativa poção só no Teleport")
print("Steal Speed = ativa velocidade só no Teleport")
