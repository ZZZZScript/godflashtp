-- MENU PRINCIPAL (CENTRALIZADO)
-- =============================================
local Menu = nil
local MenuBtn = nil
local MenuOpen = true

local function CreateMenu()
    if Menu then Menu:Destroy() end
    
    local sg = Instance.new("ScreenGui")
    sg.Name = "LawHubMenu"
    sg.ResetOnSpawn = false
    sg.Parent = LP.PlayerGui
    
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 280, 0, 380)
    f.Position = UDim2.new(0.5, -140, 0.4, 0)
    f.BackgroundColor3 = Black
    f.BackgroundTransparency = 0.1
    f.BorderSizePixel = 0
    f.Active = true
    f.Parent = sg
    Corner(f, 12)
    Stroke(f, Yellow, 2)
    
    -- BARRA DE TÍTULO (DRAG AQUI)
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BackgroundColor3 = Dark
    titleBar.BackgroundTransparency = 0.5
    titleBar.Parent = f
    Corner(titleBar, 12)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 1, 0)
    title.BackgroundTransparency = 1
    title.Text = "LAW HUB"
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 20
    title.TextColor3 = Yellow
    title.Parent = titleBar
    
    -- DRAG SYSTEM
    local drag = false
    local dragStart = nil
    local startPos = nil
    
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            dragStart = input.Position
            startPos = f.Position
        end
    end)
    
    titleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if drag and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            f.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    -- CONTEÚDO
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, -55)
    scroll.Position = UDim2.new(0, 0, 0, 45)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Yellow
    scroll.CanvasSize = UDim2.new(0, 0, 0, 280)
    scroll.Parent = f
    
    local cont = Instance.new("Frame")
    cont.Size = UDim2.new(1, 0, 0, 280)
    cont.BackgroundTransparency = 1
    cont.Parent = scroll
    
    -- SWITCHES
    MakeSwitch(cont, 5, "INSTANT STEAL", "Auto teleport + steal", function() return StealOn end, function(v)
        StealOn = v
        if v then StartSteal() else StopSteal() end
        ShowStealPanel(v)
    end)
    
    MakeSwitch(cont, 65, "ACTIVE POTION", "Auto use potion", function() return PotionOn end, function(v)
        PotionOn = v
        if v then WatchPotion() else StopWatch() end
        ShowPotionPanel(v)
    end)
    
    MakeSwitch(cont, 125, "UNLOCK BASE", "Unlock other base", function() return UnlockOn end, function(v)
        UnlockOn = v
        ShowUnlockPanel(v)
    end)
    
    MakeSwitch(cont, 185, "ACTIONS PANEL", "Rejoin, Kick, Ragdoll", function() return ActionsOn end, function(v)
        ActionsOn = v
        ShowActionsPanel(v)
    end)
    
    Menu = sg
end

