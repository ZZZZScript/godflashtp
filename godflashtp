local function MakeSwitch(parent, y, label, desc, getter, setter)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -20, 0, 50)
    f.Position = UDim2.new(0, 10, 0, y)
    f.BackgroundColor3 = Dark
    f.BackgroundTransparency = 0.5
    f.BorderSizePixel = 0
    f.Parent = parent
    Corner(f, 8)
    
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -70, 0, 22)
    t.Position = UDim2.new(0, 12, 0, 4)
    t.BackgroundTransparency = 1
    t.Text = label
    t.Font = Enum.Font.GothamBold
    t.TextSize = 13
    t.TextColor3 = Color3.fromRGB(255,255,255)
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = f
    
    local d = Instance.new("TextLabel")
    d.Size = UDim2.new(1, -70, 0, 18)
    d.Position = UDim2.new(0, 12, 0, 26)
    d.BackgroundTransparency = 1
    d.Text = desc
    d.Font = Enum.Font.Gotham
    d.TextSize = 10
    d.TextColor3 = Color3.fromRGB(150,150,150)
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.Parent = f
    
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 44, 0, 24)
    sw.Position = UDim2.new(1, -56, 0.5, -12)
    sw.BackgroundColor3 = getter() and Yellow or Color3.fromRGB(50,50,50)
    sw.BorderSizePixel = 0
    sw.Parent = f
    Corner(sw, 12)
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = getter() and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0
    knob.Parent = sw
    Corner(knob, 10)
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = sw
    
    btn.MouseButton1Click:Connect(function()
        local new = not getter()
        setter(new)
        Tween(sw, "BackgroundColor3", new and Yellow or Color3.fromRGB(50,50,50), 0.15)
        Tween(knob, "Position", new and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10), 0.15)
    end)
    
    f.MouseEnter:Connect(function() Tween(f, "BackgroundTransparency", 0, 0.1) end)
    f.MouseLeave:Connect(function() Tween(f, "BackgroundTransparency", 0.5, 0.1) end)
end

