-- ADMIN COMMANDS
local function GetAdminFrames()
    local ap = LP.PlayerGui:FindFirstChild("AdminPanel")
    if not ap then return nil, nil end
    local pnl = ap:FindFirstChild("AdminPanel")
    if not pnl then return nil, nil end
    local cont = pnl:FindFirstChild("Content")
    local prof = pnl:FindFirstChild("Profiles")
    if not cont or not prof then return nil, nil end
    return cont:FindFirstChild("ScrollingFrame"), prof:FindFirstChild("ScrollingFrame")
end

local function FireCmd(btn)
    local ok, conns = pcall(getconnections, btn.Activated)
    if ok and type(conns) == "table" then
        for _, c in ipairs(conns) do
            if type(c.Function) == "function" then
                task.spawn(c.Function)
            end
        end
    end
end

local function RunCmd(cmd, target)
    local cmdF, profF = GetAdminFrames()
    if not cmdF or not profF then return end
    local profBtn = profF:FindFirstChild(target.Name)
    local cmdBtn = cmdF:FindFirstChild(cmd)
    if not profBtn or not cmdBtn then return end
    FireCmd(profBtn)
    task.wait(0.05)
    FireCmd(cmdBtn)
    task.wait(0.05)
    FireCmd(profBtn)
    task.wait(0.05)
    FireCmd(cmdBtn)
end

-- TELEPORT FUNCTIONS
local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return p
        end
    end
    return nil
end

local function TeleportTo(pos)
    if Root then
        Root.CFrame = CFrame.new(pos)
        Root.Velocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = LP.Character
    local bp = LP:FindFirstChild("Backpack")
    if not char or not bp then return end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then
            t.Parent = bp
        end
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and Hum then
        Hum:EquipTool(carpet)
    end
end

local function UseGiantPotion()
    local bp = LP:FindFirstChild("Backpack")
    local char = LP.Character
    if not bp or not char then return end
    local pot = bp:FindFirstChild("Giant Potion")
    if pot then
        pot.Parent = char
        pcall(function() pot:Activate() end)
    end
end

local function DoReset()
    if not fflagsSet then
        for i = 1, 10 do SetFFLags() end
        fflagsSet = true
    end
    if LP.Character then
        LP.Character:Destroy()
    end
end

local function DoTeleportAndSteal()
    if teleporting then return end
    teleporting = true
    
    if PotionStealOn then
        UseGiantPotion()
    end
    
    local plot = GetMyPlot()
    if not plot then
        teleporting = false
        return
    end
    
    EquipCarpet()
    task.wait(0.1)
    
    local order = plot:GetAttribute("Order")
    if order == 2 then
        TeleportTo(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        TeleportTo(Vector3.new(-352, -7, 76))
    else
        TeleportTo(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        TeleportTo(Vector3.new(-353, -7, 44))
    end
    
    task.wait(0.2)
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            RunCmd("steal", p)
            break
        end
    end
    
    task.wait(0.5)
    teleporting = false
end

local function StartSteal()
    if StealThread then StealThread:Disconnect() end
    StealThread = RS.Heartbeat:Connect(function()
        if InstantStealOn and Hum and Hum.Health > 0 then
            DoTeleportAndSteal()
            task.wait(1.5)
        end
    end)
end

local function StopSteal()
    if StealThread then
        StealThread:Disconnect()
        StealThread = nil
    end
end

local function StartSpeed()
    if SpeedThread then SpeedThread:Disconnect() end
    SpeedThread = RS.Heartbeat:Connect(function()
        if InstantStealOn and StealSpeedOn and Hum then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local dir = Hum.MoveDirection
            if hrp and dir.Magnitude > 0 then
                hrp.Velocity = Vector3.new(dir.X * currentSpeed, hrp.Velocity.Y, dir.Z * currentSpeed)
            end
        end
    end)
end

local function StopSpeed()
    if SpeedThread then
        SpeedThread:Disconnect()
        SpeedThread = nil
    end
end

-- UNLOCK BASE
local function FindOtherPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in pairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        if sign then
            local yb = sign:FindFirstChild("YourBase")
            if not (yb and yb.Enabled) then
                return p
            end
        end
    end
    return nil
end

local function DoUnlock()
    local plot = FindOtherPlot()
    if not plot then return end
    for _, o in pairs(plot:GetDescendants()) do
        if o:IsA("ProximityPrompt") and o.Enabled then
            local txt = (o.ActionText or ""):lower()
            if txt:find("unlock") then
                local old = o.MaxActivationDistance
                o.MaxActivationDistance = 9999
                pcall(function() fireproximityprompt(o) end)
                task.delay(0.3, function() o.MaxActivationDistance = old end)
                break
            end
        end
    end
end

