-- =============================================
-- CREATE TOGGLE SWITCH
-- =============================================
local function CreateToggle(parent, y, label, desc, id, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 52)
    frame.Position = UDim2.new(0, 10, 0, y)
    frame.BackgroundColor3 = Colors.Panel
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Parent = parent
    MakeCorner(frame, 8)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -70, 0, 22)
    title.Position = UDim2.new(0, 12, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = label
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = Colors.Text
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame
    
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -70, 0, 18)
    descLabel.Position = UDim2.new(0, 12, 0, 28)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = desc
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextSize = 10
    descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.Parent = frame
    
    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 44, 0, 24)
    switchBg.Position = UDim2.new(1, -56, 0.5, -12)
    switchBg.BackgroundColor3 = Toggles[id] and Colors.ToggleOn or Colors.ToggleOff
    switchBg.BorderSizePixel = 0
    switchBg.Parent = frame
    MakeCorner(switchBg, 12)
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = Toggles[id] and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = switchBg
    MakeCorner(knob, 10)
    
    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = switchBg
    
    click.MouseButton1Click:Connect(function()
        Toggles[id] = not Toggles[id]
        
        if Toggles[id] then
            Tween(switchBg, {BackgroundColor3 = Colors.ToggleOn}, 0.15)
            Tween(knob, {Position = UDim2.new(1, -22, 0.5, -10)}, 0.15)
        else
            Tween(switchBg, {BackgroundColor3 = Colors.ToggleOff}, 0.15)
            Tween(knob, {Position = UDim2.new(0, 2, 0.5, -10)}, 0.15)
        end
        
        callback(Toggles[id])
    end)
    
    frame.MouseEnter:Connect(function()
        Tween(frame, {BackgroundTransparency = 0}, 0.1)
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, {BackgroundTransparency = 0.3}, 0.1)
    end)
    
    return frame
end

