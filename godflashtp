            if UnlockBaseUI then UnlockBaseUI:Destroy(); UnlockBaseUI = nil end
        end
    end)
    
    CreateToggleSwitch(container, 185, "ACTIONS PANEL", "Rejoin, Kick, Balloon, Ragdoll", "actions_panel", function(on)
