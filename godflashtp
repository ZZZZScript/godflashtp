                if Toggles[item.id] then 
                    enableBooster() 
                else 
                    disableBooster() 
                end
            elseif item.id == "unlock_base" then
                if Toggles[item.id] then
                    createUnlockBaseUI()
                else
                    if unlockBaseUI then 
                        unlockBaseUI:Destroy() 
                        unlockBaseUI = nil 
                    end
                end
            elseif item.id == "actions_panel" then
                if Toggles[item.id] then
                    createActionsPanel()
                else
                    if actionsUI then 
                        actionsUI:Destroy() 
                        actionsUI = nil 
                    end
                end
            end
        end)
        
        row.MouseEnter:Connect(function()
            tween(row, {BackgroundTransparency = 0}, 0.12)
        end)
        row.MouseLeave:Connect(function()
            tween(row, {BackgroundTransparency = 0.3}, 0.12)
        end)
    end
    
    -- Footer
    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, 0, 0, 20)
    footer.Position = UDim2.new(0, 0, 1, -22)
    footer.BackgroundTransparency = 1
    footer.Text = "LAW HUB | By Law"
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 9
    footer.TextColor3 = Color3.fromRGB(100, 100, 100)
    footer.TextXAlignment = Enum.TextXAlignment.Center
    footer.Parent = frame
    
    MainUI = gui
    return gui
end

