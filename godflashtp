local instaGrabEnabled = false
local instaRootPart = nil
local instaHumanoid = nil
local instaTeleporting = false

LocalPlayer.CharacterAdded:Connect(function(char)
    instaRootPart = char:WaitForChild("HumanoidRootPart")
    instaHumanoid = char:WaitForChild("Humanoid")
end)

local function findNearestStealPrompt()
    if not instaRootPart then return nil end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local myPos = instaRootPart.Position
    local nearest = nil
    local nearestDist = math.huge
    
    for _, plot in ipairs(plots:GetChildren()) do
        for _, obj in ipairs(plot:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled and obj.ActionText == "Steal" then
                local part = obj.Parent
                local pos = nil
                if part:IsA("BasePart") then
                    pos = part.Position
                elseif part:IsA("Model") then
                    local prim = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
                    if prim then pos = prim.Position end
                end
                if pos then
                    local dist = (myPos - pos).Magnitude
                    if dist <= obj.MaxActivationDistance and dist < nearestDist then
                        nearest = obj
                        nearestDist = dist
                    end
                end
            end
        end
    end
    return nearest
end

local function firePrompt(prompt)
    if not prompt then return end
    task.spawn(function()
        pcall(function()
            fireproximityprompt(prompt, 9999)
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
    end)
end

local function getMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                return plot
            end
        end
    end
    return nil
end

local function equipCarpet()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = backpack
        end
    end
    
    local carpet = backpack:FindFirstChild("Flying Carpet")
    if carpet then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(carpet) end
    end
end

local function teleportTo(pos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function doInstantSteal()
    if instaTeleporting then return end
    instaTeleporting = true
    
    local myPlot = getMyPlot()
    if not myPlot then
        instaTeleporting = false
        return
    end
    
    equipCarpet()
    task.wait(0.1)
    
    local order = myPlot:GetAttribute("Order")
    
    if order == 2 then
        teleportTo(Vector3.new(-368.18, -6.97, 69.17))
        task.wait(0.1)
        teleportTo(Vector3.new(-335.650, -5.103, 100.070))
        task.wait(0.1)
        teleportTo(Vector3.new(-351.980, -7.002, 75.540))
    elseif order == 1 then
        teleportTo(Vector3.new(-368.18, -7.02, 42.17))
        task.wait(0.1)
        teleportTo(Vector3.new(-336.110, -5.037, 19.840))
        task.wait(0.1)
        teleportTo(Vector3.new(-352.860, -7.002, 44.180))
    end
    
    local nearest = findNearestStealPrompt()
    if nearest then
        firePrompt(nearest)
    end
    
    task.wait(0.5)
    instaTeleporting = false
end

-- Auto steal loop
task.spawn(function()
    while true do
        if instaGrabEnabled and instaHumanoid and instaHumanoid.Health > 0 then
            doInstantSteal()
        end
        task.wait(1.5)
    end
end)

