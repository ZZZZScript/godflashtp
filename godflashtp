    btn.Parent = LocalPlayer:WaitForChild("PlayerGui")
    addCorner(btn, 6)
    addStroke(btn, Colors.Primary, 1.5)
    
    -- Hover
    btn.MouseEnter:Connect(function()
        tween(btn, {BackgroundTransparency = 0}, 0.15)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, {BackgroundTransparency = 0.1}, 0.15)
    end)
    
    -- Toggle
    btn.MouseButton1Click:Connect(function()
        UI_OPEN = not UI_OPEN
        if MainUI then
            if UI_OPEN then
                MainUI.Visible = true
                tween(MainUI, {BackgroundTransparency = 0.05}, 0.3)
            else
                tween(MainUI, {BackgroundTransparency = 1}, 0.25)
                task.delay(0.25, function()
                    if MainUI then MainUI.Visible = false end
                end)
            end
        end
    end)
    
    ToggleBtn = btn
    return btn
end

