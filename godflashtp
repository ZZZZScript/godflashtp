    for _, item in ipairs(menuItems) do
        createToggleSwitch(container, item.label, item.id, item.yPos, function(isOn)
            if item.id == "instant_steal" then
                instaGrabEnabled = isOn
                if isOn then
                    createInstantStealUI()
                elseif activePanels.instant_steal then
                    activePanels.instant_steal:Destroy()
                    activePanels.instant_steal = nil
                end
            elseif item.id == "active_potion" then
                activePotionEnabled = isOn
                if isOn then
                    createActivePotionUI()
                    setupPotionWatcher()
                elseif activePanels.active_potion then
                    activePanels.active_potion:Destroy()
                    activePanels.active_potion = nil
                end
            elseif item.id == "unlock_base" then
                if isOn then
                    createUnlockBaseUI()
                elseif unlockBaseUI then
                    unlockBaseUI:Destroy()
                    unlockBaseUI = nil
                end
            elseif item.id == "actions_panel" then
                if isOn then
                    createActionsPanel()
                elseif actionsUI then
                    actionsUI:Destroy()
                    actionsUI = nil
                end
            end
        end)
    end
    
    -- Footer
    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, 0, 0, 22)
    footer.Position = UDim2.new(0, 0, 1, -24)
    footer.BackgroundTransparency = 1
    footer.Text = "LAW HUB"
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 9
    footer.TextColor3 = Color3.fromRGB(100, 100, 100)
    footer.TextXAlignment = Enum.TextXAlignment.Center
    footer.Parent = frame
    
    MainUI = gui
    return gui
end

