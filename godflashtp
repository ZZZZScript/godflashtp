-- =============================================
-- 1. INSTANT STEAL (IGUAL FUN HUB)
-- =============================================
local function GetAdminFrames()
    local adminPanel = LocalPlayer.PlayerGui:FindFirstChild("AdminPanel")
    if not adminPanel then return nil, nil end
    local panel = adminPanel:FindFirstChild("AdminPanel")
    if not panel then return nil, nil end
    local content = panel:FindFirstChild("Content")
    local profiles = panel:FindFirstChild("Profiles")
    if not content or not profiles then return nil, nil end
    return content:FindFirstChild("ScrollingFrame"), profiles:FindFirstChild("ScrollingFrame")
end

local function FireButton(guiObject)
    local ok, conns = pcall(getconnections, guiObject.Activated)
    if ok and type(conns) == "table" then
        for _, conn in ipairs(conns) do
            if type(conn.Function) == "function" then
                task.spawn(conn.Function)
            end
        end
    end
end

local function RunCommandOnPlayer(commandName, target)
    local commandFrame, profileFrame = GetAdminFrames()
    if not commandFrame or not profileFrame then return end
    
    local profileButton = profileFrame:FindFirstChild(target.Name)
    local commandButton = commandFrame:FindFirstChild(commandName)
    if not profileButton or not commandButton then return end
    
    FireButton(profileButton)
    task.wait(0.05)
    FireButton(commandButton)
    task.wait(0.05)
    FireButton(profileButton)
    task.wait(0.05)
    FireButton(commandButton)
end

local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return plot
        end
    end
    return nil
end

local function TeleportTo(pos)
    if RootPart then
        RootPart.CFrame = CFrame.new(pos)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and Humanoid then
        Humanoid:EquipTool(carpet)
    end
end

local function DoSteal()
    local plot = GetMyPlot()
    if not plot then return end
    EquipCarpet()
    task.wait(0.1)
    local order = plot:GetAttribute("Order")
    if order == 2 then
        TeleportTo(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        TeleportTo(Vector3.new(-352, -7, 76))
    elseif order == 1 then
        TeleportTo(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        TeleportTo(Vector3.new(-353, -7, 44))
    end
    
    -- Usa o admin panel para roubar (igual balloon/ragdoll)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            RunCommandOnPlayer("steal", plr)
            break
        end
    end
end

local function StartStealLoop()
    if StealLoop then StealLoop:Disconnect() end
    StealLoop = RunService.Heartbeat:Connect(function()
        if Toggles.steal and Humanoid and Humanoid.Health > 0 then
            DoSteal()
            task.wait(1.5)
        end
    end)
end

local function StopStealLoop()
    if StealLoop then
        StealLoop:Disconnect()
        StealLoop = nil
    end
end

-- =============================================
-- 2. ACTIVE POTION
-- =============================================
local function UseGiantPotion()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return end
    local potion = bp:FindFirstChild("Giant Potion")
    if potion then
        potion.Parent = char
        pcall(function() potion:Activate() end)
    end
end

local function StartPotionWatcher()
    if PotionConnection then PotionConnection:Disconnect() end
    local gui = LocalPlayer:WaitForChild("PlayerGui")
    
    local function CheckText(text)
        if Toggles.potion and text and string.find(string.lower(text), "steal") then
            UseGiantPotion()
        end
    end
    
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") then
            CheckText(obj.Text)
            obj:GetPropertyChangedSignal("Text"):Connect(function() CheckText(obj.Text) end)
        end
    end
    
    PotionConnection = gui.DescendantAdded:Connect(function(d)
        if d:IsA("TextLabel") then
            CheckText(d.Text)
            d:GetPropertyChangedSignal("Text"):Connect(function() CheckText(d.Text) end)
        end
    end)
end

local function StopPotionWatcher()
    if PotionConnection then
        PotionConnection:Disconnect()
        PotionConnection = nil
    end
end

-- =============================================
-- 3. UNLOCK BASE (3 BOTÕES)
-- =============================================
local function FindOtherBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if not (yourBase and yourBase.Enabled) then
                return plot
            end
        end
    end
    return nil
end

local function UnlockFloor(floorNumber)
    local plot = FindOtherBase()
    if not plot then return end
    
    -- Teleporta para a posição correta do andar
    if floorNumber == 1 then
        TeleportTo(Vector3.new(-368, -7, 42))
    elseif floorNumber == 2 then
        TeleportTo(Vector3.new(-368, -7, 69))
    elseif floorNumber == 3 then
        TeleportTo(Vector3.new(-352, 25, 60))
    end
    task.wait(0.3)
    
    -- Encontra e ativa o prompt de unlock
    for _, obj in pairs(plot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local txt = (obj.ActionText or ""):lower()
            if txt:find("unlock") then
                local oldDist = obj.MaxActivationDistance
                obj.MaxActivationDistance = 9999
                pcall(function() 
                    fireproximityprompt(obj, 9999)
                    obj:InputHoldBegin()
                    task.wait(0.1)
                    obj:InputHoldEnd()
                end)
                task.delay(0.3, function() obj.MaxActivationDistance = oldDist end)
                break
            end
        end
    end
end

