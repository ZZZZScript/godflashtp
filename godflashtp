-- // [9] (Stroke Animation Loop) //
local function animateStroke()
	local tweenForward = TweenService:Create(strokeGrad, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		Offset = Vector2.new(1, 0)
	})
	local tweenBack = TweenService:Create(strokeGrad, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		Offset = Vector2.new(-1, 0)
	})
	tweenForward.Completed:Connect(function()
		tweenBack:Play()
	end)
	tweenBack.Completed:Connect(function()
		tweenForward:Play()
	end)
	tweenForward:Play()
end
animateStroke()

