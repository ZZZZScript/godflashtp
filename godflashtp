-- BUTTON STYLE FUNCTION
local function makeBtn(text, y)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, -20, 0, 45)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(30, 0, 20)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.TextColor3 = Color3.fromRGB(255, 150, 200)

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local s = Instance.new("UIStroke", btn)
    s.Thickness = 2
    s.Color = Color3.fromRGB(255, 0, 140)

    return btn
end

-- BUTTONS
local enableBtn = makeBtn("ENABLE BYPASS", 90)
local speedBtn = makeBtn("300k", 145)
local valueBtn = makeBtn("16", 200)
local bindBtn = makeBtn("BIND: V", 255)

-- TOGGLE LOGIC
local enabled = false

local function updateToggle()
    if enabled then
        statusBtn.Text = "ON"
        statusBtn.TextColor3 = Color3.fromRGB(120, 255, 160)
    else
        statusBtn.Text = "OFF"
        statusBtn.TextColor3 = Color3.fromRGB(255, 80, 120)
    end
end

statusBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    updateToggle()
end)

enableBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    updateToggle()
end)

updateToggle()
