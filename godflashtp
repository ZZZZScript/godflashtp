-- [[(/ FUNÇÃO PARA MUDAR O VALOR DO FLASH TP /)]]
FlashValueBox.MouseButton1Click:Connect(function()
    local inputBox = Instance.new("TextBox")
    inputBox.Size = UDim2.new(0, 150, 0, 35)
    inputBox.Position = UDim2.new(0.5, -75, 0.5, -17)
    inputBox.PlaceholderText = "Digite a distância"
    inputBox.Text = tostring(tpDistance)
    inputBox.BackgroundColor3 = Color3.new(0.15, 0.15, 0.2)
    inputBox.TextColor3 = Color3.new(1, 1, 1)
    inputBox.Font = Enum.Font.GothamBold
    inputBox.TextSize = 14
    inputBox.BorderSizePixel = 0
    inputBox.ClipsDescendants = true
    inputBox.Parent = ScreenGui
    
    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 8)
    inputCorner.Parent = inputBox
    
    inputBox:CaptureFocus()
    
    inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local newValue = tonumber(inputBox.Text)
            if newValue and newValue > 0 then
                tpDistance = newValue
                FlashValue.Text = string.format("%.1f", tpDistance)
            end
        end
        inputBox:Destroy()
    end)
end)

-- [[(/ FUNÇÃO PARA MUDAR O VALOR DO SPEED BOOST /)]]
SpeedValueBox.MouseButton1Click:Connect(function()
    local inputBox = Instance.new("TextBox")
    inputBox.Size = UDim2.new(0, 150, 0, 35)
    inputBox.Position = UDim2.new(0.5, -75, 0.5, -17)
    inputBox.PlaceholderText = "Digite a velocidade"
    inputBox.Text = tostring(speedAmount)
    inputBox.BackgroundColor3 = Color3.new(0.15, 0.15, 0.2)
    inputBox.TextColor3 = Color3.new(1, 1, 1)
    inputBox.Font = Enum.Font.GothamBold
    inputBox.TextSize = 14
    inputBox.BorderSizePixel = 0
    inputBox.ClipsDescendants = true
    inputBox.Parent = ScreenGui
    
    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 8)
    inputCorner.Parent = inputBox
    
    inputBox:CaptureFocus()
    
    inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local newValue = tonumber(inputBox.Text)
            if newValue and newValue >= 16 and newValue <= 250 then
                speedAmount = newValue
                SpeedValue.Text = tostring(speedAmount)
            end
        end
        inputBox:Destroy()
    end)
end)

-- [[(/ Sistema de Keybind - Clique com Botão Direito /)]]
FlashButton.MouseButton2Click:Connect(function()
    waitingForKeybind = true
    FlashButton.BackgroundColor3 = Color3.new(0.25, 0.2, 0.15)
    KeybindIndicator.Text = "?"
    KeybindIndicator.TextColor3 = Color3.new(1, 1, 1)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Keybind",
        Text = "Pressione qualquer tecla para definir o novo keybind",
        Duration = 3
    })
end)

-- [[(/ Aguardar tecla pressionada /)]]
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if waitingForKeybind then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            flashKeybind = input.KeyCode
            updateKeybindDisplay()
            KeybindIndicator.TextColor3 = Color3.new(1, 1, 1)
            FlashButton.BackgroundColor3 = Color3.new(0.117647, 0.117647, 0.117647)
            waitingForKeybind = false
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Keybind Definido",
                Text = "Agora use a tecla: " .. input.KeyCode.Name,
                Duration = 2
            })
        end
        return
    end
    
    if flashEnabled and input.KeyCode == flashKeybind then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -tpDistance)
        end
    end
end)

