local function MakeSwitch(parent, y, label, desc, state, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -20, 0, 50)
    row.Position = UDim2.new(0, 10, 0, y)
    row.BackgroundColor3 = Dark
    row.BackgroundTransparency = 0.5
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -70, 0, 22)
    lbl.Position = UDim2.new(0, 12, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextColor3 = Color3.fromRGB(255,255,255)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local dsc = Instance.new("TextLabel", row)
    dsc.Size = UDim2.new(1, -70, 0, 16)
    dsc.Position = UDim2.new(0, 12, 0, 28)
    dsc.BackgroundTransparency = 1
    dsc.Text = desc
    dsc.Font = Enum.Font.Gotham
    dsc.TextSize = 10
    dsc.TextColor3 = Color3.fromRGB(150,150,150)
    dsc.TextXAlignment = Enum.TextXAlignment.Left
    
    local sw = Instance.new("Frame", row)
    sw.Size = UDim2.new(0, 44, 0, 24)
    sw.Position = UDim2.new(1, -56, 0.5, -12)
    sw.BackgroundColor3 = state and Yellow or Color3.fromRGB(50,50,50)
    sw.BorderSizePixel = 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(0, 12)
    
    local knob = Instance.new("Frame", sw)
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = state and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,150,150)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 10)
    
    local btn = Instance.new("TextButton", sw)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    
    local currentState = state
    btn.MouseButton1Click:Connect(function()
        currentState = not currentState
        Tween(sw, {BackgroundColor3 = currentState and Yellow or Color3.fromRGB(50,50,50)}, 0.15)
        Tween(knob, {
            Position = currentState and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10),
            BackgroundColor3 = currentState and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,150,150)
        }, 0.15)
        callback(currentState)
    end)
    
    row.MouseEnter:Connect(function() Tween(row, {BackgroundTransparency = 0}, 0.1) end)
    row.MouseLeave:Connect(function() Tween(row, {BackgroundTransparency = 0.5}, 0.1) end)
    
    return row
end

