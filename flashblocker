-- Function to create button with keybind
local function makeKeybindButton(parent, text, callback, bindId, defaultKey)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 28)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -60, 1, 0)
    btn.Position = UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = frame
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    local keyLabel = Instance.new("TextLabel")
    keyLabel.Size = UDim2.new(0, 50, 1, 0)
    keyLabel.Position = UDim2.new(1, -55, 0, 0)
    keyLabel.BackgroundTransparency = 1
    keyLabel.Text = "(" .. (Keybinds[bindId] or defaultKey or "None") .. ")"
    keyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    keyLabel.Font = Enum.Font.GothamMedium
    keyLabel.TextSize = 10
    keyLabel.TextXAlignment = Enum.TextXAlignment.Right
    keyLabel.Parent = frame
    
    local currentBind = Keybinds[bindId] or defaultKey or "None"
    Keybinds[bindId] = currentBind
    if currentBind ~= "None" then KeybindFunctions[currentBind] = callback end
    
    btn.MouseButton2Click:Connect(function()
        keyLabel.Text = "(Press any key...)"
        keyLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        local connection
        connection = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local newKey = input.KeyCode.Name
                if KeybindFunctions[currentBind] == callback then KeybindFunctions[currentBind] = nil end
                currentBind = newKey
                Keybinds[bindId] = newKey
                KeybindFunctions[newKey] = callback
                keyLabel.Text = "(" .. newKey .. ")"
                keyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
                saveKeybinds()
                connection:Disconnect()
            end
        end)
        task.delay(5, function()
            pcall(function() connection:Disconnect() end)
            if keyLabel.Text == "(Press any key...)" then
                keyLabel.Text = "(" .. currentBind .. ")"
                keyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
        end)
    end)
    
    btn.MouseButton1Click:Connect(callback)
    return btn, keyLabel
end

