-- =============================================
-- FUNCOES
-- =============================================
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then tool.Parent = bp
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then hum:EquipTool(carpet)
    task.wait(0.1)
end

local function UseFlash()
    if not flashEnabled then return
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash)
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.2)
    end
end

-- GIRAR PERSONAGEM
local function GirarPersonagem(angulo)
    local hrp = getHRP()
    if not hrp then return
    local pos = hrp.Position
    hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(angulo), 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
end

-- CAMERA
local function SetCamera(lookBack)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if hrp and cam then
        local dir = lookBack and -hrp.CFrame.LookVector or hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + dir + Vector3.new(0, 2, 0))
    end
end

local function Teleportar(ponto, isBack)
    local hrp = getHRP()
    if not hrp then return
    hrp.CFrame = CFrame.new(ponto)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    SetCamera(isBack)
    for i = 1, 10 do
        task.wait(0.1)
        SetCamera(isBack)
    end
end

local function BlockNearest()
    local hrp = getHRP()
    if not hrp then return
    local nearest = nil
    local minDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local other = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if other then
                local d = (hrp.Position - other.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = p
                end
            end
        end
    end
    if nearest then
        pcall(function() StarterGui:SetCore("PromptBlockPlayer", nearest) end)
    end
end

local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Warning", Text = "Select a teleport!", Duration = 2})
        return
    end
    if teleportando then return
    teleportando = true
    
    EquipCarpet()
    task.wait(0.1)
    if flashEnabled then UseFlash() end
    
    local isBack = selectedTeleport >= 6
    
    if selectedTeleport == 1 then
        Teleportar(Teleport1Pos, isBack)
        if selectedTeleport >= 6 then GirarPersonagem(180) else GirarPersonagem(0) end
    elseif selectedTeleport == 2 then
        Teleportar(Teleport2Pos, isBack)
        if selectedTeleport >= 6 then GirarPersonagem(180) else GirarPersonagem(0) end
    elseif selectedTeleport == 3 then
        Teleportar(Teleport3Pos, isBack)
        if selectedTeleport >= 6 then GirarPersonagem(180) else GirarPersonagem(0) end
    elseif selectedTeleport == 4 then
        Teleportar(Teleport4Pos, isBack)
        if selectedTeleport >= 6 then GirarPersonagem(180) else GirarPersonagem(0) end
    elseif selectedTeleport == 5 then
        Teleportar(Teleport5Pos, isBack)
        if selectedTeleport >= 6 then GirarPersonagem(180) else GirarPersonagem(0) end
    elseif selectedTeleport == 6 then
        Teleportar(Teleport6Pos, isBack)
        GirarPersonagem(180)
    elseif selectedTeleport == 7 then
        Teleportar(Teleport7Pos, isBack)
        GirarPersonagem(180)
    elseif selectedTeleport == 8 then
        Teleportar(Teleport8Pos, isBack)
        GirarPersonagem(180)
    elseif selectedTeleport == 9 then
        Teleportar(Teleport9Pos, isBack)
        GirarPersonagem(180)
    elseif selectedTeleport == 10 then
        Teleportar(Teleport10Pos, isBack)
        GirarPersonagem(180)
    end
    
    if autoBlockOn then
        task.wait(0.3)
        BlockNearest()
    end
    
    teleportando = false
    StarterGui:SetCore("SendNotification", {Title = "Done", Text = "TELEPORT " .. selectedTeleport, Duration = 2})
end

local function Reset()
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0
    end
    task.wait(1)
    player:LoadCharacter()
end

