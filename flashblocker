-- CAMERA ESQUERDA (6 AO 10) - FORÇADO
local function lookLeft()
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if hrp and cam then
        -- Pega a direção atual do personagem e rotaciona -90 graus (ESQUERDA)
        local forward = hrp.CFrame.LookVector
        local left = Vector3.new(-forward.Z, forward.Y, forward.X) -- Rotação 90° para esquerda
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + left + Vector3.new(0, 2, 0))
    end
end