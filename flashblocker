-- =============================================
-- FLASH STEAL
-- =============================================
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if not flashEnabled then return
    
    local start = os.clock()
    local fired = false
    
    StealBarFill.BackgroundTransparency = 0
    StealBarBG.BackgroundTransparency = 0
    StealBarFill.Size = UDim2.new(0, 0, 1, 0)
    
    local conn = RunService.PreRender:Connect(function()
        if not prompt or not prompt.Parent then
            conn:Disconnect()
            TweenService:Create(StealBarFill, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 1, 0)}):Play()
            return
        end
        
        local progress = math.clamp((os.clock() - start) / prompt.HoldDuration, 0, 1)
        StealBarFill.Size = UDim2.new(progress, 0, 1, 0)
        
        if not fired and progress >= 0.95 then
            fired = true
            conn:Disconnect()
            local char = player.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate()
            
            StealBarFill.Size = UDim2.new(1, 0, 1, 0)
            task.delay(0.2, function()
                TweenService:Create(StealBarFill, TweenInfo.new(0.4), {Size = UDim2.new(0, 0, 1, 0)}):Play()
            end)
        end
    end)
    
    prompt.PromptButtonHoldEnded:Connect(function()
        if not fired then
            conn:Disconnect()
            TweenService:Create(StealBarFill, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 1, 0)}):Play()
        end
    end)
end)

