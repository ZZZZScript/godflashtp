-- Find Nearest Player
local function getNearestPlayer()
    local character = player.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local nearestPlayer = nil
    local shortestDistance = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherChar = plr.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local distance = (rootPart.Position - otherRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestPlayer = plr
                    end
                end
            end
        end
    end
    
    return nearestPlayer, shortestDistance
end

-- ========== BLOQUEIO COMPLETO CORRIGIDO ==========
local function blockPlayerComplete(plr)
    if not plr or plr == player then return end
    
    print("🔴 Iniciando bloqueio para: " .. plr.Name)
    
    -- Método 1: Clica no personagem do jogador
    local character = plr.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
        local camera = workspace.CurrentCamera
        
        if rootPart and camera then
            local vector, onScreen = camera:WorldToScreenPoint(rootPart.Position)
            
            if onScreen then
                print("🎯 Clicando no jogador: " .. plr.Name)
                VirtualInputManager:SendMouseButtonEvent(vector.X, vector.Y, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(vector.X, vector.Y, 0, false, game, 1)
                task.wait(0.15)
            end
        end
    end
    
    -- Método 2: Abre o menu de bloqueio
    pcall(function()
        StarterGui:SetCore("PromptBlockPlayer", plr)
    end)
    
    task.wait(0.1)
    
    -- Método 3: Procura e clica no botão de bloqueio
    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) then
                local text = (descendant.Text or ""):lower()
                local name = (descendant.Name or ""):lower()
                
                if text:find("block") or name:find("block") or text:find("bloquear") then
                    local x = descendant.AbsolutePosition.X + descendant.AbsoluteSize.X / 2
                    local y = descendant.AbsolutePosition.Y + descendant.AbsoluteSize.Y / 2
                    
                    print("🔘 Clicando no botão BLOCK")
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                    
                    print("✅ Jogador bloqueado com sucesso: " .. plr.Name)
                    return
                end
            end
        end
    end
    
    print("⚠️ Não foi possível bloquear automaticamente - " .. plr.Name .. " pode precisar de bloqueio manual")
end

