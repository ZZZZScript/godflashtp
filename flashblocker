resetLoadingCorner.Parent = resetLoadingBar

resetButton.MouseEnter:Connect(function()
    resetTextStroke.Thickness = 2.5
end)

resetButton.MouseLeave:Connect(function()
    resetTextStroke.Thickness = 1.5
end)

resetButton.MouseButton1Click:Connect(function()
    resetButton.Text = "RESETTING..."
    resetTextStroke.Thickness = 2.5
    
    resetLoadingBar.Visible = true
    resetLoadingBar.Size = UDim2.new(0, 0, 0, 2)
    
    coroutine.wrap(function()
        for i = 0, 234, 4 do
            resetLoadingBar.Size = UDim2.new(0, i, 0, 2)
            task.wait(0.01)
        end
        resetLoadingBar.Size = UDim2.new(0.9, 0, 0, 2)
    end)()
    
    executeReset()
    
    task.wait(0.5)
    resetButton.Text = "INSTA RESET"
    resetLoadingBar.Visible = false
    resetLoadingBar.Size = UDim2.new(0, 0, 0, 2)
    resetTextStroke.Thickness = 1.5
end)

-- Reset On Balloon toggle
local balloonToggleState = false
local balloonToggle = createToggle(mainFrame, UDim2.new(0.05, 0, 0, 191), "Reset On Balloon", balloonToggleState, function(state)
    balloonToggleState = state
    Config.AutoResetOnBalloon = state
    print("Balloon Reset: " .. (state and "ACTIVE" or "INACTIVE"))
end)
