-- Função para forçar câmera em qualquer direção
local function ForceCamera(direction)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if not hrp or not cam then return end
    
    local lookDir
    if direction == "front" then
        lookDir = hrp.CFrame.LookVector
    elseif direction == "back" then
        lookDir = -hrp.CFrame.LookVector
    elseif direction == "left" then
        lookDir = -hrp.CFrame.RightVector
    elseif direction == "right" then
        lookDir = hrp.CFrame.RightVector
    end
    
    cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + lookDir + Vector3.new(0, 2, 0))
    
    -- Força várias vezes
    for i = 1, 15 do
        task.wait(0.1)
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + lookDir + Vector3.new(0, 2, 0))
    end
end
