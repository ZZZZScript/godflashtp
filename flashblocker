-- Equipar Tapete
local function EquiparTapete()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local tapete = bp:FindFirstChild("Flying Carpet")
    if tapete and Humanoid then
        Humanoid:EquipTool(tapete)
        task.wait(0.2)
    end
end

-- Usar Flash
local function UsarFlash()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            flash.Parent = char
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
    end
end

-- Teleportar
local function TeleportarPosicao(posicao)
    if not RootPart then return false end
    RootPart.CFrame = CFrame.new(posicao)
    RootPart.AssemblyLinearVelocity = Vector3.zero
    return true
end

-- Executar TELEPORT
local function ExecutarTeleport(nomeTeleport)
    if teleportando then
        print("⚠️ Já está teleportando...")
        return
    end
    
    local tp = Teleports[nomeTeleport]
    if not tp then
        print("❌ Teleport não encontrado: " .. nomeTeleport)
        return
    end
    
    teleportando = true
    
    -- Equipa Tapete
    EquiparTapete()
    task.wait(0.2)
    
    -- Usa Flash
    UsarFlash()
    task.wait(0.1)
    
    -- Se precisar usar ponto de partida
    if tp.UsarPartida then
        print("📍 Indo para ponto de partida...")
        TeleportarPosicao(PontoPartida)
        task.wait(0.15)
    end
    
    -- Teleporta por todos os pontos
    for i, ponto in ipairs(tp.Pontos) do
        TeleportarPosicao(ponto)
        print("📍 Ponto " .. i .. "/" .. #tp.Pontos)
        task.wait(0.15)
    end
    
    print("✅ " .. nomeTeleport .. " concluído!")
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "✅ Concluído!";
        Text = nomeTeleport;
        Duration = 2;
    })
    
    teleportando = false
end

