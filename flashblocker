-- =============================================
-- FUNCOES
-- =============================================
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then
        hum:EquipTool(carpet)
        task.wait(0.1)
    end
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.15)
    end
end

-- FORCA CAMERA
local function ForcarCamera(olharParaTras)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if hrp and cam then
        local direcao = olharParaTras and -hrp.CFrame.LookVector or hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + direcao + Vector3.new(0, 2, 0))
    end
end

local function Teleportar(pos, olharParaTras)
    local hrp = getHRP()
    if not hrp then return false
    
    hrp.CFrame = CFrame.new(pos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    
    ForcarCamera(olharParaTras)
    for i = 1, 10 do
        task.wait(0.1)
        ForcarCamera(olharParaTras)
    end
    
    return true
end

local function ExecutarTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Aviso", Text = "Selecione um teleport!", Duration = 2})
        return
    end
    
    if teleporting then return
    teleporting = true
    
    EquipCarpet()
    task.wait(0.1)
    
    if flashEnabled then
        UseFlash()
    end
    
    local olharParaTras = selectedTeleport >= 6
    
    if selectedTeleport == 1 then
        Teleportar(Teleport1Pos, olharParaTras)
    elseif selectedTeleport == 2 then
        Teleportar(Teleport2Pos, olharParaTras)
    elseif selectedTeleport == 3 then
        Teleportar(Teleport3Pos, olharParaTras)
    elseif selectedTeleport == 4 then
        Teleportar(Teleport4Pos, olharParaTras)
    elseif selectedTeleport == 5 then
        Teleportar(Teleport5Pos, olharParaTras)
    elseif selectedTeleport == 6 then
        Teleportar(Teleport6Pos, olharParaTras)
    elseif selectedTeleport == 7 then
        Teleportar(Teleport7Pos, olharParaTras)
    elseif selectedTeleport == 8 then
        Teleportar(Teleport8Pos, olharParaTras)
    elseif selectedTeleport == 9 then
        Teleportar(Teleport9Pos, olharParaTras)
    elseif selectedTeleport == 10 then
        Teleportar(Teleport10Pos, olharParaTras)
    end
    
    teleporting = false
    StarterGui:SetCore("SendNotification", {Title = "Completo", Text = "TELEPORT " .. selectedTeleport, Duration = 2})
end

