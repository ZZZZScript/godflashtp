-- =============================================
-- FUNCTIONS
-- =============================================
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function TeleportTo(pos)
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if carpet and hum then
        hum:EquipTool(carpet)
        task.wait(0.2)
    end
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        
        for _, child in ipairs(flash:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                pcall(function() child:FireServer() end)
            elseif child:IsA("RemoteFunction") then
                pcall(function() child:InvokeServer() end)
            end
        end
    end
end

-- =============================================
-- EXECUTE TELEPORT
-- =============================================
local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {
            Title = "Warning",
            Text = "Select a teleport first!",
            Duration = 2
        })
        return
    end
    
    if teleporting then
        print("Already teleporting...")
        return
    end
    
    local tp = Teleports[selectedTeleport]
    if not tp then return end
    
    teleporting = true
    print("========== EXECUTING: " .. selectedTeleport .. " ==========")
    
    -- Equip Carpet and Flash
    EquipCarpet()
    task.wait(0.2)
    UseFlash()
    task.wait(0.1)
    
    -- Handle TELEPORT 1 (multiple points)
    if selectedTeleport == "TELEPORT 1" and tp.Sequence then
        for i, point in ipairs(tp.Sequence) do
            TeleportTo(point)
            print("📍 Point " .. i .. "/3")
            task.wait(0.15)
        end
    else
        -- For Teleport 6-10, go to start point first
        if tp.UseStart then
            print("📍 Going to start point...")
            TeleportTo(StartPoint)
            task.wait(0.15)
        end
        
        -- Teleport to destination
        TeleportTo(tp.Pos)
        task.wait(0.15)
    end
    
    print("✅ " .. selectedTeleport .. " completed!")
    teleporting = false
    
    StarterGui:SetCore("SendNotification", {
        Title = "Complete",
        Text = selectedTeleport,
        Duration = 2
    })
end

