-- =============================================
-- FUNCTIONS
-- =============================================
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function TeleportTo(pos)
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if carpet and hum then
        hum:EquipTool(carpet)
        task.wait(0.2)
    end
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
    end
end

local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Warning", Text = "Select a teleport first!", Duration = 2})
        return
    end
    
    if teleporting then return end
    teleporting = true
    
    local tp = TeleportPoints[selectedTeleport]
    if not tp then teleporting = false return end
    
    print("Executing: " .. tp.name)
    
    EquipCarpet()
    task.wait(0.2)
    UseFlash()
    task.wait(0.1)
    
    if tp.sequence then
        for i, point in ipairs(tp.sequence) do
            TeleportTo(point)
            task.wait(0.15)
        end
    else
        if tp.useStart then
            TeleportTo(StartPoint)
            task.wait(0.15)
        end
        TeleportTo(tp.pos)
        task.wait(0.15)
    end
    
    teleporting = false
    StarterGui:SetCore("SendNotification", {Title = "Complete", Text = tp.name, Duration = 2})
end

local function InstaReset()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
        player:LoadCharacter()
    end
end

local function getNearestPlayer()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local nearest = nil
    local shortest = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherChar = plr.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local dist = (root.Position - otherRoot.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = plr
                    end
                end
            end
        end
    end
    return nearest
end

local function blockPlayer(plr)
    if not plr or plr == player then return end
    pcall(function() StarterGui:SetCore("PromptBlockPlayer", plr) end)
end

