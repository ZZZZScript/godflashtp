local function getHRP()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function EquipCarpet()
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c or not b then return
    for _, t in pairs(c:GetChildren()) do if t:IsA("Tool") then t.Parent = b end end
    local carpet = b:FindFirstChild("Flying Carpet")
    local h = c:FindFirstChildOfClass("Humanoid")
    if carpet and h then h:EquipTool(carpet) end
    task.wait(0.1)
end

local function UseFlash()
    if not flashOn then return end
    local c = player.Character
    if not c then return
    local flash = nil
    for _, t in pairs(c:GetChildren()) do
        if t:IsA("Tool") and (t.Name:lower():find("flash") or t.Name:lower():find("flashlight")) then flash = t break end
    end
    if not flash then
        local b = player:FindFirstChild("Backpack")
        if b then for _, t in pairs(b:GetChildren()) do
            if t:IsA("Tool") and (t.Name:lower():find("flash") or t.Name:lower():find("flashlight")) then flash = t break end
        end end
    end
    if flash then
        if flash.Parent ~= c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.2)
    end
end

local function BlockNearest()
    local h = getHRP()
    if not h then return end
    local nearest, minDist = nil, math.huge
    for _, pl in pairs(Players:GetPlayers()) do
        if pl ~= player then
            local oh = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
            if oh then
                local d = (h.Position - oh.Position).Magnitude
                if d < minDist then minDist, nearest = d, pl end
            end
        end
    end
    if nearest then pcall(function() StarterGui:SetCore("PromptBlockPlayer", nearest) end) end
end

local function DoTeleport()
    EquipCarpet()
    task.wait(0.1)
    if flashOn then UseFlash() end
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = CFrame.new(Teleports[selected])
        hrp.AssemblyLinearVelocity = Vector3.zero
        if selected >= 6 then
            local pos = hrp.Position
            hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(180), 0)
        end
    end
    if autoBlock then task.wait(0.3) BlockNearest() end
    StarterGui:SetCore("SendNotification", {Title = "Done", Text = "TELEPORT " .. selected, Duration = 2})
end

local function Reset()
    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end
    task.wait(1)
    player:LoadCharacter()
end

