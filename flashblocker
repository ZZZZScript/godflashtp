-- FUNCTIONS
-- =============================================
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then
        hum:EquipTool(carpet)
        task.wait(0.1)
    end
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.15)
    end
end

-- FORÇA a camera em uma direção específica
local function ForceCamera(direction) -- direction: "front" ou "right"
    local hrp = getHRP()
    if not hrp then return end
    
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local lookDir
    if direction == "right" then
        lookDir = hrp.CFrame.RightVector
    else
        lookDir = hrp.CFrame.LookVector
    end
    
    cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + lookDir + Vector3.new(0, 2, 0))
end

local function TeleportTo(pos, cameraDir)
    local hrp = getHRP()
    if not hrp then return false end
    
    -- Teleporta
    hrp.CFrame = CFrame.new(pos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    
    -- FORÇA a camera imediatamente
    ForceCamera(cameraDir)
    
    -- FORÇA a camera várias vezes nos próximos segundos (pq o Roblox reseta)
    task.spawn(function()
        for i = 1, 10 do
            task.wait(0.1)
            if hrp and hrp.Parent then
                ForceCamera(cameraDir)
            end
        end
    end)
    
    return true
end

local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Warning", Text = "Select a teleport first!", Duration = 2})
        return
    end
    
    if teleporting then return end
    teleporting = true
    
    EquipCarpet()
    task.wait(0.1)
    
    if flashEnabled then
        UseFlash()
    end
    
    -- TELEPORT 1-5: camera FRENTE
    -- TELEPORT 6-10: camera DIREITA
    if selectedTeleport == 1 then
        TeleportTo(Teleport1Pos, "front")
    elseif selectedTeleport == 2 then
        TeleportTo(Teleport2Pos, "front")
    elseif selectedTeleport == 3 then
        TeleportTo(Teleport3Pos, "front")
    elseif selectedTeleport == 4 then
        TeleportTo(Teleport4Pos, "front")
    elseif selectedTeleport == 5 then
        TeleportTo(Teleport5Pos, "front")
    elseif selectedTeleport == 6 then
        TeleportTo(Teleport6Pos, "right")
    elseif selectedTeleport == 7 then
        TeleportTo(Teleport7Pos, "right")
    elseif selectedTeleport == 8 then
        TeleportTo(Teleport8Pos, "right")
    elseif selectedTeleport == 9 then
        TeleportTo(Teleport9Pos, "right")
    elseif selectedTeleport == 10 then
        TeleportTo(Teleport10Pos, "right")
    end
    
    teleporting = false
    StarterGui:SetCore("SendNotification", {Title = "Complete", Text = "TELEPORT " .. selectedTeleport, Duration = 2})
end

-- =============================================
-- INSTANT RESET (FORA DO MAPA)
-- =============================================
local function InstaReset()
    local char = player.Character
    if not char then
        player:LoadCharacter()
        return
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hrp then
        hrp.CFrame = CFrame.new(0, -10000, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    
    if hum then
        hum.Health = 0
        hum:BreakJoints()
    end
    
    player:LoadCharacter()
end

-- =============================================
-- PREBLOCK
-- =============================================
local function getNearestPlayer()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local nearest = nil
    local shortest = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherChar = plr.Character
            if otherChar then
                local otherHrp = otherChar:FindFirstChild("HumanoidRootPart")
                if otherHrp then
                    local dist = (hrp.Position - otherHrp.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = plr
                    end
                end
            end
        end
    end
    return nearest
end

local function blockPlayer(plr)
    if not plr or plr == player then return end
    pcall(function() StarterGui:SetCore("PromptBlockPlayer", plr) end)
end

local function DoPreBlock()
    local nearest = getNearestPlayer()
    if nearest then
        blockPlayer(nearest)
    end
end

