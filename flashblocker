local function getHRP()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function EquipCarpet()
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c or not b then return end
    for _, t in pairs(c:GetChildren()) do if t:IsA("Tool") then t.Parent = b end end
    local carpet = b:FindFirstChild("Flying Carpet")
    local h = c:FindFirstChildOfClass("Humanoid")
    if carpet and h then h:EquipTool(carpet) end
    task.wait(0.1)
end

local function UseFlash()
    if not flashOn then return end
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c then return end
    local flash = nil
    for _, t in pairs(c:GetChildren()) do
        if t:IsA("Tool") and (t.Name:lower():find("flash") or t.Name:lower():find("flashlight")) then flash = t break end
    end
    if not flash and b then
        for _, t in pairs(b:GetChildren()) do
            if t:IsA("Tool") and (t.Name:lower():find("flash") or t.Name:lower():find("flashlight")) then flash = t break end
        end
    end
    if flash then
        if flash.Parent == b then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h:EquipTool(flash) end
        end
        pcall(function() flash:Activate() end)
        task.wait(0.2)
    end
end

-- GIRAR BONECO e CAMERA
local function GirarBoneco(angulo)
    local hrp = getHRP()
    if not hrp then return end
    local posicao = hrp.Position
    hrp.CFrame = CFrame.new(posicao) * CFrame.Angles(0, math.rad(angulo), 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
end

local function SetCamera(lookBack)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if hrp and cam then
        local dir = lookBack and -hrp.CFrame.LookVector or hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + dir + Vector3.new(0, 2, 0))
    end
end

local function Teleportar(ponto, isBack)
    local hrp = getHRP()
    if not hrp then return end
    hrp.CFrame = CFrame.new(ponto)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    SetCamera(isBack)
    for i = 1, 10 do
        task.wait(0.1)
        SetCamera(isBack)
    end
end

local function Execute()
    if not selected then
        StarterGui:SetCore("SendNotification", {Title = "Warning", Text = "Select a teleport!", Duration = 2})
        return
    end
    EquipCarpet()
    task.wait(0.1)
    UseFlash()
    
    -- TELEPORT 1-5: camera FRENTE / TELEPORT 6-10: camera TRAS
    local isBack = selected >= 6
    Teleportar(pos[selected], isBack)
    
    StarterGui:SetCore("SendNotification", {Title = "Done", Text = "TELEPORT " .. selected, Duration = 2})
end

-- RESET COM 1 SEGUNDO
local function Reset()
    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end
    task.wait(1)
    player:LoadCharacter()
end

-- PREBLOCK
local function PreBlock()
    local hrp = getHRP()
    if not hrp then return end
    local nearest = nil
    local minDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local other = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if other then
                local d = (hrp.Position - other.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = p
                end
            end
        end
    end
    if nearest then
        pcall(function() StarterGui:SetCore("PromptBlockPlayer", nearest) end)
    end
end

