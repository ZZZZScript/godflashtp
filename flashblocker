-- FLASH STEAL
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if not flashEnabled then return
    
    local start = os.clock()
    local fired = false
    
    StealFill.Size = UDim2.new(0, 0, 1, 0)
    
    local conn = RunService.PreRender:Connect(function()
        if not prompt or not prompt.Parent then
            conn:Disconnect()
            return
        end
        
        local progress = math.clamp((os.clock() - start) / prompt.HoldDuration, 0, 1)
        StealFill.Size = UDim2.new(progress, 0, 1, 0)
        
        if not fired and progress >= 0.95 then
            fired = true
            conn:Disconnect()
            local char = player.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate()
            StealFill.Size = UDim2.new(1, 0, 1, 0)
            task.delay(0.2, function()
                StealFill.Size = UDim2.new(0, 0, 1, 0)
            end)
        end
    end)
end)

-- HOTKEYS
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return
    
    if input.KeyCode == Enum.KeyCode.F then
        ExecuteTeleport()
    elseif input.KeyCode == Enum.KeyCode.R then
        InstaReset()
    end
end)

