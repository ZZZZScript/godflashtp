-- 5. ANTI-ANIMATION LOCK (prevents animation locks)
local function AntiAnimationLock()
    local char = player.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local animator = hum:FindFirstChild("Animator")
        if animator then
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                local animName = string.lower(track.Animation and track.Animation.Name or "")
                if animName:find("rag") or animName:find("fall") or animName:find("hurt") or animName:find("stun") then
                    track:Stop(0)
                end
            end
        end
    end
end

-- 6. ANTI-SCRIPT KILLER (prevents scripts from being killed)
local function AntiScriptKiller()
    pcall(function()
        local screenGuis = playerGui:GetChildren()
        for _, gui in ipairs(screenGuis) do
            if gui.Name == "LawHub_Flash" then
                gui.ResetOnSpawn = false
            end
        end
    end)
end

-- 7. ANTI-CRASH (prevents UI crashes)
local function AntiCrash()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
end

