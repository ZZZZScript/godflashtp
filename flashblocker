-- STEAL
ProximityPromptService.PromptButtonHoldBegan:Connect(function(p)
    if not flash then return end
    local s = os.clock()
    local f = false
    stealFill.Size = UDim2.new(0,0,1,0)
    local c = RunService.PreRender:Connect(function()
        if not p or not p.Parent then c:Disconnect() return end
        local prog = math.clamp((os.clock()-s)/p.HoldDuration,0,1)
        stealFill.Size = UDim2.new(prog,0,1,0)
        if not f and prog >= 0.95 then
            f = true
            c:Disconnect()
            local t = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if t then t:Activate() end
            stealFill.Size = UDim2.new(1,0,1,0)
            task.delay(0.2, function() stealFill.Size = UDim2.new(0,0,1,0) end)
        end
    end)
end)

