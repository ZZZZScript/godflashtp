-- =============================================
-- PERSONAGEM
-- =============================================
local function AtualizarPersonagem()
    local char = LocalPlayer.Character
    if char then
        RootPart = char:FindFirstChild("HumanoidRootPart")
        Humanoid = char:FindFirstChildOfClass("Humanoid")
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    AtualizarPersonagem()
end)
