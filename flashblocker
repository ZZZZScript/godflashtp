-- =============================================
local function InstaReset()
    local char = player.Character
    if not char then 
        player:LoadCharacter()
        return
    end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hum then
        -- Método 1: Mata o personagem
        hum.Health = 0
    end
    
    if hrp then
        -- Método 2: Teleporta para o céu
        hrp.CFrame = CFrame.new(0, 100000, 0)
    end
    
    -- Força o respawn em 0.1 segundos
    task.wait(0.1)
    player:LoadCharacter()
    
    print("🔄 INSTA RESET (0.1s) EXECUTED!")
end

local function getNearestPlayer()
    local hrp = getHRP()
    if not hrp then return nil end
    
    local nearest = nil
    local shortest = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local dist = (hrp.Position - otherHrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

local function blockPlayer(plr)
    if not plr or plr == player then return end
    pcall(function() StarterGui:SetCore("PromptBlockPlayer", plr) end)
end

local function OnFPressed()
    ExecuteTeleport()
    task.wait(0.3)
    if autoBlockEnabled then
        local nearest = getNearestPlayer()
        if nearest then
            blockPlayer(nearest)
            print("Blocked: " .. nearest.Name)
        end
    end
end

