-- Atualizar coordenadas
local function UpdateCoords()
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local pos = char.HumanoidRootPart.Position
        local x = math.floor(pos.X * 10) / 10
        local y = math.floor(pos.Y * 10) / 10
        local z = math.floor(pos.Z * 10) / 10
        
        xLabel.Text = "X: " .. x
        yLabel.Text = "Y: " .. y
        zLabel.Text = "Z: " .. z
        vecLabel.Text = "Vector3.new(" .. x .. ", " .. y .. ", " .. z .. ")"
    end
end

-- Copiar
CopyBtn.MouseButton1Click:Connect(function()
    local text = vecLabel.Text
    if text and text ~= "Vector3.new(---)" then
        setclipboard(text)
        CopyBtn.Text = "✅ COPIED!"
        task.wait(1)
        CopyBtn.Text = "📋 COPY POSITION"
    end
end)

-- Atualizar a cada frame
RunService.RenderStepped:Connect(UpdateCoords)

-- DRAG
local dragging = false
local dragStart, startPos

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

