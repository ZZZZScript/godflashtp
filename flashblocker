local function carpetTP()
    local base = detectBase()
    local plots = workspace:FindFirstChild("Plots")
    if plots then
        for _,plot in ipairs(plots:GetChildren()) do
            if not isMyBase(plot.Name) then
                local pos = plot:GetPivot().Position
                local root = getRoot()
                if root then root.CFrame = CFrame.new(pos) end
                break
            end
        end
    end
    Notify.show("Carpet TP", "Teleported to next base")
end

