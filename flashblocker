-- Toggle dropdown
DropdownBtn.MouseButton1Click:Connect(function()
    dropdownOpen = not dropdownOpen
    OptionsFrame.Visible = dropdownOpen
    
    if dropdownOpen then
        MainFrame.Size = UDim2.new(0, 280, 0, 100 + OptionsFrame.Size.Y.Offset + 10)
    else
        MainFrame.Size = UDim2.new(0, 280, 0, 180)
    end
end)

-- Close dropdown when clicking outside (optional)
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if dropdownOpen then
            local mousePos = UserInputService:GetMouseLocation()
            local btnPos = DropdownBtn.AbsolutePosition
            local btnSize = DropdownBtn.AbsoluteSize
            local optionsPos = OptionsFrame.AbsolutePosition
            local optionsSize = OptionsFrame.AbsoluteSize
            
            local clickedInside = (mousePos.X >= btnPos.X and mousePos.X <= btnPos.X + btnSize.X and
                                   mousePos.Y >= btnPos.Y and mousePos.Y <= btnPos.Y + btnSize.Y) or
                                  (mousePos.X >= optionsPos.X and mousePos.X <= optionsPos.X + optionsSize.X and
                                   mousePos.Y >= optionsPos.Y and mousePos.Y <= optionsPos.Y + optionsSize.Y)
            
            if not clickedInside then
                OptionsFrame.Visible = false
                dropdownOpen = false
                MainFrame.Size = UDim2.new(0, 280, 0, 180)
            end
        end
    end
end)

