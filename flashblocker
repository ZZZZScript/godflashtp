local function getHrp()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = player.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function equipCarpet()
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c or not b then return end
    for _, t in pairs(c:GetChildren()) do if t:IsA("Tool") then t.Parent = b end end
    local carpet = b:FindFirstChild("Flying Carpet")
    local h = getHum()
    if carpet and h then h:EquipTool(carpet) end
    task.wait(0.1)
end

local function useFlash()
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c then return end
    local fl = nil
    for _, t in pairs(c:GetChildren()) do if t:IsA("Tool") and t.Name:lower():find("flash") then fl = t break end end
    if not fl and b then for _, t in pairs(b:GetChildren()) do if t:IsA("Tool") and t.Name:lower():find("flash") then fl = t break end end end
    if fl then
        if fl.Parent == b then local h = getHum() if h then h:EquipTool(fl) end end
        pcall(function() fl:Activate() end)
        task.wait(0.15)
    end
end

local function setCamera(back)
    local h = getHrp()
    local c = workspace.CurrentCamera
    if h and c then
        local d = back and -h.CFrame.LookVector or h.CFrame.LookVector
        c.CFrame = CFrame.new(h.Position + Vector3.new(0,2,0), h.Position + d + Vector3.new(0,2,0))
    end
end

local function tp(p, back)
    local h = getHrp()
    if not h then return end
    h.CFrame = CFrame.new(p)
    h.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    setCamera(back)
    for i=1,10 do task.wait(0.1) setCamera(back) end
end

local function doTp()
    if not sel then StarterGui:SetCore("SendNotification",{Title="",Text="Select a teleport!"}); return end
    equipCarpet()
    task.wait(0.1)
    if flash then useFlash() end
    tp(pos[sel], sel >= 6)
    StarterGui:SetCore("SendNotification",{Title="Done",Text="TELEPORT "..sel})
end

local function reset()
    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end
    player:LoadCharacter()
end

local function block()
    local h = getHrp()
    if not h then return end
    local nearest, best = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local oh = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if oh then
                local d = (h.Position - oh.Position).Magnitude
                if d < best then best = d; nearest = p end
            end
        end
    end
    if nearest then pcall(function() StarterGui:SetCore("PromptBlockPlayer", nearest) end) end
end

