-- =============================================
-- ANTI-CHEATING SYSTEM (CatHUB Style)
-- =============================================
local AntiCheat = {
    Enabled = true,
    AntiRagdoll = true,
    AntiKick = true,
    AntiFreeze = true,
    LastPosition = nil,
    FreezeCount = 0,
}

-- Anti-Ragdoll
local function AntiRagdoll()
    local char = player.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Physics or 
       state == Enum.HumanoidStateType.Ragdoll or 
       state == Enum.HumanoidStateType.FallingDown then
        
        hum:ChangeState(Enum.HumanoidStateType.Running)
        
        -- Clean up ragdoll constraints
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BallSocketConstraint") or 
               obj:IsA("HingeConstraint") or 
               obj:IsA("NoCollisionConstraint") then
                obj:Destroy()
            end
        end
    end
end

-- Anti-Kick (prevents being kicked by server)
local function AntiKick()
    pcall(function()
        local ts = game:GetService("TeleportService")
        local oldKick = ts.Kick
        ts.Kick = function() end
        
        local playersService = Players
        local oldPlayerKick = playersService.Kick
        playersService.Kick = function() end
    end)
    
    -- Block kick remote events
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            if remote.Name:lower():find("kick") or remote.Name:lower():find("ban") then
                pcall(function()
                    remote.OnServerEvent:Connect(function()
                        return
                    end)
                end)
            end
        end
    end
end

-- Anti-Freeze (prevents character freeze)
local function AntiFreeze()
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hrp and hum then
        local currentPos = hrp.Position
        if AntiCheat.LastPosition then
            if (currentPos - AntiCheat.LastPosition).Magnitude < 0.5 then
                AntiCheat.FreezeCount = AntiCheat.FreezeCount + 1
                if AntiCheat.FreezeCount > 10 then
                    -- Unfreeze character
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                    AntiCheat.FreezeCount = 0
                end
            else
                AntiCheat.FreezeCount = 0
            end
        end
        AntiCheat.LastPosition = currentPos
    end
end

-- Anti-Cheat Loops
if AntiCheat.AntiRagdoll then
    RunService.Heartbeat:Connect(AntiRagdoll)
end

if AntiCheat.AntiKick then
    AntiKick()
end

if AntiCheat.AntiFreeze then
    RunService.Heartbeat:Connect(AntiFreeze)
end

