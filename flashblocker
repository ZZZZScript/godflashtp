ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if not flashEnabled then return
    local start = os.clock()
    local fired = false
    StealBarFill.Size = UDim2.new(0, 0, 1, 0)
    local conn = RunService.PreRender:Connect(function()
        if not prompt or not prompt.Parent then conn:Disconnect() return end
        local progress = math.clamp((os.clock() - start) / prompt.HoldDuration, 0, 1)
        StealBarFill.Size = UDim2.new(progress, 0, 1, 0)
        if not fired and progress >= 0.95 then
            fired = true
            conn:Disconnect()
            local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if tool then tool:Activate()
            StealBarFill.Size = UDim2.new(1, 0, 1, 0)
            task.delay(0.2, function() StealBarFill.Size = UDim2.new(0, 0, 1, 0) end)
        end
    end)
end)

