-- Main TP + Block function (SEQUÊNCIA CORRIGIDA)
local function executeTPPlusBlock()
    local character = player.Character
    if not character then 
        print("No character - can't execute")
        return 
    end
    
    print("========== TP + Block EXECUTANDO ==========")
    
    -- ===== STEP 1: BLOQUEIA O JOGADOR MAIS PRÓXIMO =====
    print("Passo 1: Procurando jogador mais próximo para bloquear...")
    local nearestPlayer, distance = getNearestPlayer()
    
    if nearestPlayer then
        print("🎯 Jogador mais próximo: " .. nearestPlayer.Name .. " (Distância: " .. math.floor(distance) .. " studs)")
        print("🚀 Bloqueando " .. nearestPlayer.Name .. " AGORA...")
        blockPlayerComplete(nearestPlayer)
    else
        print("⚠️ Nenhum jogador encontrado por perto para bloquear")
    end
    
    -- ===== STEP 2: Equipar Flying Carpet =====
    print("Passo 2: Equipando Flying Carpet...")
    local carpetEquipped = equipItem("Flying Carpet")
    if not carpetEquipped then
        print("Falha ao equipar Flying Carpet - parando sequência TP")
        print("========== TP + Block COMPLETO (Block feito, TP falhou) ==========")
        return
    end
    
    -- ===== STEP 3: Teleportar para base selecionada =====
    if tpLeftActive then
        print("Passo 3: Base esquerda selecionada - teleportando...")
        teleportCharacter(leftBaseCoords)
        print("Configurando POV na base esquerda...")
        setPOV(leftBaseCoords, LEFT_HORIZONTAL_ANGLE, LEFT_VERTICAL_ANGLE)
        
    elseif tpRightActive then
        print("Passo 3: Base direita selecionada - teleportando...")
        teleportCharacter(rightBaseCoords)
        print("Configurando POV na base direita...")
        setPOV(rightBaseCoords, RIGHT_HORIZONTAL_ANGLE, RIGHT_VERTICAL_ANGLE)
        
    else
        print("Passo 3: Nenhuma base selecionada - pulando teleporte")
    end
    
    task.wait(0.15)
    
    -- ===== STEP 4: Auto Block click se habilitado =====
    if autoBlockEnabled then
        print("Passo 4: Auto Block está habilitado - realizando clique virtual...")
        autoBlockClick()
    else
        print("Passo 4: Auto Block desabilitado - pulando")
    end
    
    task.wait(0.1)
    
    -- ===== STEP 5: Usar Flash Teleport =====
    print("Passo 5: Usando Flash Teleport...")
    local flashSuccess = false
    for i = 1, 3 do
        flashSuccess = useFlashTeleport()
        if flashSuccess then
            print("Flash Teleport processado com sucesso na tentativa " .. i)
            break
        end
        print("Tentando novamente Flash Teleport... Tentativa " .. i + 1)
        task.wait(0.1)
    end
    
    print("========== TP + Block COMPLETO ==========")
end

-- ========== CREATE GREEN CIRCLE TOGGLE FUNCTION ==========
local function createToggle(parent, position, labelText, toggleState, onToggleCallback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(0.9, 0, 0, 24)
    row.Position = position
    row.BackgroundTransparency = 1
    row.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -40, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = row
    
    local labelStroke = Instance.new("UIStroke")
    labelStroke.Color = Color3.new(0, 0, 0)
    labelStroke.Thickness = 1
    labelStroke.Parent = label
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = UDim2.new(1, -20, 0.5, -8)
    circle.BackgroundColor3 = toggleState and Color3.new(0.3, 1, 0.3) or Color3.new(0.4, 0.4, 0.4)
    circle.BackgroundTransparency = 0
    circle.BorderSizePixel = 0
    circle.Parent = row
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle
    
    local clickArea = Instance.new("TextButton")
    clickArea.Size = UDim2.new(1, 0, 1, 0)
    clickArea.Position = UDim2.new(0, 0, 0, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""
    clickArea.Parent = row
    
    local function updateToggle()
        circle.BackgroundColor3 = toggleState and Color3.new(0.3, 1, 0.3) or Color3.new(0.4, 0.4, 0.4)
    end
    
    clickArea.MouseButton1Click:Connect(function()
        toggleState = not toggleState
        updateToggle()
        if onToggleCallback then
            onToggleCallback(toggleState)
        end
    end)
    
    clickArea.MouseEnter:Connect(function()
        label.TextColor3 = Color3.new(0.7, 0.7, 0.7)
    end)
    
    clickArea.MouseLeave:Connect(function()
        label.TextColor3 = Color3.new(1, 1, 1)
    end)
    
    updateToggle()
    
    return {
        row = row,
        label = label,
        circle = circle,
        getState = function() return toggleState end,
        setState = function(state)
            toggleState = state
            updateToggle()
        end
    }
end

