-- =============================================
-- FUNCTIONS
-- =============================================
local function getHRP()
    local char = player.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
end

local function TeleportTo(pos)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if carpet and hum then
        hum:EquipTool(carpet)
        task.wait(0.2)
    end
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        
        -- Alternative activation methods
        for _, child in ipairs(flash:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                pcall(function() child:FireServer() end)
            elseif child:IsA("RemoteFunction") then
                pcall(function() child:InvokeServer() end)
            end
        end
    end
end

-- =============================================
-- EXECUTE TELEPORT
-- =============================================
local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", { Title = "Warning", Text = "Select a teleport first!", Duration = 2 })
        return
    end
    
    local tp = Teleports[selectedTeleport]
    if not tp then return end
    
    print("========== EXECUTING: " .. selectedTeleport .. " ==========")
    
    EquipCarpet()
    task.wait(0.2)
    
    UseFlash()
    task.wait(0.1)
    
    if tp.UseStart then
        print("📍 Going to start point...")
        TeleportTo(StartPoint)
        task.wait(0.15)
    end
    
    print("📍 Teleporting to: " .. selectedTeleport)
    TeleportTo(tp.Pos)
    task.wait(0.15)
    
    print("✅ " .. selectedTeleport .. " completed!")
    
    StarterGui:SetCore("SendNotification", { Title = "Complete", Text = selectedTeleport, Duration = 2 })
end

-- =============================================
-- INSTA RESET (ULTRA FAST)
-- =============================================
local function InstaReset()
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hrp and hum then
        hrp.CFrame = deathCoords
        hum.Health = 0
        if hum.BreakJointsOnDeath then
            hum.BreakJointsOnDeath = true
        end
        hrp.CFrame = deathCoords
        print("⚡ INSTA RESET executed!")
    end
end

-- =============================================
-- AUTO GRAB (ANIMAL STEAL)
-- =============================================
local function scanSinglePlot(plot)
    if not plot or not plot:IsA("Model") then return end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return end
    for _, podium in ipairs(podiums:GetChildren()) do
        if podium:IsA("Model") and podium:FindFirstChild("Base") then
            table.insert(allAnimalsCache, {
                plot = plot.Name,
                slot = podium.Name,
                worldPosition = podium:GetPivot().Position,
                uid = plot.Name .. "_" .. podium.Name,
            })
        end
    end
end

local function initializeScanner()
    task.wait(2)
    local plots = workspace:WaitForChild("Plots", 10)
    if plots then
        for _, plot in ipairs(plots:GetChildren()) do scanSinglePlot(plot) end
        plots.ChildAdded:Connect(scanSinglePlot)
    end
end

local function findPrompt(animal)
    local cached = PromptMemoryCache[animal.uid]
    if cached and cached.Parent then return cached end
    local plots = workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild(animal.plot)
    local podium = plot and plot.AnimalPodiums:FindFirstChild(animal.slot)
    local prompt = podium and podium.Base.Spawn.PromptAttachment:FindFirstChildOfClass("ProximityPrompt")
    if prompt then PromptMemoryCache[animal.uid] = prompt end
    return prompt
end

local function buildStealCallbacks(prompt)
    if InternalStealCache[prompt] then return end
    local data = { holdCallbacks = {}, triggerCallbacks = {}, ready = true }
    local ok1, conns1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if ok1 then for _, c in ipairs(conns1) do table.insert(data.holdCallbacks, c.Function) end end
    local ok2, conns2 = pcall(getconnections, prompt.Triggered)
    if ok2 then for _, c in ipairs(conns2) do table.insert(data.triggerCallbacks, c.Function) end end
    InternalStealCache[prompt] = data
end

local function executeInstantSteal(prompt)
    if (os.clock() - LastGrabTime) < COOLDOWN_TIME then return end
    
    local data = InternalStealCache[prompt]
    if not data or IsStealing then return end
    
    IsStealing = true
    LastGrabTime = os.clock()
    
    task.spawn(function()
        for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
        for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
        task.wait(COOLDOWN_TIME)
        IsStealing = false
    end)
end

local function getNearestAnimal()
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, dist = nil, math.huge
    for _, animal in ipairs(allAnimalsCache) do
        local d = (hrp.Position - animal.worldPosition).Magnitude
        if d < dist and d <= GRAB_RADIUS then
            dist = d
            nearest = animal
        end
    end
    return nearest
end

-- Auto Grab Loop
task.spawn(function()
    initializeScanner()
    while true do
        task.wait(0.1)
        if not IsStealing and (os.clock() - LastGrabTime >= COOLDOWN_TIME) then
            local animal = getNearestAnimal()
            if animal then
                local prompt = findPrompt(animal)
                if prompt then
                    buildStealCallbacks(prompt)
                    executeInstantSteal(prompt)
                end
            end
        end
    end
end)

