local _ob_firing = false
local function _ob_firePrompt(prompt)
    local origDist = prompt.MaxActivationDistance
    local origLOS  = prompt.RequiresLineOfSight
    local origHold = prompt.HoldDuration
    pcall(function() prompt.MaxActivationDistance=100000; prompt.RequiresLineOfSight=false; prompt.HoldDuration=0 end)
    _ob_firing = true
    pcall(function() fireproximityprompt(prompt) end)
    pcall(function() prompt.MaxActivationDistance=origDist; prompt.RequiresLineOfSight=origLOS; prompt.HoldDuration=origHold end)
    task.delay(0.3, function() _ob_firing = false end)
end

local function _ob_triggerByIndex(idx)
    local targetPlot = nil
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return end
    for _,plot in ipairs(plots:GetChildren()) do
        if not isMyBase(plot.Name) then
            targetPlot = plot
            break
        end
    end
    if not targetPlot then return end
    
    local prompts = {}
    for _,obj in ipairs(targetPlot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            table.insert(prompts, obj)
        end
    end
    table.sort(prompts, function(a,b) 
        local y1 = a.Parent and a.Parent.Position.Y or 0
        local y2 = b.Parent and b.Parent.Position.Y or 0
        return y1 < y2
    end)
    if prompts[idx] then _ob_firePrompt(prompts[idx]) end
end

