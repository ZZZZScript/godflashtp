-- Function to create a window with minimize button
local function createWindow(name, title, width, height, x, y, enabled)
    local sg = Instance.new("ScreenGui")
    sg.Name = name
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 50
    sg.Parent = GuiParent
    sg.Enabled = enabled
    
    local mf = Instance.new("Frame")
    mf.Size = UDim2.new(0, width, 0, height)
    mf.Position = UDim2.new(0, x, 0, y)
    mf.BackgroundColor3 = Colors.bg_sidebar
    mf.BackgroundTransparency = 0.1
    mf.BorderSizePixel = 0
    mf.Active = true
    mf.ClipsDescendants = true
    mf.Parent = sg
    mkCorner(mf, 10)
    mkStroke(mf, Colors.accent, 2)
    
    -- Title bar with minimize button
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 24)
    titleBar.BackgroundTransparency = 0.5
    titleBar.BorderSizePixel = 0
    titleBar.Parent = mf
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -50, 1, 0)
    titleLbl.Position = UDim2.new(0, 8, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Colors.text
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 11
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = titleBar
    
    -- MINIMIZE BUTTON
    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.new(0, 22, 0, 18)
    minBtn.Position = UDim2.new(1, -26, 0.5, -9)
    minBtn.BackgroundTransparency = 1
    minBtn.Text = "−"
    minBtn.TextColor3 = Colors.text
    minBtn.TextSize = 14
    minBtn.Font = Enum.Font.GothamBold
    minBtn.BorderSizePixel = 0
    minBtn.Parent = titleBar
    
    local sep = Instance.new("Frame")
    sep.Size = UDim2.new(1, -16, 0, 1)
    sep.Position = UDim2.new(0, 8, 0, 24)
    sep.BackgroundColor3 = Colors.accent
    sep.BackgroundTransparency = 0.6
    sep.BorderSizePixel = 0
    sep.Parent = mf
    
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, 0, 1, -30)
    content.Position = UDim2.new(0, 0, 0, 28)
    content.BackgroundTransparency = 1
    content.Parent = mf
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Parent = content
    
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = content
    
    local minimized = false
    local originalHeight = height
    
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        TweenService:Create(mf, TweenInfo.new(0.18), {
            Size = UDim2.new(0, width, 0, minimized and 24 or originalHeight)
        }):Play()
        minBtn.Text = minimized and "+" or "−"
    end)
    
    -- Dragging
    local dragStart = nil
    local startPos = nil
    local dragging = false
    
    titleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = i.Position
            startPos = mf.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - dragStart
            mf.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return sg, mf, content
end

