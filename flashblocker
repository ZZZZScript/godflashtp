-- FUNCOES
local function getHrp()
    local c = player.Character
    if c then return c:FindFirstChild("HumanoidRootPart") end
    return nil
end

local function equipCarpet()
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c or not b then return end
    for _, t in pairs(c:GetChildren()) do
        if t:IsA("Tool") then t.Parent = b end
    end
    local carp = b:FindFirstChild("Flying Carpet")
    local h = c:FindFirstChildOfClass("Humanoid")
    if carp and h then h:EquipTool(carp) end
    task.wait(0.1)
end

local function useFlash()
    if not flashOn then return end
    local c = player.Character
    local b = player:FindFirstChild("Backpack")
    if not c then return end
    local f = nil
    for _, t in pairs(c:GetChildren()) do
        if t:IsA("Tool") and (t.Name:lower():find("flash") or t.Name:lower():find("flashlight")) then
            f = t
            break
        end
    end
    if not f and b then
        for _, t in pairs(b:GetChildren()) do
            if t:IsA("Tool") and (t.Name:lower():find("flash") or t.Name:lower():find("flashlight")) then
                f = t
                break
            end
        end
    end
    if f then
        if f.Parent == b then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h:EquipTool(f) end
        end
        pcall(function() f:Activate() end)
        task.wait(0.2)
    end
end

local function setCamera(olharTras)
    local h = getHrp()
    local cam = workspace.CurrentCamera
    if h and cam then
        local dir = olharTras and -h.CFrame.LookVector or h.CFrame.LookVector
        cam.CFrame = CFrame.new(h.Position + Vector3.new(0, 2, 0), h.Position + dir + Vector3.new(0, 2, 0))
    end
end

local function teleportar(ponto, olharTras)
    local h = getHrp()
    if not h then return end
    h.CFrame = CFrame.new(ponto)
    h.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    setCamera(olharTras)
    for i = 1, 10 do
        task.wait(0.1)
        setCamera(olharTras)
    end
end

local function executar()
    if not selecionado then
        StarterGui:SetCore("SendNotification", {Title = "Erro", Text = "Selecione um teleport!", Duration = 2})
        return
    end
    equipCarpet()
    task.wait(0.1)
    useFlash()
    teleportar(pos[selecionado], selecionado >= 6)
    StarterGui:SetCore("SendNotification", {Title = "Feito", Text = "TELEPORT " .. selecionado, Duration = 2})
end

-- RESET (MORRE NA HORA)
local function resetar()
    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end
    player:LoadCharacter()
end

-- PREBLOCK
local function preblock()
    local h = getHrp()
    if not h then return end
    local dist = math.huge
    local alvo = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local oh = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if oh then
                local d = (h.Position - oh.Position).Magnitude
                if d < dist then
                    dist = d
                    alvo = p
                end
            end
        end
    end
    if alvo then
        pcall(function() StarterGui:SetCore("PromptBlockPlayer", alvo) end)
    end
end

