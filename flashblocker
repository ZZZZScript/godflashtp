-- 1. ULTRA ANTI-KICK
local function UltraAntiKick()
    pcall(function()
        local ts = TeleportService
        local oldKick = ts.Kick
        ts.Kick = function() return end
        
        local plrs = Players
        plrs.Kick = function() return end
        
        local lp = player
        lp.Kick = function() return end
    end)
    
    -- Hook dangerous remotes
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = string.lower(remote.Name)
            if name:find("kick") or name:find("ban") or name:find("cheat") then
                pcall(function()
                    remote.OnServerEvent:Connect(function()
                        return
                    end)
                end)
            end
        end
    end
end

-- 2. ANTI-RAGDOLL
local function AntiRagdoll()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Physics or 
       state == Enum.HumanoidStateType.Ragdoll or 
       state == Enum.HumanoidStateType.FallingDown then
        hum:ChangeState(Enum.HumanoidStateType.Running)
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BallSocketConstraint") or obj:IsA("HingeConstraint") then
                obj:Destroy()
            end
        end
    end
end

-- 3. ANTI-FREEZE
local lastPos = nil
local freezeCount = 0
local function AntiFreeze()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum then
        if lastPos then
            if (hrp.Position - lastPos).Magnitude < 0.5 then
                freezeCount = freezeCount + 1
                if freezeCount > 10 then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                    freezeCount = 0
                end
            else
                freezeCount = 0
            end
        end
        lastPos = hrp.Position
    end
end

-- 4. ANTI-ANIMATION LOCK
local function AntiAnimationLock()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum:FindFirstChild("Animator") then
        for _, track in pairs(hum.Animator:GetPlayingAnimationTracks()) do
            local name = string.lower(track.Animation and track.Animation.Name or "")
            if name:find("rag") or name:find("fall") or name:find("hurt") then
                track:Stop(0)
            end
        end
    end
end

