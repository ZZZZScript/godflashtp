-- =============================================
-- FUNÇÃO PARA EQUIPAR ITEM
-- =============================================
local function findItem(itemName)
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item.Name == itemName then
                return item
            end
        end
    end
    
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and item.Name == itemName then
                return item
            end
        end
    end
    
    return nil
end

local function equipItem(itemName)
    local item = findItem(itemName)
    if not item then
        print("Item not found: " .. itemName)
        return false
    end
    
    local character = player.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    if item.Parent == player:FindFirstChild("Backpack") then
        humanoid:EquipTool(item)
        print("Equipped: " .. itemName)
        task.wait(0.01)
        return true
    elseif item.Parent == character then
        print("Already equipped: " .. itemName)
        return true
    end
    
    return false
end

-- =============================================
-- FUNÇÃO PARA USAR FLASH TELEPORT
-- =============================================
local function useFlashTeleport()
    local flashItem = findItem("Flash Teleport")
    if not flashItem then
        print("Flash Teleport not found!")
        return false
    end
    
    local character = player.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    print("Using Flash Teleport...")
    
    if flashItem.Parent == player:FindFirstChild("Backpack") then
        humanoid:EquipTool(flashItem)
        task.wait(0.025)
    end
    
    local success = false
    
    pcall(function()
        flashItem:Activate()
        success = true
    end)
    
    task.wait(0.04)
    
    pcall(function()
        local clickDetector = flashItem:FindFirstChildOfClass("ClickDetector")
        if clickDetector then
            clickDetector:MouseClick(player)
            success = true
        end
    end)
    
    for _, child in ipairs(flashItem:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            pcall(function()
                child:FireServer()
                success = true
            end)
        elseif child:IsA("RemoteFunction") then
            pcall(function()
                child:InvokeServer()
                success = true
            end)
        end
    end
    
    return success
end

-- =============================================
-- FUNÇÃO PARA TELEPORTAR SEQUENCIAL
-- =============================================
local function TeleportarSequencial(pontos, usarPartida)
    local character = player.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    -- Equipa Flying Carpet primeiro
    equipItem("Flying Carpet")
    task.wait(0.1)
    
    -- Usa Flash Teleport
    useFlashTeleport()
    task.wait(0.1)
    
    -- Se precisar usar ponto de partida
    if usarPartida then
        print("📍 Indo para ponto de partida...")
        rootPart.CFrame = CFrame.new(PontoPartida)
        rootPart.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.15)
    end
    
    -- Teleporta por todos os pontos
    for i, ponto in ipairs(pontos) do
        rootPart.CFrame = CFrame.new(ponto)
        rootPart.AssemblyLinearVelocity = Vector3.zero
        print("📍 Ponto " .. i .. "/" .. #pontos)
        task.wait(0.15)
    end
    
    print("✅ Teleport concluído!")
    return true
end

-- =============================================
-- FUNÇÃO PARA BLOQUEAR PLAYER
-- =============================================
local function getNearestPlayer()
    local character = player.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local nearestPlayer = nil
    local shortestDistance = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherChar = plr.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local distance = (rootPart.Position - otherRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestPlayer = plr
                    end
                end
            end
        end
    end
    
    return nearestPlayer, shortestDistance
end

local function blockPlayerInstant(plr)
    if not plr or plr == player then return end
    pcall(function()
        StarterGui:SetCore("PromptBlockPlayer", plr)
    end)
    print("✅ Blocked: " .. plr.Name)
end

local function autoBlockClick()
    VirtualInputManager:SendMouseButtonEvent(963, 516, 0, true, game, 1)
