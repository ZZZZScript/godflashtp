-- Steal
ProximityPromptService.PromptButtonHoldBegan:Connect(function(p)
    if not flashOn then return end
    local start = os.clock()
    local fired = false
    StealBarFill.Size = UDim2.new(0,0,1,0)
    local conn = RunService.PreRender:Connect(function()
        if not p or not p.Parent then conn:Disconnect() return end
        local prog = math.clamp((os.clock() - start) / p.HoldDuration, 0, 1)
        StealBarFill.Size = UDim2.new(prog,0,1,0)
        if not fired and prog >= 0.95 then
            fired = true
            conn:Disconnect()
            local t = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if t then t:Activate() end
            StealBarFill.Size = UDim2.new(1,0,1,0)
            task.delay(0.2, function() StealBarFill.Size = UDim2.new(0,0,1,0) end)
        end
    end)
end)

