UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return
    
    if input.KeyCode == Enum.KeyCode.F then
        ExecuteTeleport()
    elseif input.KeyCode == Enum.KeyCode.R then
        Reset()
    end
end)

