-- =============================================
-- EXECUTAR TELEPORT + BLOCK
-- =============================================
local function executeTeleport()
    local character = player.Character
    if not character then return end
    
    print("========== EXECUTANDO TELEPORT ==========")
    
    -- Step 1: Block nearest player (se auto block ligado)
    if autoBlockEnabled then
        local nearest = getNearestPlayer()
        if nearest then
            blockPlayerInstant(nearest)
        end
        task.wait(0.1)
        autoBlockClick()
    end
    
    -- Step 2: Executa o teleport selecionado
    if teleport1Active then
        print("▶️ Executando TELEPORT 1...")
        TeleportarSequencial(Teleport1Points, false)
    elseif teleport2Active then
        print("▶️ Executando TELEPORT 2...")
        TeleportarSequencial(Teleport2Points, true)
    else
        print("⚠️ Nenhum teleport selecionado!")
    end
    
    print("========== TELEPORT CONCLUÍDO ==========")
end

