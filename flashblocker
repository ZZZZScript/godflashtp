-- FUNÇÕES
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getCharacterDirection()
    local hrp = getHRP()
    if not hrp then return "---"
    local look = hrp.CFrame.LookVector
    if math.abs(look.X) > math.abs(look.Z) then
        if look.X > 0 then return "DIREITA"
        else return "ESQUERDA" end
    else
        if look.Z > 0 then return "FRENTE"
        else return "TRÁS" end
    end
end

local function RotateCharacter(angle)
    local hrp = getHRP()
    if not hrp then return end
    local oldPos = hrp.Position
    local newCFrame = CFrame.new(oldPos) * CFrame.Angles(0, math.rad(angle), 0)
    hrp.CFrame = newCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
end

local function SetCharacterDirection(direction)
    local hrp = getHRP()
    if not hrp then return end
    local currentRot = hrp.CFrame - hrp.Position
    local currentAngle = math.atan2(currentRot.LookVector.X, currentRot.LookVector.Z)
    
    local targetAngle
    if direction == "front" then
        targetAngle = 0
    elseif direction == "back" then
        targetAngle = math.pi
    elseif direction == "left" then
        targetAngle = math.pi / 2
    elseif direction == "right" then
        targetAngle = -math.pi / 2
    end
    
    local newAngle = targetAngle - currentAngle
    hrp.CFrame = hrp.CFrame * CFrame.Angles(0, newAngle, 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
end

-- Atualizar display
local function UpdateDisplay()
    DirLabel.Text = "Looking: " .. getCharacterDirection()
end

