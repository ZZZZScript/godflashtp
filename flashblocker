-- AUTO GRAB FUNCTIONS
local function getHRP()
    local char = player.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
end

local function scanSinglePlot(plot)
    if not plot or not plot:IsA("Model") then return end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return end
    for _, podium in ipairs(podiums:GetChildren()) do
        if podium:IsA("Model") and podium:FindFirstChild("Base") then
            table.insert(allAnimalsCache, {
                plot = plot.Name,
                slot = podium.Name,
                worldPosition = podium:GetPivot().Position,
                uid = plot.Name .. "_" .. podium.Name,
            })
        end
    end
end

local function initializeScanner()
    task.wait(2)
    local plots = workspace:WaitForChild("Plots", 10)
    for _, plot in ipairs(plots:GetChildren()) do scanSinglePlot(plot) end
    plots.ChildAdded:Connect(scanSinglePlot)
end

local function findPrompt(animal)
    local cached = PromptMemoryCache[animal.uid]
    if cached and cached.Parent then return cached end
    local plot = workspace.Plots:FindFirstChild(animal.plot)
    local podium = plot and plot.AnimalPodiums:FindFirstChild(animal.slot)
    local prompt = podium and podium.Base.Spawn.PromptAttachment:FindFirstChildOfClass("ProximityPrompt")
    if prompt then PromptMemoryCache[animal.uid] = prompt end
    return prompt
end

local function buildStealCallbacks(prompt)
    if InternalStealCache[prompt] then return end
    local data = { holdCallbacks = {}, triggerCallbacks = {}, ready = true }
    local ok1, conns1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if ok1 then for _, c in ipairs(conns1) do table.insert(data.holdCallbacks, c.Function) end end
    local ok2, conns2 = pcall(getconnections, prompt.Triggered)
    if ok2 then for _, c in ipairs(conns2) do table.insert(data.triggerCallbacks, c.Function) end end
    InternalStealCache[prompt] = data
end

local function executeInstantSteal(prompt)
    if (os.clock() - LastGrabTime) < COOLDOWN_TIME then return end
    
    local data = InternalStealCache[prompt]
    if not data or IsStealing then return end
    
    IsStealing = true
    LastGrabTime = os.clock()
    
    task.spawn(function()
        for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
        for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
        
        print("Auto Grab: Grabbed animal")
        task.wait(COOLDOWN_TIME)
        IsStealing = false
    end)
end

local function getNearestAnimal()
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, dist = nil, math.huge
    for _, animal in ipairs(allAnimalsCache) do
        local d = (hrp.Position - animal.worldPosition).Magnitude
        if d < dist and d <= GRAB_RADIUS then
            dist = d
            nearest = animal
        end
    end
    return nearest
end

-- AUTO GRAB LOOP (ALWAYS ON)
task.spawn(function()
    initializeScanner()
    while true do
        task.wait(0.1)
        if not IsStealing and (os.clock() - LastGrabTime >= COOLDOWN_TIME) then
            local animal = getNearestAnimal()
            if animal then
                local prompt = findPrompt(animal)
                if prompt then
                    buildStealCallbacks(prompt)
                    executeInstantSteal(prompt)
                end
            end
        end
    end
end)

-- Function to set both character AND camera
local function setPOV(targetCoords, horizontalAngleRadians, verticalAngleRadians)
    local character = player.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local targetCFrame = CFrame.new(targetCoords) * CFrame.Angles(verticalAngleRadians, horizontalAngleRadians, 0)
    humanoidRootPart.CFrame = targetCFrame
    
    local camera = workspace.CurrentCamera
    if camera then
        camera.CFrame = targetCFrame
    end
    
    print("POV set - Horizontal: " .. horizontalAngleRadians .. " rad, Vertical: " .. verticalAngleRadians .. " rad")
    task.wait(0.06)
end

-- Function to find item
local function findItem(itemName)
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item.Name == itemName then
                return item
            end
        end
    end
    
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and item.Name == itemName then
                return item
            end
        end
    end
    
    return nil
end

-- Function to EQUIP item
local function equipItem(itemName)
    local item = findItem(itemName)
    if not item then
        print("Item not found: " .. itemName)
        return false
    end
    
    local character = player.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    if item.Parent == player:FindFirstChild("Backpack") then
        humanoid:EquipTool(item)
        print("Equipped: " .. itemName)
        task.wait(0.01)
        return true
    elseif item.Parent == character then
        print("Already equipped: " .. itemName)
        return true
    end
    
    return false
end

-- Function to USE Flash Teleport
local function useFlashTeleport()
    local flashItem = findItem("Flash Teleport")
    if not flashItem then
        print("Flash Teleport not found in inventory!")
        return false
    end
    
    local character = player.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    print("Found Flash Teleport, attempting to use...")
    
    if flashItem.Parent == player:FindFirstChild("Backpack") then
        humanoid:EquipTool(flashItem)
        task.wait(0.025)
    end
    
    local success = false
    
    pcall(function()
        flashItem:Activate()
        success = true
        print("Method 1: Activate() called")
    end)
    
    task.wait(0.04)
    
    pcall(function()
        local clickDetector = flashItem:FindFirstChildOfClass("ClickDetector")
        if clickDetector then
            clickDetector:MouseClick(player)
            success = true
            print("Method 2: ClickDetector used")
        end
    end)
    
    for _, child in ipairs(flashItem:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            pcall(function()
                child:FireServer()
                success = true
                print("Method 3: RemoteEvent fired: " .. child.Name)
            end)
        elseif child:IsA("RemoteFunction") then
            pcall(function()
                child:InvokeServer()
                success = true
                print("Method 3: RemoteFunction invoked: " .. child.Name)
            end)
        end
    end
    
    if success then
        print("Flash Teleport activated successfully!")
    else
        print("Warning: Could not confirm Flash Teleport activation")
    end
    
    return true
end

