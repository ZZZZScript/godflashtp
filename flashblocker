-- Funções
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getCameraDirection()
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if not hrp or not cam then return "---"
    
    local camLook = cam.CFrame.LookVector
    local charLook = hrp.CFrame.LookVector
    
    local dotForward = camLook:Dot(charLook)
    local dotRight = camLook:Dot(hrp.CFrame.RightVector)
    
    if dotForward > 0.7 then
        return "FRENTE"
    elseif dotForward < -0.7 then
        return "TRÁS"
    elseif dotRight > 0.7 then
        return "DIREITA"
    elseif dotRight < -0.7 then
        return "ESQUERDA"
    else
        return "DIAGONAL"
    end
end

local function SetCamera(direction)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if not hrp or not cam then return end
    
    local lookDir
    if direction == "front" then
        lookDir = hrp.CFrame.LookVector
    elseif direction == "back" then
        lookDir = -hrp.CFrame.LookVector
    elseif direction == "left" then
        lookDir = -hrp.CFrame.RightVector
    elseif direction == "right" then
        lookDir = hrp.CFrame.RightVector
    end
    
    cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + lookDir + Vector3.new(0, 2, 0))
end

local function ForceCamera(direction)
    SetCamera(direction)
    for i = 1, 10 do
        task.wait(0.1)
        SetCamera(direction)
    end
end

-- Atualizar display
local function UpdateDisplay()
    local hrp = getHRP()
    if hrp then
        local look = hrp.CFrame.LookVector
        LookLabel.Text = string.format("LookVector: (%.2f, %.2f, %.2f)", look.X, look.Y, look.Z)
    end
    DirLabel.Text = "Current: " .. getCameraDirection()
end

