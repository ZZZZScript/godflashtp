-- =============================================
-- EQUIP CARPET
-- =============================================
local function EquipCarpet()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and Humanoid then
        Humanoid:EquipTool(carpet)
        task.wait(0.2)
    end
end

-- =============================================
-- USE FLASH
-- =============================================
local function UseFlash()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            flash.Parent = char
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
    end
end

-- =============================================
-- TELEPORT FUNCTION
-- =============================================
local function TeleportTo(position)
    if RootPart then
        RootPart.CFrame = CFrame.new(position)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

-- =============================================
-- EXECUTE TELEPORT
-- =============================================
local function ExecuteTeleport()
    if not selectedTeleport then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "⚠️ Warning!";
            Text = "Select a TELEPORT first!";
            Duration = 2;
        })
        return
    end
    
    local tp = Teleports[selectedTeleport]
    if not tp then return end
    
    print("========== EXECUTING: " .. selectedTeleport .. " ==========")
    
    -- Equip Carpet
    EquipCarpet()
    task.wait(0.2)
    
    -- Use Flash
    UseFlash()
    task.wait(0.1)
    
    -- If needs start point (Teleport 6 to 10)
    if tp.UseStartPoint then
        print("📍 Going to start point...")
        TeleportTo(StartPoint)
        task.wait(0.15)
    end
    
    -- Teleport to final position
    print("📍 Teleporting to: " .. selectedTeleport)
    TeleportTo(tp.Position)
    task.wait(0.15)
    
    print("✅ " .. selectedTeleport .. " completed!")
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "✅ Teleport Complete!";
        Text = selectedTeleport;
        Duration = 2;
    })
end

