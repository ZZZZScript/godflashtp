-- FUNCTIONS
-- =============================================
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then
        hum:EquipTool(carpet)
        task.wait(0.15)
    end
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return end
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash) end
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
    end
end

local function TeleportTo(pos)
    local hrp = getHRP()
    if not hrp then return end
    
    hrp.CFrame = CFrame.new(pos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    
    -- Vira a câmera
    local cam = workspace.CurrentCamera
    if cam and hrp then
        local lookDir = hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + lookDir + Vector3.new(0, 2, 0))
    end
end

local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Warning", Text = "Select a teleport first!", Duration = 2})
        return
    end
    
    if teleporting then return end
    teleporting = true
    
    local tp = TeleportPoints[selectedTeleport]
    if not tp then teleporting = false return end
    
    EquipCarpet()
    task.wait(0.15)
    
    if flashEnabled then
        UseFlash()
        task.wait(0.1)
    end
    
    if tp.pts then
        for _, point in ipairs(tp.pts) do
            TeleportTo(point)
            task.wait(0.12)
        end
    else
        if tp.useStart then
            TeleportTo(StartPoint)
            task.wait(0.12)
        end
        TeleportTo(tp.pos)
        task.wait(0.12)
    end
    
    teleporting = false
    StarterGui:SetCore("SendNotification", {Title = "Complete", Text = tp.name, Duration = 2})
end

