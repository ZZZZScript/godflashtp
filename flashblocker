-- Scroll tracking
RunService.Heartbeat:Connect(function()
    if not MainFrame or not MainFrame.Parent then return end
    local scrollY = MainFrame.CanvasPosition.Y
    local absY = MainFrame.AbsolutePosition.Y
    local maxS2 = math.max(0, MainFrame.AbsoluteCanvasSize.Y - MainFrame.AbsoluteSize.Y)
    local best = nil
    if maxS2 > 0 and scrollY >= maxS2 - 1 then best = "Shortcuts"
    else
        local bestDist = math.huge
        for name, anchor in pairs(anchorFrames) do
            if anchor and anchor.Parent then
                local anchorRelY = anchor.AbsolutePosition.Y - absY + scrollY
                local dist = scrollY - anchorRelY
                if dist >= -10 and dist < bestDist then bestDist = dist; best = name end
            end
        end
    end
    if best and best ~= activeNav then
        activeNav = best
        for _, nb in pairs(navBtns) do nb.abar.Visible = false; nb.tl.TextColor3 = Colors.sub end
        if navBtns[best] then navBtns[best].abar.Visible = true; navBtns[best].tl.TextColor3 = Color3.new(1,1,1) end
    end
end)

