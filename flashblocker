local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then tool.Parent = bp
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then hum:EquipTool(carpet)
    task.wait(0.1)
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash)
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.15)
    end
end

local function ForcarCamera(olharParaTras)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if hrp and cam then
        local direcao = olharParaTras and -hrp.CFrame.LookVector or hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + direcao + Vector3.new(0, 2, 0))
    end
end

local function Teleportar(pos, olharParaTras)
    local hrp = getHRP()
    if not hrp then return
    hrp.CFrame = CFrame.new(pos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    ForcarCamera(olharParaTras)
    for i = 1, 10 do
        task.wait(0.1)
        ForcarCamera(olharParaTras)
    end
end

local function ExecutarTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Aviso", Text = "Selecione um teleport!", Duration = 2})
        return
    end
    if teleporting then return
    teleporting = true
    EquipCarpet()
    task.wait(0.1)
    if flashEnabled then UseFlash() end
    local olharParaTras = selectedTeleport >= 6
    local pos = nil
    if selectedTeleport == 1 then pos = Teleport1Pos
    elseif selectedTeleport == 2 then pos = Teleport2Pos
    elseif selectedTeleport == 3 then pos = Teleport3Pos
    elseif selectedTeleport == 4 then pos = Teleport4Pos
    elseif selectedTeleport == 5 then pos = Teleport5Pos
    elseif selectedTeleport == 6 then pos = Teleport6Pos
    elseif selectedTeleport == 7 then pos = Teleport7Pos
    elseif selectedTeleport == 8 then pos = Teleport8Pos
    elseif selectedTeleport == 9 then pos = Teleport9Pos
    elseif selectedTeleport == 10 then pos = Teleport10Pos
    end
    if pos then Teleportar(pos, olharParaTras) end
    teleporting = false
    StarterGui:SetCore("SendNotification", {Title = "Completo", Text = "TELEPORT " .. selectedTeleport, Duration = 2})
end

local function InstaReset()
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0
    end
    player:LoadCharacter()
end
local function GetNearestPlayer()
    local char = player.Character
    if not char then return nil
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil
    local nearest = nil
    local shortest = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local dist = (hrp.Position - otherHrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

local function DoPreBlock()
    local nearest = GetNearestPlayer()
    if nearest then
        pcall(function() StarterGui:SetCore("PromptBlockPlayer", nearest) end)
    end
