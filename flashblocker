local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then tool.Parent = bp
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then hum:EquipTool(carpet)
    task.wait(0.1)
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash)
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.15)
    end
end

local function ForcarCamera(olharParaTras)
    local hrp = getHRP()
    local cam = workspace.CurrentCamera
    if hrp and cam then
        local direcao = olharParaTras and -hrp.CFrame.LookVector or hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + direcao + Vector3.new(0, 2, 0))
    end
end

local function Teleportar(pos, olharParaTras)
    local hrp = getHRP()
    if not hrp then return
    hrp.CFrame = CFrame.new(pos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    ForcarCamera(olharParaTras)
    for i = 1, 10 do
        task.wait(0.1)
        ForcarCamera(olharParaTras)
    end
end

local function ExecutarTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Aviso", Text = "Selecione um teleport!", Duration = 2})
        return
    end
    if teleporting then return
    teleporting = true
    EquipCarpet()
    task.wait(0.1)
    if flashEnabled then UseFlash() end
    local olharParaTras = selectedTeleport >= 6
    if selectedTeleport == 1 then
        Teleportar(Teleport1Pos, olharParaTras)
    elseif selectedTeleport == 2 then
        Teleportar(Teleport2Pos, olharParaTras)
    elseif selectedTeleport == 3 then
        Teleportar(Teleport3Pos, olharParaTras)
    elseif selectedTeleport == 4 then
        Teleportar(Teleport4Pos, olharParaTras)
    elseif selectedTeleport == 5 then
        Teleportar(Teleport5Pos, olharParaTras)
    elseif selectedTeleport == 6 then
        Teleportar(Teleport6Pos, olharParaTras)
    elseif selectedTeleport == 7 then
        Teleportar(Teleport7Pos, olharParaTras)
    elseif selectedTeleport == 8 then
        Teleportar(Teleport8Pos, olharParaTras)
    elseif selectedTeleport == 9 then
        Teleportar(Teleport9Pos, olharParaTras)
    elseif selectedTeleport == 10 then
        Teleportar(Teleport10Pos, olharParaTras)
    end
    teleporting = false
    StarterGui:SetCore("SendNotification", {Title = "Completo", Text = "TELEPORT " .. selectedTeleport, Duration = 2})
end

local deathCoords = CFrame.new(1000003.56, 999999.69, 8.17)
local resetCooldown = false

local function equipCarpetReset()
    local char = player.Character
    if not char then return
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("carpet") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum:EquipTool(tool) end
                return
            end
        end
    end
end

local function InstaReset()
    if resetCooldown then return end
    resetCooldown = true
    local char = player.Character
    if not char then 
        player:LoadCharacter()
        resetCooldown = false
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then 
        resetCooldown = false
        return 
    end
    equipCarpetReset()
    task.wait()
    hrp.CFrame = deathCoords
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char or not char.Parent then 
            conn:Disconnect() 
            return 
        end
        local h = char:FindFirstChildOfClass("Humanoid")
        local r = char:FindFirstChild("HumanoidRootPart")
        if not h or not r then 
            conn:Disconnect() 
            return 
        end
        if h.Health <= 0 then 
            conn:Disconnect() 
            return 
        end
        r.CFrame = deathCoords
    end)
    task.wait(0.5)
    resetCooldown = false
end

local function GetNearestPlayer()
    local char = player.Character
    if not char then return nil
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil
    local nearest = nil
    local shortest = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local dist = (hrp.Position - otherHrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

local function BlockPlayer(plr)
    if not plr or plr == player then return
    pcall(function() StarterGui:SetCore("PromptBlockPlayer", plr) end)
end

local function DoPreBlock()
    local nearest = GetNearestPlayer()
    if nearest then
        BlockPlayer(nearest)
    end
end

