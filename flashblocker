-- FUNCOES
local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function EquipCarpet()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char or not bp then return
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then tool.Parent = bp
    end
    
    local carpet = bp:FindFirstChild("Flying Carpet")
    local hum = getHum()
    if carpet and hum then hum:EquipTool(carpet)
    task.wait(0.1)
end

local function UseFlash()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    if not char then return
    
    local flash = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
            flash = tool
            break
        end
    end
    
    if not flash and bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("flash") or tool.Name:lower():find("flashlight")) then
                flash = tool
                break
            end
        end
    end
    
    if flash then
        if flash.Parent == bp then
            local hum = getHum()
            if hum then hum:EquipTool(flash)
            task.wait(0.1)
        end
        pcall(function() flash:Activate() end)
        task.wait(0.15)
    end
end

local function TeleportTo(pos, isBack)
    local hrp = getHRP()
    if not hrp then return
    
    hrp.CFrame = CFrame.new(pos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    
    -- FORCA CAMERA
    local cam = workspace.CurrentCamera
    if cam and hrp then
        local look = isBack and -hrp.CFrame.LookVector or hrp.CFrame.LookVector
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 2, 0), hrp.Position + look + Vector3.new(0, 2, 0))
    end
end

local function ExecuteTeleport()
    if not selectedTeleport then
        StarterGui:SetCore("SendNotification", {Title = "Warning", Text = "Select a teleport!", Duration = 2})
        return
    end
    
    EquipCarpet()
    task.wait(0.1)
    if flashEnabled then UseFlash() end
    
    local isBack = selectedTeleport >= 6
    TeleportTo(Teleports[selectedTeleport], isBack)
    
    StarterGui:SetCore("SendNotification", {Title = "Complete", Text = "TELEPORT " .. selectedTeleport, Duration = 2})
end

-- RESET (MATA E RENASCE)
local function InstaReset()
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0
    end
    player:LoadCharacter()
end

-- PREBLOCK
local function DoPreBlock()
    local char = player.Character
    if not char then return
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return
    
    local nearest = nil
    local shortest = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local otherHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local dist = (hrp.Position - otherHrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = plr
                end
            end
        end
    end
    
    if nearest then
        pcall(function() StarterGui:SetCore("PromptBlockPlayer", nearest) end)
    end
end

