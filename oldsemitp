    end
    
    addToggle("INSTANT STEAL", "Click Teleport to go", "autoSteal", function(on)
        showSteal(on)
    end)
    
    addToggle("AUTO GRAB", "Auto steals (0.15s)", "autoGrab", nil)
    
    addToggle("ACTIVE POTION", "Potion when get Brainrot", "autoPotion", nil)
    
    addToggle("UNLOCK BASE", "Unlock other base", "unlockBase", function(on)
        showUnlock(on)
    end)
    
    addToggle("STEAL SPEED", "Increase speed", "speedBoost", function(on)
        if on then startSpeed() else stopSpeed() end
    end)
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)
    
    -- Footer
    local footer = Instance.new("TextLabel", f)
    footer.Size = UDim2.new(1, 0, 0, 20)
    footer.Position = UDim2.new(0, 0, 1, -22)
    footer.BackgroundTransparency = 1
    footer.Text = "LAW HUB"
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 8
    footer.TextColor3 = C.textDim
    
    -- Minimizar
    minBtn.MouseButton1Click:Connect(function()
        menuMinimized = not menuMinimized
        f.Size = menuMinimized and UDim2.new(0, 230, 0, 40) or UDim2.new(0, 230, 0, 370)
        scroll.Visible = not menuMinimized
        line.Visible = not menuMinimized
        footer.Visible = not menuMinimized
        minBtn.Text = menuMinimized and "+" or "−"
    end)
    
    -- Drag
    local dragging = false
    local dragStart = nil
    local frameStart = nil
    
    hdr.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            frameStart = f.Position
        end
    end)
    
    hdr.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            f.Position = UDim2.new(
                frameStart.X.Scale,
                frameStart.X.Offset + delta.X,
                frameStart.Y.Scale,
                frameStart.Y.Offset + delta.Y
            )
        end
    end)
    
    mainFrame = sg
end

