-- Atualizar posição
local function AtualizarPosicao()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local pos = char.HumanoidRootPart.Position
        local x = math.floor(pos.X * 10) / 10
        local y = math.floor(pos.Y * 10) / 10
        local z = math.floor(pos.Z * 10) / 10
        
        LabelX.Text = "X: " .. x
        LabelY.Text = "Y: " .. y
        LabelZ.Text = "Z: " .. z
        LabelVector.Text = "Vector3.new(" .. x .. ", " .. y .. ", " .. z .. ")"
        
        return x, y, z
    end
end

-- Copiar posição
CopyBtn.MouseButton1Click:Connect(function()
    local text = LabelVector.Text
    if text and text ~= "Vector3.new(---)" then
        setclipboard(text)
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "✅ Copiado!";
            Text = text;
            Duration = 2;
        })
    end
end)

-- Atualizar a cada 0.1 segundos
task.spawn(function()
    while true do
        AtualizarPosicao()
        task.wait(0.1)
    end
end)

