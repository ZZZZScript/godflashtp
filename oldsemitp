local function SaveConfig()
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            toggles = Toggles,
            speed = currentSpeed,
            keybind = currentKeybind.Name,
            potion_teleport = PotionOnTeleport,
        }))
    end)
end

local function LoadConfig()
    pcall(function()
        if isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            if data then
                Toggles.instant_steal = data.toggles.instant_steal or false
                Toggles.auto_grab = data.toggles.auto_grab or false
                Toggles.active_potion = data.toggles.active_potion or false
                Toggles.unlock_base = data.toggles.unlock_base or false
                Toggles.steal_speed = data.toggles.steal_speed or false
                currentSpeed = data.speed or 28
                currentKeybind = Enum.KeyCode[data.keybind] or Enum.KeyCode.R
                PotionOnTeleport = data.potion_teleport or false
                StealSpeedActive = Toggles.steal_speed
            end
        end
    end)
end

