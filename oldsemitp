            row.Parent = scroll
            row.BackgroundTransparency = 1
            row.Size = UDim2.new(1, 0, 0, 50)
            
            local label = Instance.new("TextLabel", row)
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.Font = Enum.Font.GothamBold
            label.Text = name
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextSize = 15
            label.TextXAlignment = Enum.TextXAlignment.Left
            
            local toggleBtn = Instance.new("TextButton", row)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            toggleBtn.Position = UDim2.new(0.55, 0, 0.2, 0)
            toggleBtn.Size = UDim2.new(0, 50, 0, 26)
            toggleBtn.Text = ""
            MakeCorner(toggleBtn, 13)
            
            local circle = Instance.new("Frame", toggleBtn)
            circle.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            circle.Position = UDim2.new(0, 3, 0.5, -10)
            circle.Size = UDim2.new(0, 20, 0, 20)
            MakeCorner(circle, 10)
            
            local function UpdateCircle(state)
                local targetPos = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
                TweenService:Create(circle, TweenInfo.new(0.2), {Position = targetPos}):Play()
            end
            
            toggleBtn.MouseButton1Click:Connect(function()
                if varName == "instantSteal" then
                    instantSteal = not instantSteal
                    UpdateCircle(instantSteal)
                    if instantSteal then
                        CreateStealPanel()
                    else
                        if stealPanel then stealPanel:Destroy(); stealPanel = nil end
                        StopSpeed()
                    end
                elseif varName == "autoGrab" then
                    autoGrab = not autoGrab
                    UpdateCircle(autoGrab)
                elseif varName == "activePotion" then
                    activePotion = not activePotion
                    UpdateCircle(activePotion)
                elseif varName == "unlockBase" then
                    unlockBase = not unlockBase
                    UpdateCircle(unlockBase)
                    if unlockBase then
                        CreateUnlockPanel()
                    else
                        if unlockPanel then unlockPanel:Destroy(); unlockPanel = nil end
                    end
                elseif varName == "stealSpeed" then
                    stealSpeed = not stealSpeed
                    UpdateCircle(stealSpeed)
                    if stealSpeed then
                        StartSpeed()
                    else
                        StopSpeed()
                    end
                end
            end)
            
            if hasInput then
                local input = Instance.new("TextBox", row)
                input.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                input.Position = UDim2.new(0.78, 0, 0.15, 0)
                input.Size = UDim2.new(0, 60, 0, 30)
                input.Font = Enum.Font.GothamBold
                input.Text = tostring(defaultValue)
                input.TextColor3 = Color3.fromRGB(255, 255, 255)
                input.TextSize = 14
                MakeCorner(input, 6)
                
                input.FocusLost:Connect(function()
                    local val = tonumber(input.Text)
                    if val then
                        currentSpeed = math.clamp(val, 26, 36)
                        input.Text = tostring(currentSpeed)
                    else
                        input.Text = tostring(currentSpeed)
                    end
                end)
            end
        end
        
        AddToggle("Instant Steal", "instantSteal", false, nil)
        AddToggle("Auto Grab", "autoGrab", false, nil)
        AddToggle("Active Potion", "activePotion", false, nil)
        AddToggle("Unlock Base", "unlockBase", false, nil)
