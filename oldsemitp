-- =============================================
-- TELEPORT (SÓ QUANDO CLICA)
-- =============================================
local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled then
            return plot
        end
    end
    return nil
end

local function TeleportTo(pos)
    if RootPart then
        RootPart.CFrame = CFrame.new(pos)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

local function EquipCarpet()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = bp
        end
    end
    local carpet = bp:FindFirstChild("Flying Carpet")
    if carpet and Humanoid then
        Humanoid:EquipTool(carpet)
    end
end

local function DoTeleport()
    if teleporting then return end
    teleporting = true
    print("[TELEPORT] Iniciando...")
    
    if PotionOnTeleport then
        UseGiantPotion()
    end
    
    local myPlot = GetMyPlot()
    if not myPlot then
        teleporting = false
        return
    end
    
    EquipCarpet()
    task.wait(0.1)
    
    local order = myPlot:GetAttribute("Order")
    if order == 2 then
        TeleportTo(Vector3.new(-368, -7, 69))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 100))
        task.wait(0.1)
        TeleportTo(Vector3.new(-352, -7, 76))
    else
        TeleportTo(Vector3.new(-368, -7, 42))
        task.wait(0.1)
        TeleportTo(Vector3.new(-336, -5, 20))
        task.wait(0.1)
        TeleportTo(Vector3.new(-353, -7, 44))
    end
    
    task.wait(0.2)
    print("[TELEPORT] Concluído!")
    task.wait(0.3)
    teleporting = false
end

-- =============================================
-- AUTO GRAB (CORRIGIDO)
-- =============================================
local function FindStealPrompt()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local nearest, minDist = nil, math.huge
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end

    for _, desc in pairs(plots:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled and desc.ActionText == "Steal" then
            local part = desc.Parent
            local pos = nil
            if part:IsA("BasePart") then
                pos = part.Position
            elseif part:IsA("Model") and part.PrimaryPart then
                pos = part.PrimaryPart.Position
            end
            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = desc
                end
            end
        end
    end
    return nearest
end

local function TriggerSteal(prompt)
    if not prompt or not prompt:IsDescendantOf(workspace) then return
    prompt.MaxActivationDistance = 9e9
    prompt.RequiresLineOfSight = false
    prompt.ClickablePrompt = true

    pcall(function()
        fireproximityprompt(prompt, 9e9, 0.3)
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end)
end

-- Loop do Auto Grab
task.spawn(function()
    while true do
        if Toggles.auto_grab then
            local prompt = FindStealPrompt()
            if prompt then
                TriggerSteal(prompt)
            end
        end
        task.wait(0.1)
    end
end)

-- =============================================
-- ACTIVE POTION (SÓ QUANDO PEGA BRAINROT)
-- =============================================
local StealKeywords = {"steal", "stole", "roubou", "pegou", "robou", "furtou", "you stole", "você roubou", "vc roubou", "ac steal"}

local function CheckForSteal(text)
    if not Toggles.active_potion then return
    if type(text) ~= "string" then return
    
    local lowerText = string.lower(text)
    for _, keyword in ipairs(StealKeywords) do
        if string.find(lowerText, keyword) then
            UseGiantPotion()
            print("[ACTIVE POTION] Poção ativada!")
            break
        end
    end
end

local function StartPotionWatcher()
    if PotionWatcher then PotionWatcher:Disconnect() end
    
    local gui = LocalPlayer:WaitForChild("PlayerGui")
    
    local function Scan(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            CheckForSteal(obj.Text)
            obj:GetPropertyChangedSignal("Text"):Connect(function()
                if Toggles.active_potion then
                    CheckForSteal(obj.Text)
                end
            end)
        end
    end
    
    for _, obj in pairs(gui:GetDescendants()) do
        Scan(obj)
    end
    
    PotionWatcher = gui.DescendantAdded:Connect(Scan)
    print("[ACTIVE POTION] Monitorando...")
end

local function StopPotionWatcher()
    if PotionWatcher then
        PotionWatcher:Disconnect()
        PotionWatcher = nil
    end
end

-- =============================================
-- STEAL SPEED
-- =============================================
local function StartStealSpeed()
    if SpeedThread then SpeedThread:Disconnect() end
    
    SpeedThread = RunService.Heartbeat:Connect(function()
        if StealSpeedActive and Toggles.instant_steal then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum then
                    hum.WalkSpeed = currentSpeed
                    local moveDir = hum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        hrp.AssemblyLinearVelocity = Vector3.new(
                            moveDir.X * currentSpeed,
                            hrp.AssemblyLinearVelocity.Y,
                            moveDir.Z * currentSpeed
                        )
                    end
                end
            end
        end
    end)
    print("[STEAL SPEED] Ativado - Velocidade: " .. currentSpeed)
end

local function StopStealSpeed()
    if SpeedThread then
        SpeedThread:Disconnect()
        SpeedThread = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
        end
    end
    print("[STEAL SPEED] Desativado")
end

