-- ABSOLUTELY MINIMUM - COPY THIS EXACTLY
spawn(function()
    wait(5)
    
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "LawHub"
    ScreenGui.Parent = PlayerGui
    
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 300, 0, 400)
    Frame.Position = UDim2.new(0.5, -150, 0.5, -200)
    Frame.BackgroundColor3 = Color3.fromRGB(45, 65, 80)
    Frame.BackgroundTransparency = 0.1
    Frame.Parent = ScreenGui
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 15)
    UICorner.Parent = Frame
    
    local Title = Instance.new("TextLabel")
    Title.Parent = Frame
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 0, 0, 15)
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.Font = Enum.Font.GothamBold
    Title.Text = "LAW HUB"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 22
    
    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Parent = Frame
    Scroll.BackgroundTransparency = 1
    Scroll.Position = UDim2.new(0, 15, 0, 60)
    Scroll.Size = UDim2.new(1, -30, 1, -110)
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Scroll.ScrollBarThickness = 0
    
    -- Function to create a toggle row
    local function MakeToggle(rowName, initial)
        local Row = Instance.new("Frame")
        Row.Parent = Scroll
        Row.BackgroundTransparency = 1
        Row.Size = UDim2.new(1, 0, 0, 50)
        
        local Label = Instance.new("TextLabel")
        Label.Parent = Row
        Label.BackgroundTransparency = 1
        Label.Size = UDim2.new(0.5, 0, 1, 0)
        Label.Font = Enum.Font.GothamBold
        Label.Text = rowName
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 15
        Label.TextXAlignment = Enum.TextXAlignment.Left
        
        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Parent = Row
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBtn.Position = UDim2.new(0.55, 0, 0.2, 0)
        ToggleBtn.Size = UDim2.new(0, 50, 0, 26)
        ToggleBtn.Text = ""
        
        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(1, 0)
        BtnCorner.Parent = ToggleBtn
        
        local Circle = Instance.new("Frame")
        Circle.Parent = ToggleBtn
        Circle.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        Circle.Position = initial and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        Circle.Size = UDim2.new(0, 20, 0, 20)
        
        local CircleCorner = Instance.new("UICorner")
        CircleCorner.CornerRadius = UDim.new(1, 0)
        CircleCorner.Parent = Circle
        
        local isOn = initial or false
        
        ToggleBtn.MouseButton1Click:Connect(function()
            isOn = not isOn
            local targetPos = isOn and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
            local tween = game:GetService("TweenService"):Create(Circle, TweenInfo.new(0.2), {Position = targetPos})
            tween:Play()
        end)
    end
    
    MakeToggle("Instant Steal", false)
    MakeToggle("Auto Grab", false)
    MakeToggle("Active Potion", false)
    MakeToggle("Unlock Base", false)
    MakeToggle("Steal Speed", false)
    
    -- Create layout
    local Layout = Instance.new("UIListLayout")
    Layout.Parent = Scroll
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 12)
    
    -- DRAG SYSTEM
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local UIS = game:GetService("UserInputService")
    
    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end)
