-- =============================================
local function createToggle(parent, name, varName, callback)
    local Row = Instance.new("Frame")
    local Label = Instance.new("TextLabel")
    local ToggleBtn = Instance.new("TextButton")
    local Circle = Instance.new("Frame")
    
    Row.Parent = parent
    Row.BackgroundTransparency = 1
    Row.Size = UDim2.new(1, 0, 0, 50)

    Label.Parent = Row
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.Font = Enum.Font.GothamBold
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 15
    Label.TextXAlignment = Enum.TextXAlignment.Left

    ToggleBtn.Parent = Row
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Position = UDim2.new(0.55, 0, 0.2, 0)
    ToggleBtn.Size = UDim2.new(0, 50, 0, 26)
    ToggleBtn.Text = ""
    corner(ToggleBtn, 13)

    Circle.Parent = ToggleBtn
    Circle.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Circle.Position = UDim2.new(0, 3, 0.5, -10)
    Circle.Size = UDim2.new(0, 20, 0, 20)
    corner(Circle, 10)

    ToggleBtn.MouseButton1Click:Connect(function()
        _G[varName] = not _G[varName]
        local targetPos = _G[varName] and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = targetPos}):Play()
        if callback then callback(_G[varName]) end
    end)
end

