    Row.BackgroundTransparency = 1
    Row.Size = UDim2.new(1, 0, 0, 50)

    Label.Parent = Row
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.Font = Enum.Font.GothamBold
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 15
    Label.TextXAlignment = Enum.TextXAlignment.Left

    ToggleBtn.Parent = Row
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Position = UDim2.new(0.55, 0, 0.2, 0)
    ToggleBtn.Size = UDim2.new(0, 50, 0, 26)
    ToggleBtn.Text = ""
    local btnCorner = Instance.new("UICorner", ToggleBtn)
    btnCorner.CornerRadius = UDim.new(1, 0)

    Circle.Parent = ToggleBtn
    Circle.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Circle.Position = Toggles[configKey] and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    Circle.Size = UDim2.new(0, 20, 0, 20)
    local circleCorner = Instance.new("UICorner", Circle)
    circleCorner.CornerRadius = UDim.new(1, 0)

    ToggleBtn.MouseButton1Click:Connect(function()
        Toggles[configKey] = not Toggles[configKey]
        local targetPos = Toggles[configKey] and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = targetPos}):Play()
        
        if configKey == "InstantSteal" then
            ShowStealPanel(Toggles[configKey])
        elseif configKey == "UnlockBase" then
            ShowUnlockPanel(Toggles[configKey])
        elseif configKey == "StealSpeed" then
            if Toggles[configKey] then
                StartStealSpeed()
            else
                StopStealSpeed()
            end
        end
    end)

    if hasInput then
        local Input = Instance.new("TextBox")
        Input.Parent = Row
        Input.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        Input.Position = UDim2.new(0.78, 0, 0.15, 0)
        Input.Size = UDim2.new(0, 60, 0, 30)
        Input.Font = Enum.Font.GothamBold
        Input.Text = tostring(Values.SpeedAmount)
        Input.TextColor3 = Color3.fromRGB(255, 255, 255)
        Input.TextSize = 14
        local inputCorner = Instance.new("UICorner", Input)
        inputCorner.CornerRadius = UDim.new(0, 6)
        
        Input.FocusLost:Connect(function()
            local val = tonumber(Input.Text)
            if val then
                Values.SpeedAmount = math.clamp(val, 26, 36)
                Input.Text = tostring(Values.SpeedAmount)
            else
                Input.Text = tostring(Values.SpeedAmount)
            end
        end)
    end
end

