local function CreateMainMenu()
    if MainMenu then MainMenu:Destroy() end
    
    local sg = Instance.new("ScreenGui")
    sg.Name = "LawHub"
    sg.ResetOnSpawn = false
    sg.Parent = CoreGui or LocalPlayer.PlayerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 230, 0, 380)
    frame.Position = UDim2.new(0.5, -115, 0.35, 0)
    frame.BackgroundColor3 = Colors.BG
    frame.BackgroundTransparency = 0.05
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = sg
    MakeCorner(frame, 10)
    MakeStroke(frame, Colors.Border)
    
    -- Header
    local header = Instance.new("Frame", frame)
    header.Size = UDim2.new(1, 0, 0, 40)
    header.BackgroundColor3 = Colors.Header
    header.BorderSizePixel = 0
    MakeCorner(header, 10)
    
    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -50, 1, 0)
    title.Position = UDim2.new(0, 10, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "LAW HUB"
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 14
    title.TextColor3 = Colors.Text
    title.TextXAlignment = Enum.TextXAlignment.Left
    
    -- Minimizar
    local minBtn = Instance.new("TextButton", header)
    minBtn.Size = UDim2.new(0, 24, 0, 24)
    minBtn.Position = UDim2.new(1, -34, 0.5, -12)
    minBtn.BackgroundColor3 = Colors.Button
    minBtn.Text = "−"
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 14
    MakeCorner(minBtn, 6)
    MakeStroke(minBtn, Colors.Border)
    
    -- Fechar
    local closeBtn = Instance.new("TextButton", header)
    closeBtn.Size = UDim2.new(0, 24, 0, 24)
    closeBtn.Position = UDim2.new(1, -62, 0.5, -12)
    closeBtn.BackgroundColor3 = Colors.Button
    closeBtn.Text = "✕"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 12
    MakeCorner(closeBtn, 6)
    MakeStroke(closeBtn, Colors.Border)
    
    closeBtn.MouseButton1Click:Connect(function()
        sg.Enabled = false
    end)
    
    local line = Instance.new("Frame", frame)
    line.Size = UDim2.new(0.9, 0, 0, 1)
    line.Position = UDim2.new(0.05, 0, 0, 42)
    line.BackgroundColor3 = Colors.Border
    
    -- Container
    local container = Instance.new("ScrollingFrame", frame)
    container.Size = UDim2.new(1, -12, 1, -75)
    container.Position = UDim2.new(0, 6, 0, 48)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ScrollBarThickness = 3
    container.CanvasSize = UDim2.new(0, 0, 0, 280)
    
    local layout = Instance.new("UIListLayout", container)
    layout.Padding = UDim.new(0, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    -- Toggles
    local toggleData = {
        {id = "instant_steal", label = "INSTANT STEAL", desc = "Teleport when clicking"},
        {id = "auto_grab", label = "AUTO GRAB", desc = "Auto steals (0.1s)"},
        {id = "active_potion", label = "ACTIVE POTION", desc = "Potion when get Brainrot"},
        {id = "unlock_base", label = "UNLOCK BASE", desc = "Unlock other base"},
        {id = "steal_speed", label = "STEAL SPEED", desc = "Increase speed"},
    }
    
    for _, data in ipairs(toggleData) do
        local id = data.id
        
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 48)
        row.BackgroundColor3 = Colors.Card
        row.BackgroundTransparency = 0.3
        row.BorderSizePixel = 0
        row.Parent = container
        MakeCorner(row, 7)
        
        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -55, 0, 20)
        lbl.Position = UDim2.new(0, 8, 0, 4)
        lbl.BackgroundTransparency = 1
        lbl.Text = data.label
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextColor3 = Colors.Text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local dsc = Instance.new("TextLabel", row)
        dsc.Size = UDim2.new(1, -55, 0, 14)
        dsc.Position = UDim2.new(0, 8, 0, 26)
        dsc.BackgroundTransparency = 1
        dsc.Text = data.desc
        dsc.Font = Enum.Font.Gotham
        dsc.TextSize = 8
        dsc.TextColor3 = Colors.TextDim
        dsc.TextXAlignment = Enum.TextXAlignment.Left
        
        local swBg = Instance.new("Frame", row)
        swBg.Size = UDim2.new(0, 36, 0, 18)
        swBg.Position = UDim2.new(1, -44, 0.5, -9)
        swBg.BackgroundColor3 = Toggles[id] and Colors.Accent or Colors.ToggleOff
        MakeCorner(swBg, 9)
        
        local knob = Instance.new("Frame", swBg)
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = Toggles[id] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        knob.BackgroundColor3 = Toggles[id] and Colors.KnobOn or Colors.KnobOff
        MakeCorner(knob, 7)
        
        local click = Instance.new("TextButton", swBg)
        click.Size = UDim2.new(1, 0, 1, 0)
        click.BackgroundTransparency = 1
        click.Text = ""
        
        click.MouseButton1Click:Connect(function()
            Toggles[id] = not Toggles[id]
            
            if Toggles[id] then
                swBg.BackgroundColor3 = Colors.Accent
                knob.Position = UDim2.new(1, -16, 0.5, -7)
                knob.BackgroundColor3 = Colors.KnobOn
            else
                swBg.BackgroundColor3 = Colors.ToggleOff
                knob.Position = UDim2.new(0, 2, 0.5, -7)
                knob.BackgroundColor3 = Colors.KnobOff
            end
            
            if id == "instant_steal" then
                ShowStealPanel(Toggles[id])
            elseif id == "auto_grab" then
                -- O loop já verifica Toggles.auto_grab automaticamente
            elseif id == "active_potion" then
                if Toggles[id] then StartPotionWatcher() else StopPotionWatcher() end
            elseif id == "unlock_base" then
                ShowUnlockPanel(Toggles[id])
            elseif id == "steal_speed" then
                StealSpeedActive = Toggles[id]
                if StealSpeedActive then
                    StartStealSpeed()
                else
                    StopStealSpeed()
                end
            end
            
            SaveConfig()
        end)
        
        row.MouseEnter:Connect(function()
            row.BackgroundTransparency = 0
        end)
        row.MouseLeave:Connect(function()
            row.BackgroundTransparency = 0.3
        end)
    end
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)
    
    -- Footer
    local footer = Instance.new("TextLabel", frame)
    footer.Size = UDim2.new(1, 0, 0, 20)
    footer.Position = UDim2.new(0, 0, 1, -22)
    footer.BackgroundTransparency = 1
    footer.Text = "LAW HUB"
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 8
    footer.TextColor3 = Colors.Footer
    
    -- Minimizar
    local minimized = false
    local fullHeight = 380
    local miniHeight = 40
    
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        local newHeight = minimized and miniHeight or fullHeight
        Tween(frame, {Size = UDim2.new(0, 230, 0, newHeight)}, 0.3)
        container.Visible = not minimized
        line.Visible = not minimized
        footer.Visible = not minimized
        minBtn.Text = minimized and "+" or "−"
    end)
    
    -- Drag
    local dragging = false
    local dragStart = nil
    local frameStart = nil
    
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            frameStart = frame.Position
        end
    end)
    
    header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                frameStart.X.Scale,
                frameStart.X.Offset + delta.X,
                frameStart.Y.Scale,
                frameStart.Y.Offset + delta.Y
            )
        end
    end)
    
    MainMenu = sg
end

