    -- TOGGLE CREATOR
    local function CreateToggle(parent, name, varName, hasInput)
        local Row = Instance.new("Frame")
        local Label = Instance.new("TextLabel")
        local ToggleBtn = Instance.new("TextButton")
        local Circle = Instance.new("Frame")
        
        Row.Name = name
        Row.Parent = parent
        Row.BackgroundTransparency = 1
        Row.Size = UDim2.new(1, 0, 0, 50)

        Label.Parent = Row
        Label.BackgroundTransparency = 1
        Label.Size = UDim2.new(0.5, 0, 1, 0)
        Label.Font = Enum.Font.GothamBold
        Label.Text = name
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 15
        Label.TextXAlignment = Enum.TextXAlignment.Left

        ToggleBtn.Parent = Row
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBtn.Position = UDim2.new(0.55, 0, 0.2, 0)
        ToggleBtn.Size = UDim2.new(0, 50, 0, 26)
        ToggleBtn.Text = ""
        corner(ToggleBtn, 13)

        Circle.Parent = ToggleBtn
        Circle.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        Circle.Position = UDim2.new(0, 3, 0.5, -10)
        Circle.Size = UDim2.new(0, 20, 0, 20)
        corner(Circle, 10)

        local function updateToggle(state)
            local targetPos = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = targetPos}):Play()
        end

        ToggleBtn.MouseButton1Click:Connect(function()
            if varName == "instantSteal" then
                instantSteal = not instantSteal
                updateToggle(instantSteal)
                ShowStealPanel(instantSteal)
            elseif varName == "autoGrab" then
                autoGrab = not autoGrab
                updateToggle(autoGrab)
            elseif varName == "activePotion" then
                activePotion = not activePotion
                updateToggle(activePotion)
            elseif varName == "unlockBase" then
                unlockBase = not unlockBase
                updateToggle(unlockBase)
                ShowUnlockPanel(unlockBase)
            elseif varName == "stealSpeed" then
                stealSpeed = not stealSpeed
                updateToggle(stealSpeed)
                if stealSpeed then StartSpeed() else StopSpeed() end
            end
        end)

        if hasInput then
            local Input = Instance.new("TextBox")
            Input.Parent = Row
            Input.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            Input.Position = UDim2.new(0.78, 0, 0.15, 0)
            Input.Size = UDim2.new(0, 60, 0, 30)
            Input.Font = Enum.Font.GothamBold
            Input.Text = tostring(currentSpeed)
            Input.TextColor3 = Color3.fromRGB(255, 255, 255)
            Input.TextSize = 14
            corner(Input, 6)
            
            Input.FocusLost:Connect(function()
                local val = tonumber(Input.Text)
                if val then
                    currentSpeed = math.clamp(val, 26, 36)
                    Input.Text = tostring(currentSpeed)
                else
                    Input.Text = tostring(currentSpeed)
                end
            end)
        end
    end
    
