-- FUNÇÃO PARA CRIAR TOGGLE (ESTILO ARIES HUB)
-- =============================================
local function createToggle(parent, name, configKey, hasInput, defaultVal)
    local Row = Instance.new("Frame")
    local Label = Instance.new("TextLabel")
    local ToggleBtn = Instance.new("TextButton")
    local Circle = Instance.new("Frame")
    
    Row.Name = name
    Row.Parent = parent
    Row.BackgroundTransparency = 1
    Row.Size = UDim2.new(1, 0, 0, 50)

    Label.Parent = Row
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.Font = Enum.Font.GothamBold
    Label.Text = name
    Label.TextColor3 = C.text
    Label.TextSize = 15
    Label.TextXAlignment = Enum.TextXAlignment.Left

    ToggleBtn.Parent = Row
    ToggleBtn.BackgroundColor3 = C.text
    ToggleBtn.Position = UDim2.new(0.55, 0, 0.2, 0)
    ToggleBtn.Size = UDim2.new(0, 50, 0, 26)
    ToggleBtn.Text = ""
    corner(ToggleBtn, 13)

    Circle.Parent = ToggleBtn
    Circle.BackgroundColor3 = C.card
    Circle.Position = UDim2.new(0, 3, 0.5, -10)
    Circle.Size = UDim2.new(0, 20, 0, 20)
    corner(Circle, 10)

    -- Estado inicial
    if State[configKey] then
        Circle.Position = UDim2.new(1, -23, 0.5, -10)
    end

    ToggleBtn.MouseButton1Click:Connect(function()
        State[configKey] = not State[configKey]
        local targetPos = State[configKey] and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = targetPos}):Play()
        
        if configKey == "instantSteal" then
            showSteal(State[configKey])
        elseif configKey == "unlockBase" then
            showUnlock(State[configKey])
        elseif configKey == "stealSpeed" then
            if State[configKey] then
                startSpeed()
            else
                stopSpeed()
            end
        end
    end)

    if hasInput then
        local Input = Instance.new("TextBox")
        Input.Parent = Row
        Input.BackgroundColor3 = C.card
        Input.Position = UDim2.new(0.78, 0, 0.15, 0)
        Input.Size = UDim2.new(0, 60, 0, 30)
        Input.Font = Enum.Font.GothamBold
        Input.Text = tostring(defaultVal)
        Input.TextColor3 = C.text
        Input.TextSize = 14
        corner(Input, 6)
        
        Input.FocusLost:Connect(function()
            local val = tonumber(Input.Text)
            if val then
                State.currentSpeed = math.clamp(val, 26, 36)
                Input.Text = tostring(State.currentSpeed)
            else
                Input.Text = tostring(State.currentSpeed)
            end
        end)
    end
end

