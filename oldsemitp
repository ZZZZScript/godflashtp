    local unlockPanel = nil
    
    -- CHARACTER
    local RootPart = nil
    local Humanoid = nil
    
    local function updateChar(char)
        wait(0.5)
        RootPart = char:FindFirstChild("HumanoidRootPart")
        Humanoid = char:FindFirstChildOfClass("Humanoid")
    end
    
    LocalPlayer.CharacterAdded:Connect(updateChar)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    RootPart = char:FindFirstChild("HumanoidRootPart")
    Humanoid = char:FindFirstChildOfClass("Humanoid")
    
    -- ADMIN PANEL
    local function GetAdminFrames()
        local ap = LocalPlayer.PlayerGui:FindFirstChild("AdminPanel")
        if not ap then return nil, nil end
        local pnl = ap:FindFirstChild("AdminPanel")
        if not pnl then return nil, nil end
        local cont = pnl:FindFirstChild("Content")
        local prof = pnl:FindFirstChild("Profiles")
        if not cont or not prof then return nil, nil end
        return cont:FindFirstChild("ScrollingFrame"), prof:FindFirstChild("ScrollingFrame")
    end
    
    local function FireButton(btn)
        local ok, conns = pcall(getconnections, btn.Activated)
        if ok and conns then
            for _, c in ipairs(conns) do
                spawn(c.Function)
            end
        end
    end
    
    local function RunCommand(cmd, target)
        local cmdFrame, profFrame = GetAdminFrames()
        if not cmdFrame or not profFrame then return end
        local profBtn = profFrame:FindFirstChild(target.Name)
        local cmdBtn = cmdFrame:FindFirstChild(cmd)
        if profBtn and cmdBtn then
            FireButton(profBtn)
            wait(0.05)
            FireButton(cmdBtn)
        end
    end
    
    -- POTION
    local function UsePotion()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character
        if bp and char then
            local pot = bp:FindFirstChild("Giant Potion")
            if pot then
                pot.Parent = char
                pcall(function() pot:Activate() end)
            end
        end
    end
    
    -- TELEPORT
    local function GetMyPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        for _, p in pairs(plots:GetChildren()) do
            local sign = p:FindFirstChild("PlotSign")
            if sign and sign:FindFirstChild("YourBase") then
                return p
            end
        end
        return nil
    end
    
    local function TeleportTo(pos)
        if RootPart then
            RootPart.CFrame = CFrame.new(pos)
            RootPart.Velocity = Vector3.zero
        end
    end
    
    local function EquipCarpet()
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if not char or not bp then return
        for _, t in pairs(char:GetChildren()) do
            if t:IsA("Tool") then
                t.Parent = bp
            end
        end
        local carpet = bp:FindFirstChild("Flying Carpet")
        if carpet and Humanoid then
            Humanoid:EquipTool(carpet)
        end
    end
    
    local function DoTeleport()
        if teleporting then return end
        teleporting = true
        
        if potionOnTp then
            UsePotion()
        end
        
        local plot = GetMyPlot()
        if plot then
            EquipCarpet()
            wait(0.1)
            local order = plot:GetAttribute("Order")
            if order == 2 then
                TeleportTo(Vector3.new(-368, -7, 69))
                wait(0.1)
                TeleportTo(Vector3.new(-336, -5, 100))
                wait(0.1)
                TeleportTo(Vector3.new(-352, -7, 76))
            else
                TeleportTo(Vector3.new(-368, -7, 42))
                wait(0.1)
                TeleportTo(Vector3.new(-336, -5, 20))
                wait(0.1)
                TeleportTo(Vector3.new(-353, -7, 44))
            end
            
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    RunCommand("steal", plr)
                    break
                end
            end
        end
        
        wait(0.5)
        teleporting = false
    end
    
    -- AUTO GRAB
    local function FindPrompt()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        
        local nearest, minD = nil, math.huge
        local plots = workspace:FindFirstChild("Plots")
        if plots then
            for _, desc in pairs(plots:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and desc.Enabled and desc.ActionText == "Steal" then
                    local part = desc.Parent
                    local pos = nil
                    if part:IsA("BasePart") then
                        pos = part.Position
                    elseif part:IsA("Model") and part.PrimaryPart then
                        pos = part.PrimaryPart.Position
                    end
                    if pos then
                        local d = (hrp.Position - pos).Magnitude
                        if d < minD then
                            minD = d
                            nearest = desc
                        end
                    end
                end
            end
        end
        return nearest
    end
    
    local function StealPrompt(p)
        if not p then return
        p.MaxActivationDistance = 9999
        p.RequiresLineOfSight = false
        pcall(function() fireproximityprompt(p, 9999, 0.3) end)
    end
    
    spawn(function()
        while true do
            if autoGrab then
                local p = FindPrompt()
                if p then StealPrompt(p) end
            end
            wait(0.15)
        end
    end)
    
    -- ACTIVE POTION MONITOR
    local keywords = {"steal", "stole", "roubou", "pegou", "robou"}
    
    spawn(function()
        while true do
            if activePotion then
                local gui = LocalPlayer:FindFirstChild("PlayerGui")
                if gui then
                    for _, obj in pairs(gui:GetDescendants()) do
                        if obj:IsA("TextLabel") and obj.Text then
                            local txt = string.lower(obj.Text)
                            for _, kw in ipairs(keywords) do
                                if string.find(txt, kw) then
                                    UsePotion()
                                    break
                                end
                            end
                        end
                    end
                end
            end
            wait(0.3)
        end
    end)
    
    -- STEAL SPEED
    local function StartSpeed()
        if speedConn then speedConn:Disconnect() end
        speedConn = RunService.Heartbeat:Connect(function()
            if stealSpeed and instantSteal then
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hrp and hum then
                        hum.WalkSpeed = currentSpeed
                        local dir = hum.MoveDirection
                        if dir.Magnitude > 0 then
                            hrp.Velocity = Vector3.new(dir.X * currentSpeed, hrp.Velocity.Y, dir.Z * currentSpeed)
                        end
                    end
                end
            end
        end)
    end
    
    local function StopSpeed()
        if speedConn then
            speedConn:Disconnect()
            speedConn = nil
        end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
        end
    end
    
    -- UNLOCK BASE
    local function FindOtherPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        for _, p in pairs(plots:GetChildren()) do
            local sign = p:FindFirstChild("PlotSign")
            if sign then
                local yb = sign:FindFirstChild("YourBase")
                if not (yb and yb.Enabled) then
                    return p
                end
            end
        end
        return nil
    end
    
    local function DoUnlock()
        local plot = FindOtherPlot()
        if plot then
            for _, obj in pairs(plot:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local txt = (obj.ActionText or ""):lower()
                    if string.find(txt, "unlock") then
                        local old = obj.MaxActivationDistance
                        obj.MaxActivationDistance = 9999
                        pcall(function() fireproximityprompt(obj, 9999) end)
                        delay(0.3, function() obj.MaxActivationDistance = old end)
                        break
                    end
                end
            end
        end
    end
    
