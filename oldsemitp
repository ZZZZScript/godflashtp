local function CreateLawButton()
    if LawButton then LawButton:Destroy() end
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 55, 0, 26)
    btn.Position = UDim2.new(1, -65, 0, 10)
    btn.BackgroundColor3 = Colors.BG
    btn.BackgroundTransparency = 0.2
    btn.Text = "LAW"
    btn.TextColor3 = Colors.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.Parent = CoreGui or LocalPlayer.PlayerGui
    MakeCorner(btn, 8)
    MakeStroke(btn, Colors.Border)
    
    btn.MouseButton1Click:Connect(function()
        MenuVisible = not MenuVisible
        if MainMenu then MainMenu.Visible = MenuVisible
    end)
    
    LawButton = btn
end

-- =============================================
-- KEYBIND
-- =============================================
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKeybind then
        DoTeleport()
    end
end)

-- =============================================
-- INICIAR
-- =============================================
LoadConfig()
CreateLawButton()
CreateMainMenu()

if Toggles.instant_steal then ShowStealPanel(true) end
if Toggles.active_potion then StartPotionWatcher() end
if Toggles.unlock_base then ShowUnlockPanel(true) end
if Toggles.steal_speed then
    StealSpeedActive = true
    StartStealSpeed()
end

print("=== LAW HUB CARREGADO ===")
print("INSTANT STEAL: Clique no botão Teleport ou tecla R")
print("AUTO GRAB: Rouba automaticamente a cada 0.1s")
print("ACTIVE POTION: Poção ao detectar roubo")
print("STEAL SPEED: Slider no painel Instant Steal")
