    local function stroke(p, t, col)
        local s = Instance.new("UIStroke")
        s.Thickness = t or 1.5
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Color = col or Colors.border
        s.Parent = p
        return s
    end
    
