    end
    
    local function mkMinimize(f, btn)
        local min = false
        local orig = f.Size
        local mini = UDim2.new(0, orig.X.Offset, 0, HDR)
        btn.MouseButton1Click:Connect(function()
            min = not min
            TweenService:Create(f, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {Size = min and mini or orig}):Play()
            btn.Text = min and "+" or "-"
        end)
    end
    
    -- Admin Panel
    local AP = mkPanel(8, 8, AW, AH)
    local apHdr, apMinBtn = mkHeader(AP, "Admin Panel")
