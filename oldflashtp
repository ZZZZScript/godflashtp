local tpDistance = 90.5
local activeTriggers = {}

-- [[(/ Função do Slider do Trigger /)]]
do
    local sliderDragging = false

    local function updateTriggerSlider(inputX)
        local trackAbsPos = TriggerTrack.AbsolutePosition.X
        local trackAbsSize = TriggerTrack.AbsoluteSize.X
        local relativeX = math.clamp((inputX - trackAbsPos) / trackAbsSize, 0, 1)
        flashTrigger = relativeX
        TriggerFill.Size = UDim2.new(relativeX, 0, 1, 0)
        TriggerKnob.Position = UDim2.new(relativeX, 0, 0.5, -7)
        TriggerLabel.Text = "TRIGGER: " .. math.floor(relativeX * 100) .. "%"
    end

    TriggerKnob.MouseButton1Down:Connect(function()
        sliderDragging = true
    end)

    TriggerTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliderDragging = true
            updateTriggerSlider(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateTriggerSlider(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = false
        end
    end)
end

-- [[(/ Função do Slider do Speed /)]]
do
    local sliderDragging = false

    local function updateSpeedSlider(inputX)
        local trackAbsPos = SpeedSliderTrack.AbsolutePosition.X
        local trackAbsSize = SpeedSliderTrack.AbsoluteSize.X
        local relativeX = math.clamp((inputX - trackAbsPos) / trackAbsSize, 0, 1)
        local newSpeed = math.floor(16 + (relativeX * 34))
        newSpeed = math.clamp(newSpeed, 16, 50)
        speedAmount = newSpeed
        SpeedSliderFill.Size = UDim2.new((speedAmount - 16) / 34, 0, 1, 0)
        SpeedSliderKnob.Position = UDim2.new((speedAmount - 16) / 34, 0, 0.5, -7)
        SpeedCurrentValue.Text = tostring(speedAmount)
        SpeedPanelLabel.Text = "SPEED: " .. speedAmount
    end

    SpeedSliderKnob.MouseButton1Down:Connect(function()
        sliderDragging = true
    end)

    SpeedSliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliderDragging = true
            updateSpeedSlider(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSpeedSlider(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = false
        end
    end)
end

-- [[(/ Flash TP Durante o Steal /)]]
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if not flashEnabled then return end
    if activeTriggers[prompt] then return end
    activeTriggers[prompt] = true
    local start = os.clock()
    local fired = false

    StealBarFill.BackgroundTransparency = 0
    StealBarBG.BackgroundTransparency = 0

    local conn
    conn = RunService.PreRender:Connect(function()
        if not prompt or not prompt.Parent then
            conn:Disconnect()
            activeTriggers[prompt] = nil
            TweenService:Create(StealBarFill, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 1, 0)}):Play()
            return
        end

        local progress = math.clamp((os.clock() - start) / prompt.HoldDuration, 0, 1)
        StealBarFill.Size = UDim2.new(progress, 0, 1, 0)

        if not fired and progress >= flashTrigger then
            fired = true
            conn:Disconnect()
            activeTriggers[prompt] = nil
            
            -- Flash TP
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -tpDistance)
            end
            
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end

            StealBarFill.Size = UDim2.new(1, 0, 1, 0)
            task.delay(0.2, function()
                TweenService:Create(StealBarFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 1, 0)
                }):Play()
            end)
        end
    end)

    prompt.PromptButtonHoldEnded:Connect(function()
        if not fired then
            conn:Disconnect()
            activeTriggers[prompt] = nil
            TweenService:Create(StealBarFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 1, 0)
            }):Play()
        end
    end)
end)

