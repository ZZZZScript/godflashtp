    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = LPnl
    corner(scroll, 8)
    stroke(scroll, 1, Colors.border)
    
    local ull = Instance.new("UIListLayout")
    ull.Padding = UDim.new(0, 5)
    ull.SortOrder = Enum.SortOrder.Name
    ull.HorizontalAlignment = Enum.HorizontalAlignment.Center
    ull.Parent = scroll
    
    local upad = Instance.new("UIPadding")
    upad.PaddingTop = UDim.new(0, 5)
    upad.PaddingBottom = UDim.new(0, 5)
    upad.Parent = scroll
    
    local spamBtn = Instance.new("TextButton")
