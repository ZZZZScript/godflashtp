    end
    
    RunService.RenderStepped:Connect(function()
        local now = tick()
        for _, cmd in ipairs(CMDS) do
            local l = cdLabels[cmd]
            if l and l.Parent then
                local cd = cooldowns[cmd] or 0
                if now >= cd then
                    l.Text = "READY"
                    l.TextColor3 = Colors.green
                else
                    l.Text = math.ceil(cd - now) .. "s"
                    l.TextColor3 = Colors.red
                end
            end
        end
    end)
    
    UserInputService.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == Enum.KeyCode.C then
            local target = getClosestPlayer()
            if target then spamAllCommands(target) end
        end
    end)
    
    return SG
end

