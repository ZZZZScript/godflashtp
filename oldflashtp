local function spamCommand(target, cmd)
    if not core.remote or not target then return end
    local now = tick()
    if (cooldowns[cmd] or 0) > now then return end
    pcall(function()
        core.remote:InvokeServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", target, cmd)
    end)
    cooldowns[cmd] = now + DUR[cmd]
end

local function spamAllCommands(target)
    if not core.remote or not target then return end
    local now = tick()
    for _, cmd in ipairs(CMDS) do
        if (cooldowns[cmd] or 0) <= now then
            pcall(function()
                core.remote:InvokeServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", target, cmd)
            end)
            cooldowns[cmd] = now + DUR[cmd]
        end
    end
end

local function getClosestPlayer()
    local hrp = getRoot()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr and p.Character then
            local ph = p.Character:FindFirstChild("HumanoidRootPart")
            if ph then
                local d = (ph.Position - hrp.Position).Magnitude
                if d < bestDist then bestDist = d; best = p end
            end
        end
    end
    return best
end

