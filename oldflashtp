-- ============================================================
-- ANIMAL SCANNING
-- ============================================================
local RADIUS = 200
local animals = {}
local promptCache = {}

local function isMyBase(n)
    local p = workspace.Plots and workspace.Plots:FindFirstChild(n)
    if not p then return false end
    local s = p:FindFirstChild("PlotSign")
    return s and s:FindFirstChild("YourBase") and s.YourBase.Enabled
end

local function scanPlot(plot)
    if not plot or not plot:IsA("Model") or isMyBase(plot.Name) then return end
    local pods = plot:FindFirstChild("AnimalPodiums"); if not pods then return end
    for _, pod in ipairs(pods:GetChildren()) do
        if pod:IsA("Model") and pod:FindFirstChild("Base") then
            table.insert(animals, {plot = plot.Name, slot = pod.Name, pos = pod:GetPivot().Position, uid = plot.Name.."_"..pod.Name})
        end
    end
end

task.spawn(function()
    task.wait(0)
    local plots = workspace:WaitForChild("Plots", 10)
    if not plots then return end
    for _, p in ipairs(plots:GetChildren()) do scanPlot(p) end
    plots.ChildAdded:Connect(scanPlot)
    task.spawn(function()
        while task.wait(0) do
            table.clear(animals)
            local cp = workspace:FindFirstChild("Plots")
            if cp then for _, p in ipairs(cp:GetChildren()) do scanPlot(p) end end
        end
    end)
end)

local function findPrompt(a)
    local c = promptCache[a.uid]; if c and c.Parent then return c end
    local plot = workspace.Plots and workspace.Plots:FindFirstChild(a.plot)
    local pod = plot and plot.AnimalPodiums and plot.AnimalPodiums:FindFirstChild(a.slot)
    local pr = pod and pod.Base and pod.Base.Spawn and pod.Base.Spawn.PromptAttachment and pod.Base.Spawn.PromptAttachment:FindFirstChildOfClass("ProximityPrompt")
    if pr then promptCache[a.uid] = pr end
    return pr
end

local function autoGrab()
    local a = nil
    local r = getRoot(); if not r then return end
    local n, d = nil, math.huge
    for _, a in ipairs(animals) do
        local dist = (r.Position - a.pos).Magnitude
        if dist < d and dist <= RADIUS then d = dist; n = a end
    end
    a = n
    if not a then return end
    local p = findPrompt(a); if not p then return end
    pcall(function() fireproximityprompt(p) end)
end

-- ============================================================
-- INSTANT STEAL TP FUNCTIONS
-- ============================================================
local isBusy = false

local function doExecuteTP()
    if isBusy then return end
    isBusy = true
    task.spawn(function()
        pcall(function()
            local base = detectBase()
            local coords = base == "left" and COORDS_LEFT or COORDS_RIGHT
            for i, cf in ipairs(coords) do
                local r = getRoot(); if not r then break end
                if not (Save.autoPotion and i == #coords - 1) then
                    equipCarpet()
                    r = getRoot(); if not r then break end
                end
                r.CFrame = cf
                if i == #coords - 1 then
                    task.wait(0.05)
                    autoGrab()
                    r = getRoot()
                    if r then
                        if Save.autoPotion then
                            equipCarpet()
                            r = getRoot()
                            local hum = getHum()
                            local bp = plr:FindFirstChild("Backpack")
                            if hum and bp then
                                local pot = bp:FindFirstChild("Giant Potion")
                                if pot then
                                    hum:EquipTool(pot)
                                    task.wait(0.05)
                                    pcall(function() pot:Activate() end)
                                    task.wait(0.05)
                                end
                            end
                        else equipCarpet(); r = getRoot() end
                        r = getRoot()
                        if r then r.CFrame = coords[#coords] end
                    end
                    break
                end
                task.wait(0.12)
            end
        end)
        isBusy = false
    end)
end

local function doSemiTP()
    local r = getRoot()
    if not r then return end
    local nearest = nil
    local nearestDist = math.huge
    for _, a in ipairs(animals) do
        local dist = (r.Position - a.pos).Magnitude
        if dist < nearestDist then nearestDist = dist; nearest = a end
    end
    if nearest then
        r.CFrame = CFrame.new(nearest.pos)
        task.wait(0.1)
        local p = findPrompt(nearest)
        if p then pcall(function() fireproximityprompt(p) end) end
    end
end

local function tpToBrainrot()
    local root = getRoot()
    if not root then return end
    local nearest = nil
    local nearestDist = math.huge
    for _, a in ipairs(animals) do
        local dist = (root.Position - a.pos).Magnitude
        if dist < nearestDist then nearestDist = dist; nearest = a end
    end
    if nearest then
        root.CFrame = CFrame.new(nearest.pos)
        Notify.show("TP To Brainrot", "Teleported")
    end
end

