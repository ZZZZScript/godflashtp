-- Timer ESP
local _baseEspInstances = {}
local function updateBaseESP()
    if not Save.espTimer then
        for _,bb in pairs(_baseEspInstances) do pcall(function() bb:Destroy() end) end
        table.clear(_baseEspInstances)
        return
    end
    local plots = workspace:FindFirstChild("Plots")
    if plots then
        for _,plot in ipairs(plots:GetChildren()) do
            local purchases = plot:FindFirstChild("Purchases")
            local plotBlock = purchases and purchases:FindFirstChild("PlotBlock")
            local mainPart = plotBlock and plotBlock:FindFirstChild("Main")
            local timeLabel = mainPart and mainPart:FindFirstChild("BillboardGui") and mainPart.BillboardGui:FindFirstChild("RemainingTime")
            if timeLabel and mainPart then
                if not _baseEspInstances[plot.Name] then
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0,70,0,30); bb.StudsOffset = Vector3.new(0,5,0); bb.AlwaysOnTop = true
                    bb.Adornee = mainPart; bb.Parent = plot
                    local l2 = Instance.new("TextLabel")
                    l2.Size = UDim2.new(1,0,1,0); l2.BackgroundTransparency = 1; l2.TextScaled = true
                    l2.Font = Enum.Font.GothamBlack; l2.TextColor3 = Color3.fromRGB(255,255,0); l2.Parent = bb
                    _baseEspInstances[plot.Name] = bb
                end
                local l3 = _baseEspInstances[plot.Name]:FindFirstChildWhichIsA("TextLabel")
                if l3 then l3.Text = timeLabel.Text end
            elseif _baseEspInstances[plot.Name] then
                _baseEspInstances[plot.Name]:Destroy(); _baseEspInstances[plot.Name] = nil
            end
        end
    end
end

