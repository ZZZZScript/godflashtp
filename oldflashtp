        f.BackgroundColor3 = Colors.panel
        f.BorderSizePixel = 0
        f.ClipsDescendants = true
        f.Active = true
        f.Parent = SG
        corner(f, 10)
        stroke(f, 1.5, Colors.border)
        return f
