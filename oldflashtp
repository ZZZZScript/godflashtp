local _origTransp = {}
local xrayConn = nil

local function startXRay()
    if xrayConn then xrayConn:Disconnect() end
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        game:GetService("Lighting").GlobalShadows = false
        game:GetService("Lighting").Brightness = 3
    end)
    local function applyToObj(obj)
        if obj:IsA("BasePart") and obj.Anchored then
            if not _origTransp[obj] then _origTransp[obj] = obj.LocalTransparencyModifier end
            obj.LocalTransparencyModifier = 0.85
        end
    end
    for _,obj in ipairs(workspace:GetDescendants()) do applyToObj(obj) end
    xrayConn = workspace.DescendantAdded:Connect(function(obj)
        if Save.xrayOn then task.wait(0.1); applyToObj(obj) end
    end)
end

local function stopXRay()
    if xrayConn then xrayConn:Disconnect(); xrayConn = nil end
    for part, value in pairs(_origTransp) do
        if part then part.LocalTransparencyModifier = value end
    end
    table.clear(_origTransp)
end

